---
// BaseLayout.astro
import { ClientRouter } from "astro:transitions";
import Header from "../components/header.astro";

interface Props {
  title?: string;
  useTurnstile?: boolean;
  headerOverlay?: boolean;
}
const {
  title = "Rinalia",
  useTurnstile = false,
  headerOverlay = false,
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <!--
      フォントはサイト全体でここ 1 か所だけ読み込む。
      ページ側で個別に <link> を足すと ClientRouter が遷移ごとに
      その CSS の読み込み完了を待つため、遷移が遅くなる。
    -->
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/xaq4odq.css" />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Noto+Sans+JP:wght@300;400;500;700;900&family=Zen+Kaku+Gothic+New:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Zen+Kaku+Gothic+New&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <title>{title}</title>
  </head>
  <body>
    <Header overlay={headerOverlay} />
    <slot />
  </body>
</html>

<style is:global>
  /*
    戻るボタン(.back_btn)クリック時の退場アニメーション。
    タイトル帯(.contents_texto)はトップのリストへモーフするので残し、
    それ以外のコンテンツを沈めながらフェードする。
  */
  html.is-leaving-back .contents-list > :not(.contents_texto),
  html.is-leaving-back
    body
    > :not(header):not(.contents-list):not(.bg_reveal):not(script):not(style) {
    /* transition ではなく from を明示した animation にする:
       ページ側の keyframe(例: message の fadeInContent)が opacity を握っていても
       確実に 1 → 0 へフェードさせるため */
    animation: leaveBack 0.35s ease forwards !important;
    pointer-events: none;
  }

  @keyframes leaveBack {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html.is-leaving-back .contents-list > :not(.contents_texto),
    html.is-leaving-back body > * {
      animation: none !important;
      opacity: 0;
    }
  }
</style>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    scroll-behavior: smooth;
  }

  ::view-transition-group(*) {
    animation-duration: 0.6s;
  }
</style>

<script>
  import Lenis from "lenis";

  function initLenis() {
    const lenis = new Lenis({
      duration: 1.5, // 慣性の効き具合(数値を大きくするほどゆっくり滑らかに)
      easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    });

    function raf(time: number) {
      lenis.raf(time);
      requestAnimationFrame(raf);
    }
    requestAnimationFrame(raf);
  }

  initLenis();

  // astro:transitions でページ遷移した後も再初期化されるようにする場合
  document.addEventListener("astro:page-load", initLenis);

  // ===== 戻るボタン: 遷移「前」に退場アニメーションを始め、fetch と並行させる =====
  const BACK_EXIT_MS = 350; // is:global の transition と合わせる
  let leavingBack = false;

  // capture 指定: ClientRouter の click ハンドラ(バブリング)より先に走らせ、
  // astro:before-preparation の前にフラグを立てておく
  document.addEventListener(
    "click",
    (e) => {
      const target = e.target as Element | null;
      const link = target?.closest?.("a.back_btn");
      if (!link) return;
      leavingBack = true;
      // トップ側で入場アニメーションを出すための印。どのページから戻ったかも渡す
      sessionStorage.setItem("backFrom", location.pathname);
      document.documentElement.classList.add("is-leaving-back");
    },
    { capture: true },
  );

  document.addEventListener("astro:before-preparation", (event) => {
    if (!leavingBack) return;
    const originalLoader = event.loader;
    event.loader = async function () {
      await Promise.all([
        new Promise((resolve) => setTimeout(resolve, BACK_EXIT_MS)),
        originalLoader(),
      ]);
    };
  });

  document.addEventListener("astro:after-swap", () => {
    leavingBack = false;
    document.documentElement.classList.remove("is-leaving-back");
  });
</script>
