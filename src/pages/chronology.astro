---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/header.astro";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/footer.astro";
---

<BaseLayout>
  <head>
    <link rel="stylesheet" href="https://use.typekit.net/bwo1tdd.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Noto+Sans+JP:wght@700;900&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://fonts.adobe.com/fonts/acumin-variable?vf-instance=Semibold&vf-font-size=100&vf-font=AcuminVF"
    />
  </head>
  <Header />
  <body>
    <div class="bg_reveal" id="bg_reveal"></div>
    <div class="contents-list" transition:name="title--chronology">
      <div class="contents_texto">
        <span class="content_label">年表</span>
        <h2>CHRONOLOGY</h2>
      </div>
    </div>
    <div class="chronology">
      <div class="timeline-wrap">
        <h4>矢車りね活動記録</h4>
        <p>2018/09/28-2026/09/28</p>
        <div id="timeline" class="timeline"></div>
      </div>
    </div>

    <Footer />

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scrollbar-color: #ffffff #dcc8ff;
      }

      body {
        background-color: #fff;
        position: relative;
      }

      :root {
        --morph-duration: 0.6s;
        --bg-reveal-duration: 0.4s;

        /* ここから年表用のトークン。配色などはあとで調整可 */
        --timeline-line-color: #2f3b52;
        --timeline-circle-bg: #fff;
        --timeline-circle-border: #2f3b52;
        --timeline-year-color: #2f3b52;
        --timeline-text-sub: #6b7280;
        --timeline-max-width: 1240px;
      }

      ::view-transition-old(title--message),
      ::view-transition-new(title--message) {
        animation-duration: var(--morph-duration);
      }

      .bg_reveal {
        position: fixed;
        inset: 0;
        background: rgb(220, 200, 255);
        z-index: -1;
        transform: scaleY(0);
        animation: revealBg var(--bg-reveal-duration) ease forwards;
        /* transform-origin はJSで動的に設定するため、ここでは指定しない */
      }

      @keyframes revealBg {
        from {
          transform: scaleY(0);
        }
        to {
          transform: scaleY(1);
        }
      }

      .contents-list {
        display: block;
        box-shadow:
          0 -1px 0 0 #000,
          0 1px 0 0 #000;
      }

      .contents_texto {
        padding: 14px 16px 14px;
        white-space: nowrap;
        position: relative;
      }

      .content_label {
        position: absolute;
        top: 14px;
        right: 16px;
        font-size: 15px;
        color: #000;
        font-family: "游ゴシック", sans-serif;
        font-weight: 800;
        padding: 6px 14px;
      }

      .contents_texto h2 {
        font-size: 110px;
        font-family: "acumin-variable", sans-serif;
        font-variation-settings:
          "wght" 400,
          "wdth" 100,
          "slnt" 0;
        font-style: normal;
        align-items: center;
        line-height: 1;
        letter-spacing: -0.06em;
      }

      .timeline-wrap h4 {
        display: block;
        font-family: "游ゴシック", sans-serif;
        font-weight: 500;
        align-items: center;
        justify-content: center;
        text-align: center;
        font-size: 30px;
        margin: 0;
      }

      .timeline-wrap p {
        display: flex;
        font-family: "游ゴシック", sans-serif;
        font-weight: 500;
        align-items: center;
        justify-content: center;
        text-align: center;
        font-size: 22px;
        padding-bottom: 20px;
      }

      .chronology {
        margin: 0 auto;
        padding: 100px 0;
      }

      /* ===========================================================
         年表セクション
         この中の要素はJSで動的に生成するため、Astroのスコープ付きCSSが
         効かない（data-astro-cid属性が付かない）。
         そのため :global() で明示的にスコープ外にしている。
         =========================================================== */
      :global(.timeline-wrap) {
        max-width: var(--timeline-max-width);
        margin: 0 auto;
        padding: 64px 50px;
        opacity: 0;
        background-color: #eedcfdcc;
        border: 1px solid #000;
        border-radius: 30px;
        animation: timelineFadeIn 0.5s ease forwards;
        animation-delay: var(
          --bg-reveal-duration
        ); /* bg_revealの再生後に表示 */
      }

      @keyframes timelineFadeIn {
        from {
          opacity: 0;
          transform: translateY(8px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      :global(.timeline) {
        position: relative;
      }

      /* 最初の丸〜最後の丸を貫通する1本の縦線（top/heightはJSで設定） */
      :global(.timeline-line) {
        position: absolute;
        left: 10px;
        width: 2px;
        background: var(--timeline-line-color);
        transform: translateX(-50%);
        z-index: 0;
      }

      :global(.timeline-item) {
        display: flex;
        align-items: flex-start;
        padding-bottom: 48px;
        position: relative;
        z-index: 1;
      }
      :global(.timeline-item:last-child) {
        padding-bottom: 0;
      }

      :global(.marker-col) {
        width: 20px;
        flex: 0 0 20px;
        display: flex;
        justify-content: center;
      }

      :global(.marker-circle) {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: var(--timeline-circle-bg);
        border: 3px solid var(--timeline-circle-border);
        margin-top: 2px;
      }

      :global(.content-col) {
        flex: 1 1 auto;
        padding-left: 24px;
      }

      :global(.item-year) {
        display: inline-block;
        font-size: 14px;
        font-weight: 700;
        color: var(--timeline-year-color);
        letter-spacing: 0.05em;
        margin-bottom: 6px;
      }

      :global(.item-title) {
        margin: 0 0 10px;
        font-size: 22px;
        font-weight: 700;
        padding-bottom: 10px;
        border-bottom: 2px solid var(--timeline-line-color);
      }

      :global(.item-desc) {
        margin: 0;
        font-size: 18px;
        color: var(--timeline-text-sub);
      }

      /* YouTube埋め込み */
      :global(.item-youtube) {
        margin-top: 16px;
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        border-radius: 8px;
        overflow: hidden;
        background: #000;
      }
      :global(.item-youtube iframe) {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: none;
      }

      /* 一言コメント */
      :global(.item-comment) {
        margin-top: 14px;
        padding: 10px 14px;
        border-left: 3px solid var(--timeline-circle-border);
        font-size: 13px;
        font-style: italic;
        color: var(--timeline-text-sub);
        background: transparent;
      }

      /* いいねボタン */
      :global(.item-footer) {
        display: flex;
        align-items: center;
        margin-top: 14px;
      }
      :global(.like-btn) {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border: 1.5px solid #ffffff;
        border-radius: 999px;
        background: transparent;
        font-size: 13px;
        cursor: pointer;
        transition:
          border-color 0.2s,
          color 0.2s;
        color: var(--timeline-text-sub);
        user-select: none;
      }
      :global(.like-btn:hover) {
        border-color: var(--timeline-circle-border);
        color: var(--timeline-circle-border);
      }
      :global(.like-btn.liked) {
        border-color: #e05a5a;
        color: #e05a5a;
      }
      :global(.like-btn .like-icon) {
        font-size: 15px;
        line-height: 1;
        transition: transform 0.15s;
      }
      :global(.like-btn.liked .like-icon) {
        transform: scale(1.25);
      }
    </style>

