        /* --------------------------------------------------
           いいね数の永続化（localStorage）
           -------------------------------------------------- */
        function likeKey(item: { year: string; title: string }) {
          return `likes_${item.year}_${item.title}`;
        }
        function getLikes(item: { year: string; title: string }) {
          const raw = localStorage.getItem(likeKey(item));
          return raw ? JSON.parse(raw) : { count: 0, liked: false };
        }
        function saveLikes(
          item: { year: string; title: string },
          data: { count: number; liked: boolean },
        ) {
          localStorage.setItem(likeKey(item), JSON.stringify(data));
        }

        /* --------------------------------------------------
           YouTubeサムネイルプレースホルダー
           ビューポートに入るまでiframeを生成しない
           -------------------------------------------------- */
        function buildYoutubePlaceholder(videoId: string): HTMLElement {
          const wrap = document.createElement("div");
          wrap.className = "item-youtube";
          wrap.dataset.ytId = videoId;

          const placeholder = document.createElement("div");
          placeholder.className = "yt-placeholder";
          placeholder.innerHTML = `
            <img src="https://i.ytimg.com/vi/${videoId}/hqdefault.jpg" alt="サムネイル" loading="lazy" />
            <div class="yt-play-btn" aria-hidden="true"></div>
          `;
          placeholder.addEventListener("click", () =>
            swapToIframe(wrap, videoId, true),
          );
          wrap.appendChild(placeholder);
          return wrap;
        }

        function swapToIframe(
          wrap: HTMLElement,
          videoId: string,
          autoplay = false,
        ) {
          const iframe = document.createElement("iframe");
          iframe.src = `https://www.youtube.com/embed/${videoId}${autoplay ? "?autoplay=1" : ""}`;
          iframe.allow =
            "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
          iframe.allowFullscreen = true;
          wrap.innerHTML = "";
          wrap.appendChild(iframe);
        }

        /* --------------------------------------------------
           描画：案A（左テキスト・右メディアの2カラム）
           -------------------------------------------------- */
        function renderTimeline(
          data: {
            year: string;
            title: string;
            desc: string;
            comment?: string;
            youtube?: string;
          }[],
        ) {
          const container = document.getElementById("timeline");
          if (!container) return;
          container.innerHTML = "";

          const lineEl = document.createElement("div");
          lineEl.id = "timelineLine";
          lineEl.className = "timeline-line";
          container.appendChild(lineEl);

          data.forEach((item) => {
            const likeData = getLikes(item);
            const hasMedia = !!item.youtube;

            const itemEl = document.createElement("div");
            itemEl.className = "timeline-item";

            /* 左テキスト列 */
            const textCol = document.createElement("div");
            textCol.className = "text-col";
            textCol.innerHTML = `
              <span class="item-year">${item.year}</span>
              <h3 class="item-title">${item.title}</h3>
              ${item.desc ? `<p class="item-desc">${item.desc}</p>` : ""}
              ${item.comment ? `<p class="item-comment">${item.comment}</p>` : ""}
              <div class="item-footer">
                <button class="like-btn${likeData.liked ? " liked" : ""}" aria-label="いいね">
                  <span class="like-icon">${likeData.liked ? "♥" : "♡"}</span>
                  <span class="like-count">${likeData.count}</span>
                </button>
              </div>
            `;

            /* 右メディア列 */
            const mediaCol = document.createElement("div");
            mediaCol.className = "media-col";
            if (item.youtube) {
              mediaCol.appendChild(buildYoutubePlaceholder(item.youtube));
            }

            /* content-col に両方を入れる */
            const contentCol = document.createElement("div");
            contentCol.className = `content-col${hasMedia ? "" : " no-media"}`;
            contentCol.appendChild(textCol);
            if (hasMedia) contentCol.appendChild(mediaCol);

            itemEl.innerHTML = `
              <div class="marker-col">
                <div class="marker-circle"></div>
              </div>
            `;
            itemEl.appendChild(contentCol);

            /* いいねボタンのイベント */
            const btn = textCol.querySelector(".like-btn") as HTMLButtonElement;
            btn.addEventListener("click", () => {
              const current = getLikes(item);
              const next = current.liked
                ? { count: current.count - 1, liked: false }
                : { count: current.count + 1, liked: true };
              saveLikes(item, next);
              btn.classList.toggle("liked", next.liked);
              btn.querySelector(".like-icon")!.textContent = next.liked
                ? "♥"
                : "♡";
              btn.querySelector(".like-count")!.textContent = String(
                next.count,
              );
            });

            container.appendChild(itemEl);
          });

          updateTimelineLine();
        }

        /* --------------------------------------------------
           縦線の高さ計算
           -------------------------------------------------- */
        function updateTimelineLine() {
          const container = document.getElementById("timeline");
          const line = document.getElementById("timelineLine");
          if (!container || !line) return;
          const circles = container.querySelectorAll(".marker-circle");
          if (circles.length === 0) return;
          const containerTop = container.getBoundingClientRect().top;
          const firstRect = circles[0].getBoundingClientRect();
          const lastRect = circles[circles.length - 1].getBoundingClientRect();
          const top = firstRect.top + firstRect.height / 2 - containerTop;
          const bottom = lastRect.top + lastRect.height / 2 - containerTop;
          (line as HTMLElement).style.top = `${top}px`;
          (line as HTMLElement).style.height = `${bottom - top}px`;
        }

        /* --------------------------------------------------
           IntersectionObserver
           -------------------------------------------------- */
        function observeItems() {
          const itemObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  (entry.target as HTMLElement).classList.add("is-visible");
                  itemObserver.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.08 },
          );

          requestAnimationFrame(() => {
            document.querySelectorAll(".timeline-item").forEach((el, i) => {
              (el as HTMLElement).style.transitionDelay = `${i * 60}ms`;
              itemObserver.observe(el);
            });
          });

          const ytObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  const img = (entry.target as HTMLElement).querySelector(
                    "img",
                  );
                  if (img) img.loading = "eager";
                  ytObserver.unobserve(entry.target);
                }
              });
            },
            { rootMargin: "200px" },
          );
          document
            .querySelectorAll(".item-youtube")
            .forEach((el) => ytObserver.observe(el));
        }

        const BG_REVEAL_MS = 400;
        renderTimeline(timelineData);
        window.addEventListener("resize", updateTimelineLine);
        setTimeout(observeItems, BG_REVEAL_MS);

        document.addEventListener("astro:page-load", () => {
          renderTimeline(timelineData);
          setTimeout(observeItems, BG_REVEAL_MS);
        });

        /* --------------------------------------------------
   タイトル・ラベルの無限ループ・マーキー表示
   はみ出している要素だけ、テキストを複製して隙間なく
   並べ、CSSアニメーションで左に流し続ける。
   1周分スライドし終わったら（＝複製2つ目の先頭が
   元の位置に来たら）継ぎ目なく最初から繰り返される。
   -------------------------------------------------- */
        const MARQUEE_SPEED = 60; // 数値を大きくするほど速く流れる（px/秒）
        const MARQUEE_GAP = 48; // テキストの最後と、次の頭との間隔(px)
        const MARQUEE_START_DELAY = 1000; // 表示されてから動き出すまでの待ち時間(ms)

        function initAutoScrollTitles() {
          const targets = document.querySelectorAll<HTMLElement>(
            ".contents_texto h2, .content_label",
          );

          targets.forEach((el) => {
            if (el.dataset.marqueeBound === "true") return;

            const overflowAmount = el.scrollWidth - el.clientWidth;
            if (overflowAmount <= 1) return; // はみ出していなければ何もしない

            el.dataset.marqueeBound = "true";

            const text = el.textContent ?? "";
            el.textContent = "";

            const track = document.createElement("span");
            track.className = "marquee-track";

            const item1 = document.createElement("span");
            item1.className = "marquee-item";
            item1.textContent = text;

            const item2 = document.createElement("span");
            item2.className = "marquee-item";
            item2.textContent = text;
            item2.setAttribute("aria-hidden", "true");
            item2.style.paddingLeft = `${MARQUEE_GAP}px`;

            track.appendChild(item1);
            track.appendChild(item2);
            el.appendChild(track);

            setTimeout(() => {
              // 実測した1コピー分の幅＋隙間 だけ流せば、複製2つ目が
              // ちょうど元の位置に来て継ぎ目なくループする
              const distance =
                item1.getBoundingClientRect().width + MARQUEE_GAP;
              const duration = distance / MARQUEE_SPEED;
              track.style.setProperty("--marquee-distance", `-${distance}px`);
              track.style.animationDuration = `${duration}s`;
              track.classList.add("is-scrolling");
            }, MARQUEE_START_DELAY);
          });
        }

        initAutoScrollTitles();
        document.addEventListener("astro:page-load", initAutoScrollTitles);

        /* Adobe Fonts等、フォントの非同期読み込みで文字幅が変わったあとに
   もう一度オーバーフロー判定をやり直す(フォールバックフォント表示中に
   「はみ出していない」と誤判定されるのを防ぐ) */
        if (
          document.fonts &&
          typeof document.fonts.ready?.then === "function"
        ) {
          document.fonts.ready.then(() => {
            requestAnimationFrame(initAutoScrollTitles);
          });
        }
        // 上記が使えない/間に合わない場合の保険として少し遅れて再チェック
        setTimeout(initAutoScrollTitles, 1500);

        document
          .querySelectorAll(".contents_texto h2, .content_label")
          .forEach((el) => {
            console.log(
              el.className,
              "scrollWidth:",
              el.scrollWidth,
              "clientWidth:",
              el.clientWidth,
            );
          });
      </script>
    </div>
  </body>
</BaseLayout>
