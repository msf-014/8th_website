---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/header.astro";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/footer.astro";
---

<BaseLayout>
  <head>
    <link rel="stylesheet" href="https://use.typekit.net/bwo1tdd.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Noto+Sans+JP:wght@700;900&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://fonts.adobe.com/fonts/acumin-variable?vf-instance=Semibold&vf-font-size=100&vf-font=AcuminVF"
    />
  </head>
  <Header />
  <body>
    <div class="bg_reveal" id="bg_reveal"></div>
    <div class="contents-list" transition:name="title--chronology">
      <div class="contents_texto">
        <span class="content_label">年表</span>
        <h2>CHRONOLOGY</h2>
      </div>
    </div>
    <div class="chronology">
      <div class="timeline-wrap">
        <h4>矢車りね活動記録</h4>
        <p>2018/09/28-2026/09/28</p>
        <div id="timeline" class="timeline"></div>
      </div>
    </div>

    <Footer />

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scrollbar-color: #ffffff #dcc8ff;
      }

      body {
        background-color: #fff;
        position: relative;
      }

      :root {
        --morph-duration: 0.6s;
        --bg-reveal-duration: 0.4s;

        /* ここから年表用のトークン。配色などはあとで調整可 */
        --timeline-line-color: #2f3b52;
        --timeline-circle-bg: #fff;
        --timeline-circle-border: #2f3b52;
        --timeline-year-color: #2f3b52;
        --timeline-text-sub: #6b7280;
        --timeline-max-width: 1240px;
      }

      ::view-transition-old(title--message),
      ::view-transition-new(title--message) {
        animation-duration: var(--morph-duration);
      }

      .bg_reveal {
        position: fixed;
        inset: 0;
        background: rgb(220, 200, 255);
        z-index: -1;
        transform: scaleY(0);
        animation: revealBg var(--bg-reveal-duration) ease forwards;
        /* transform-origin はJSで動的に設定するため、ここでは指定しない */
      }

      @keyframes revealBg {
        from {
          transform: scaleY(0);
        }
        to {
          transform: scaleY(1);
        }
      }

      .contents-list {
        display: block;
        box-shadow:
          0 -1px 0 0 #000,
          0 1px 0 0 #000;
      }

      .contents_texto {
        padding: 14px 16px 14px;
        white-space: nowrap;
        position: relative;
      }

      .content_label {
        position: absolute;
        top: 14px;
        right: 16px;
        font-size: 15px;
        color: #000;
        font-family: "游ゴシック", sans-serif;
        font-weight: 800;
        padding: 6px 14px;
      }

      .contents_texto h2 {
        font-size: 110px;
        font-family: "acumin-variable", sans-serif;
        font-variation-settings:
          "wght" 400,
          "wdth" 100,
          "slnt" 0;
        font-style: normal;
        align-items: center;
        line-height: 1;
        letter-spacing: -0.06em;
      }

      .timeline-wrap h4 {
        display: block;
        font-family: "游ゴシック", sans-serif;
        font-weight: 500;
        align-items: center;
        justify-content: center;
        text-align: center;
        font-size: 30px;
        margin: 0;
      }

      .timeline-wrap p {
        display: flex;
        font-family: "游ゴシック", sans-serif;
        font-weight: 500;
        align-items: center;
        justify-content: center;
        text-align: center;
        font-size: 22px;
        padding-bottom: 20px;
      }

      .chronology {
        margin: 0 auto;
        padding: 100px 0;
      }

      /* ===========================================================
         年表セクション
         この中の要素はJSで動的に生成するため、Astroのスコープ付きCSSが
         効かない（data-astro-cid属性が付かない）。
         そのため :global() で明示的にスコープ外にしている。
         =========================================================== */
      :global(.timeline-wrap) {
        max-width: var(--timeline-max-width);
        margin: 0 auto;
        padding: 64px 50px;
        opacity: 0;
        background-color: #eedcfdcc;
        border: 1px solid #000;
        border-radius: 30px;
        animation: timelineFadeIn 0.5s ease forwards;
        animation-delay: var(
          --bg-reveal-duration
        ); /* bg_revealの再生後に表示 */
      }

      @keyframes timelineFadeIn {
        from {
          opacity: 0;
          transform: translateY(8px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      :global(.timeline) {
        position: relative;
      }

      /* 最初の丸〜最後の丸を貫通する1本の縦線（top/heightはJSで設定） */
      :global(.timeline-line) {
        position: absolute;
        left: 10px;
        width: 2px;
        background: var(--timeline-line-color);
        transform: translateX(-50%);
        z-index: 0;
      }

      :global(.timeline-item) {
        display: flex;
        align-items: flex-start;
        padding-bottom: 48px;
        position: relative;
        z-index: 1;
      }
      :global(.timeline-item:last-child) {
        padding-bottom: 0;
      }

      :global(.marker-col) {
        width: 20px;
        flex: 0 0 20px;
        display: flex;
        justify-content: center;
      }

      :global(.marker-circle) {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: var(--timeline-circle-bg);
        border: 3px solid var(--timeline-circle-border);
        margin-top: 2px;
      }

      :global(.content-col) {
        flex: 1 1 auto;
        padding-left: 24px;
      }

      :global(.item-year) {
        display: inline-block;
        font-size: 14px;
        font-weight: 700;
        color: var(--timeline-year-color);
        letter-spacing: 0.05em;
        margin-bottom: 6px;
      }

      :global(.item-title) {
        margin: 0 0 10px;
        font-size: 22px;
        font-weight: 700;
        padding-bottom: 10px;
        border-bottom: 2px solid var(--timeline-line-color);
      }

      :global(.item-desc) {
        margin: 0;
        font-size: 18px;
        color: var(--timeline-text-sub);
      }

      /* YouTube埋め込み */
      :global(.item-youtube) {
        margin-top: 16px;
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        border-radius: 8px;
        overflow: hidden;
        background: #000;
      }
      :global(.item-youtube iframe) {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: none;
      }

      /* 一言コメント */
      :global(.item-comment) {
        margin-top: 14px;
        padding: 10px 14px;
        border-left: 3px solid var(--timeline-circle-border);
        font-size: 13px;
        font-style: italic;
        color: var(--timeline-text-sub);
        background: transparent;
      }

      /* いいねボタン */
      :global(.item-footer) {
        display: flex;
        align-items: center;
        margin-top: 14px;
      }
      :global(.like-btn) {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border: 1.5px solid #ffffff;
        border-radius: 999px;
        background: transparent;
        font-size: 13px;
        cursor: pointer;
        transition:
          border-color 0.2s,
          color 0.2s;
        color: var(--timeline-text-sub);
        user-select: none;
      }
      :global(.like-btn:hover) {
        border-color: var(--timeline-circle-border);
        color: var(--timeline-circle-border);
      }
      :global(.like-btn.liked) {
        border-color: #e05a5a;
        color: #e05a5a;
      }
      :global(.like-btn .like-icon) {
        font-size: 15px;
        line-height: 1;
        transition: transform 0.15s;
      }
      :global(.like-btn.liked .like-icon) {
        transform: scale(1.25);
      }
    </style>

    <script>
      /* ===========================================================
         表示する項目データ
         各フィールドの説明:
           year    : 年（数値）
           title   : 見出し
           desc    : 概要（本文）
           comment : 一言コメント。省略するとコメント欄は表示されない
           youtube : YouTube の動画ID（URLのv=以降の部分）。
                     省略するとYouTubeエリアは表示されない
         =========================================================== */
      const timelineData = [
        {
          year: "2018/09/28",
          title: "初配信",
          desc: "Mirrativにて初配信を行う。",
          comment: "",
          youtube: "",
        },
        {
          year: "2019/06/20",
          title: "ライバー用スマホ紛失",
          desc: "ライバー用スマホを失くした雑談配信を行う。「Liver Yo Smartphone」はこの時に生まれた。",
          comment: "comments",
          youtube: "B9SL-dlO9Zo",
        },
        {
          year: "2020/03/31",
          title: "チャンネル登録者数 5万人突破",
          desc: "",
          comment: "",
          youtube: "",
        },
        {
          year: "2022/10/08",
          title: "にじフェス2022不参加",
          desc: "にじフェス2022に不参加だったので、エア感想会を行う。",
          comment: "",
          youtube: "SsUpd6moAII",
        },
        {
          year: "2023/12/06",
          title: "矢車のにじぱぺに自我が芽生える。",
          desc: "矢車のにじぱぺが2023年11月24日より発売開始。所詮ぱぺに自我など芽生えるはずがないと高を括っていた矢車を排し、ぱぺが配信を乗っ取る。なお、この後毎年エイプリルフールの配信枠にはぱぺが現れ、矢車本体に黙って蛮行を働いている。",
          comment: "comments",
          youtube: "hMKc-zWEutI",
        },
        {
          year: "2023/12/16",
          title:
            "【RUST】島のドン（になる予定）のやぐるまちた、初上陸 #にじらす【にじさんじ/矢車りね/町田ちま】",
          desc: "にじ鯖RUSTに参加、やぐるまちたで大暴れ。「俺らのドリンク汚すなよ」",
          comment: "comments",
          youtube: "5TsfcoMpS-0",
        },
        {
          year: "2023/12/23",
          title: "にじフェス2023 不参加",
          desc: "にじフェス2023にまたしても現地不参加となった矢車。東京ビッグサイト上空から雑談を行い、むせび泣く。",
          comment: "comments",
          youtube: "Q7u-tdu-4D0",
        },
        {
          year: "2023/12/31",
          title: "登録者数10万人達成",
          desc: "10万人達成するまでの年を越せない耐久配信を行った。極寒の中、冷え切った登録者メーターをチュッチュベロベロしながら無事に10万人を迎え、誰よりも早く年を越した。",
          comment: "comments",
          youtube: "8T0ckiYjBCs",
        },
        {
          year: "2024/04/01",
          title: "りねぱぺ、トラックに乗りヨーロッパを爆走",
          desc: "エイプリルフールにりねぱぺがチャンネルを乗っ取り、「Euro Truck Simulator 2」の配信を行った。",
          comment: "comments",
          youtube: "11VM8CRzQ1Q",
        },
        {
          year: "2024/06/20",
          title:
            "【#にじGTA】はじめてのGTAだしとりあえず平和にお散歩するか＾＾【にじさんじ/矢車りね/黒井しば】",
          desc: "にじGTAに参加。黒井しばと共に平和にお散歩を楽しんでいたはずが、衝動的に葛葉を銃撃。後に「矢車事変」「令和のサラエボ事件」と呼ばれるほど本企画のみならず矢車の今後の活動にも大きく影響を及ぼす出来事となった。",
          comment: "comments",
          youtube: "qYoTp91LxYw",
        },
        {
          year: "2024/03/10",
          title: "やぐるまちた 謝罪会見",
          desc: "「Untitled Goose Game 〜いたずらガチョウがやって来た!〜」を二人で配信の予定だったが、オンラインで二人プレイができないゲームだったため、やぐるまちたによる謝罪会見が開かれた。",
          comment: "謝罪会見という茶番で約45分間配信をやり切った二人に脱帽。",
          youtube: "mD8roGiO7I8",
        },
        {
          year: "2024/05/10",
          title: "やぐるまちた オフカラオケ",
          desc: "やぐるまちたwith黒井しばによるオフコラボカラオケで、矢車りねがラップを披露。6年目にして卓越したラップスキルが公となり、多くの視聴者に衝撃を与えた。",
          comment: "comments",
          youtube: "-ONerRSopTE",
        },
        {
          year: "2024/09/03",
          title: "手動疑似3.0お披露目",
          desc: "3.0が反抗期を迎え、お披露目予定日に動かすことができなくなったため、お手製の3.0を披露。無事に化け物が誕生し、「山に帰れ」「こっちに来るな」などコメントでは散々な言われようだった。「心は泣いてるのに顔は泣けない…」",
          comment: "comments",
