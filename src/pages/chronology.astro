---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/header.astro";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/footer.astro";
import PageBackground from "../components/PageBackground.astro";
import PageHeader from "../components/PageHeader.astro";
import PageFrame from "../components/PageFrame.astro";
import ScrollIndicator from "../components/ScrollIndicator.astro";
---

<BaseLayout>
  <body>
    <PageBackground />
    <ScrollIndicator />
    <div class="contents-list">
      <PageHeader
        title="CHRONOLOGY"
        label="年表"
        transitionName="title--chronology"
      />
      <PageFrame class="chronology">
        <div class="chronology_title">
          <p class="chronology_subtitle">RINE YAGURUMA</p>
          <h4>HISTORY</h4>
          <p class="chronology_date">2018/09/28-2026/09/28</p>
        </div>
        <div class="timeline-wrap">
          <div id="timeline" class="timeline"></div>
        </div>
      </PageFrame>

      <Footer />

      <style>
        * {
          margin: 0;
          padding: 0;
          box-sizing: border-box;
        }

        html {
          scrollbar-color: #ffffff #dcc8ff;
          scroll-behavior: smooth;
        }

        body {
          background-color: #fff;
          position: relative;
        }

        :root {
          --morph-duration: 0.6s;
          --bg-reveal-duration: 0.4s;

          --timeline-line-color: #2f3b52;
          --timeline-circle-bg: #fff;
          --timeline-circle-border: #2f3b52;
          --timeline-year-color: #2f3b52;
          --timeline-text-sub: #000;
          --timeline-text-comments: #9f83cf;
          --timeline-max-width: 1900px;
          --page-color: #dcc8ff;
          --header-back-color: var(--page-color);

          /* 左テキスト列の幅。残りが右メディア列になる */
          --text-col-width: 38%;
        }

        ::view-transition-old(title--message),
        ::view-transition-new(title--message) {
          animation-duration: var(--morph-duration);
        }

        .contents-list {
          display: block;
        }

        .chronology_title {
          width: 30%;
          margin: auto;
          position: relative;
          padding: 0.5em 1.5em;
          border-bottom: 1px solid #000;
          margin-left: -1px; /* .chronologyのborder-left分だけはみ出す */
          margin-right: -1px; /* .chronologyのborder-right分だけはみ出す */
          width: calc(100% + 2px); /* はみ出した分だけ横幅を広げる */
        }
        .chronology_subtitle {
          display: block;
          font-family: "effra", sans-serif;
          font-weight: 800;
          text-align: center;
          font-size: 50px;
          line-height: 1;
          padding: 1.3em 0 0 0;
          letter-spacing: 0.02em;
        }
        .chronology_title h4 {
          display: block;
          font-family: "effra", sans-serif;
          font-weight: 800;
          text-align: center;
          font-size: 100px;
          line-height: 1;
          margin: 0; /* padding: 4px 0 20px 0 → margin-bottom: 8px */
        }
        .chronology_date {
          display: flex;
          font-family: "effra", sans-serif;
          font-weight: 500;
          align-items: center;
          justify-content: center;
          text-align: center;
          font-size: 30px;
          line-height: 1;
          padding-bottom: 1.6em;
          letter-spacing: 0.13em;
        }

        /* ===========================================================
           年表セクション（:global — JSで動的生成するため）
           =========================================================== */

        :global(.timeline-wrap) {
          max-width: var(--timeline-max-width);
          margin: 0 auto;
          margin-bottom: 100px;
          padding: 64px 50px;
          opacity: 0;
          animation: timelineFadeIn 0.5s ease forwards;
          animation-delay: var(--bg-reveal-duration);
        }

        @keyframes timelineFadeIn {
          from {
            opacity: 0;
            transform: translateY(8px);
          }
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }

        :global(.timeline) {
          position: relative;
        }

        /* 縦の通し線 */
        :global(.timeline-line) {
          position: absolute;
          left: 10px;
          width: 2px;
          background: var(--timeline-line-color);
          transform: translateX(-50%);
          z-index: 0;
        }

        /* 1項目のラッパー */
        :global(.timeline-item) {
          display: flex;
          align-items: flex-start;
          padding-bottom: 56px;
          position: relative;
          z-index: 1;
          /* スクロールフェードイン */
          opacity: 0;
          transform: translateY(16px);
          transition:
            opacity 0.5s ease,
            transform 0.5s ease;
        }
        :global(.timeline-item.is-visible) {
          opacity: 1;
          transform: translateY(0);
        }
        :global(.timeline-item:last-child) {
          padding-bottom: 0;
        }

        /* 丸マーカー列 */
        :global(.marker-col) {
          width: 20px;
          flex: 0 0 20px;
          display: flex;
          justify-content: center;
          padding-top: 4px;
        }
        :global(.marker-circle) {
          width: 16px;
          height: 16px;
          border-radius: 50%;
          background: var(--timeline-circle-bg);
          border: 3px solid var(--timeline-circle-border);
        }

        /* マーカーの右側 全体ラッパー → 2カラムに */
        :global(.content-col) {
          flex: 1 1 auto;
          padding-left: 32px;
          display: flex;
          align-items: flex-start;
          gap: 40px;
        }

        /* 左：テキスト列 */
        :global(.text-col) {
          flex: 0 0 var(--text-col-width);
          min-width: 0;
          display: flex;
          flex-direction: column;
          gap: 10px;
        }

        /* 右：メディア列（YouTube） */
        :global(.media-col) {
          flex: 1 1 auto;
          min-width: 0;
          display: flex;
          flex-direction: column;
          gap: 16px;
        }

        /* メディアがない項目はテキスト列を全幅に */
        :global(.content-col.no-media .text-col) {
          flex: 1 1 auto;
        }

        /* 年 */
        :global(.item-year) {
          display: inline-block;
          font-size: 13px;
          font-weight: 700;
          color: var(--timeline-year-color);
          letter-spacing: 0.05em;
          font-family: "effra", sans-serif;
          line-height: 1;
        }

        /* タイトル */
        :global(.item-title) {
          margin: 0;
          font-size: 20px;
          font-weight: 700;
          padding-bottom: 10px;
          border-bottom: 2px solid var(--timeline-line-color);
          font-family: "Zen Kaku Gothic New", sans-serif;
        }

        /* 概要 */
        :global(.item-desc) {
          margin: 0;
          font-size: 14px;
          font-weight: 500;
          line-height: 2;
          color: var(--timeline-text-sub);
          font-family: "Zen Kaku Gothic New", sans-serif;
          white-space: pre-wrap;
        }

        /* 一言コメント */
        :global(.item-comment) {
          position: relative;
          padding: 10px 14px;
          font-size: 13px;
          font-style: italic;
          color: var(--timeline-text-comments);
          background: #fbf9ff;
          border-radius: 999px;
          align-self: flex-start;
          font-family: "Zen Kaku Gothic New", sans-serif;
          font-weight: 500;
        }
        :global(.item-comment)::before {
          content: "";
          position: absolute;
          left: 30px;
          top: -15px;
          width: 0;
          height: 0;
          border-right: 15px solid transparent;
          border-bottom: 15px solid #fbf9ff;
          border-left: 15px solid transparent;
        }

        /* いいね */
        :global(.item-footer) {
          display: flex;
          align-items: center;
          margin-top: 4px;
        }
        :global(.like-btn) {
          display: inline-flex;
          align-items: center;
          gap: 6px;
          padding: 6px 14px;
          border: 1.5px solid #fff;
          border-radius: 999px;
          background: transparent;
          font-size: 13px;
          cursor: pointer;
          transition:
            border-color 0.2s,
            color 0.2s;
          color: var(--timeline-text-sub);
          user-select: none;
        }
        :global(.like-btn:hover) {
          border-color: var(--timeline-circle-border);
          color: var(--timeline-circle-border);
        }
        :global(.like-btn.liked) {
          border-color: #e05a5a;
          color: #e05a5a;
        }
        :global(.like-btn .like-icon) {
          font-size: 15px;
          line-height: 1;
          transition: transform 0.15s;
        }
        :global(.like-btn.liked .like-icon) {
          transform: scale(1.25);
        }

        /* YouTube */
        :global(.item-youtube) {
          position: relative;
          width: 100%;
          aspect-ratio: 16 / 9;
          border-radius: 8px;
          overflow: hidden;
          background: #000;
        }
        :global(.item-youtube iframe) {
          position: absolute;
          inset: 0;
          width: 100%;
          height: 100%;
          border: none;
        }

        :global(.item-image) {
          width: 100%;
          border-radius: 8px;
          overflow: hidden;
        }
        :global(.item-image img) {
          width: 100%;
          height: auto;
          display: block;
          object-fit: cover;
        }

        /* YouTubeサムネイルプレースホルダー */
        :global(.yt-placeholder) {
          position: absolute;
          inset: 0;
          cursor: pointer;
          display: flex;
          align-items: center;
          justify-content: center;
        }
        :global(.yt-placeholder img) {
          position: absolute;
          inset: 0;
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
        :global(.yt-play-btn) {
          position: relative;
          z-index: 1;
          width: 64px;
          height: 44px;
          background: #ff0000;
          border-radius: 12px;
          display: flex;
          align-items: center;
          justify-content: center;
          opacity: 0.92;
          transition:
            opacity 0.2s,
            transform 0.2s;
        }
        :global(.yt-placeholder:hover .yt-play-btn) {
          opacity: 1;
          transform: scale(1.08);
        }
        :global(.yt-play-btn::after) {
          content: "";
          border-style: solid;
          border-width: 9px 0 9px 18px;
          border-color: transparent transparent transparent #fff;
          margin-left: 4px;
        }

        /* Xポスト埋め込み（YouTubeと同じ比率） */
        :global(.item-tweet) {
          position: relative;
          width: 100%;
          height: 500px;
          border-radius: 10px;
          overflow: hidden;
          display: flex;
          justify-content: center;
        }
        :global(.item-tweet iframe) {
          margin: 0 auto;
          position: absolute;
          inset: 0;
          width: 560px;
          height: 100%;
          border: none;
          display: block;
          pointer-events: none;
        }

        :global(.item-tweet:hover iframe) {
          pointer-events: auto; /* ホバー時だけiframe内を操作可能 */
        }

        /* レスポンシブ：幅が狭い場合は縦積みに戻す */
        @media (max-width: 900px) {
          :global(.content-col) {
            flex-direction: column;
            align-items: stretch;
          }
          :global(.text-col) {
            flex: 1 1 auto;
          }
        }

        /* ==================== スマホ対応 ==================== */
        @media (max-width: 768px) {
          /* ---- ここから無限ループ・マーキー用のスタイル ---- */

          /* ---- ここまで ---- */

          .chronology_title {
            padding: 16px 1em;
          }
          .chronology_subtitle {
            font-size: 20px;
            letter-spacing: 0.2em;
            margin: 0 0 2px 0;
          }
          .chronology_title h4 {
            font-size: 13vw;
          }
          .chronology_date {
            font-size: 15px;
          }

          :global(.timeline-wrap) {
            padding: 32px 16px;
            margin-bottom: 60px;
          }

          :global(.timeline-line) {
            left: 8px;
          }

          :global(.marker-col) {
            width: 16px;
            flex: 0 0 16px;
          }

          :global(.marker-circle) {
            width: 14px;
            height: 14px;
            border-width: 2px;
          }

          :global(.content-col) {
            padding-left: 16px;
            gap: 20px;
          }

          :global(.item-year) {
            font-size: 12px;
          }

          :global(.item-title) {
            font-size: 17px;
            padding-bottom: 8px;
          }

          :global(.item-desc) {
            font-size: 13px;
            line-height: 1.8;
          }

          :global(.item-comment) {
            font-size: 12px;
            padding: 8px 12px;
          }

          :global(.like-btn) {
            font-size: 12px;
            padding: 5px 12px;
          }

          :global(.item-youtube) {
            border-radius: 6px;
          }

          :global(.yt-play-btn) {
            width: 52px;
            height: 36px;
          }

          :global(.item-tweet) {
            position: relative;
            width: 100%;
            height: 500px;
            border-radius: 10px;
            overflow: hidden;
            display: flex;
            justify-content: center;
          }

          :global(.item-tweet iframe) {
            margin: 0 auto;
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            border: none;
            display: block;
            pointer-events: none;
          }
        }
      </style>

