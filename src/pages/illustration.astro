---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/header.astro";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/footer.astro";
import PageBackground from "../components/PageBackground.astro";
import PageHeader from "../components/PageHeader.astro";
import PageFrame from "../components/PageFrame.astro";

const image = [
  {
    src: "/IMG_0287.jpg",
    title: "あんこあら",
  },
  {
    src: "/HS68OIza4AAX5c9.jpg",
    title: "奏音",
  },
  {
    src: "/54_20260925041658.jpg",
    title: "にて",
  },
];

const allImages = [...image];
---

<BaseLayout>
  <body>
    <PageBackground />
    <div class="contents-list">
      <PageHeader
        title="ILLUSTRATION"
        label="お祝いイラスト"
        transitionName="title--illustration"
      />
    </div>
    <div class="illust_bord">
      <PageFrame class="illust_contents">
        <div class="illust_list">
          {
            image.map((item) => (
              <figure
                class="gallery_item"
                data-index={allImages.findIndex((i) => i.src === item.src)}
              >
                <img src={item.src} alt={item.title} loading="lazy" />
                <figcaption class="gallery_caption">{item.title}</figcaption>
              </figure>
            ))
          }
        </div>
      </PageFrame>
    </div>

    <Footer />

    <style>
      * {
        margin: 0;
        padding: 0;
      }

      body {
        background-color: #fff;
        position: relative;
        -webkit-touch-callout: none; /* リンク長押しのポップアップメニューを禁止 */
        -webkit-user-select: none; /* 文字選択を禁止（Safari/Chrome用） */
        user-select: none; /* 文字選択を禁止（標準） */
      }

      img {
        pointer-events: none;
      }

      :root {
        --morph-duration: 0.6s;

        --page-color: #c8dcff;

        --header-back-color: var(--page-color);
      }

      ::view-transition-old(title--message),
      ::view-transition-new(title--message) {
        animation-duration: var(--morph-duration);
      }

      .contents-list {
        display: block;
      }

      .illust_bord {
        width: 100%;
        margin: 0 auto;
      }

      .illust_contents {
        display: flex;
        gap: 25px;
        min-height: 1022px; /* height → min-height、overflow: hidden も削除 */
        padding: 16px;
      }

      .illust_list {
        display: flex;
        flex-wrap: wrap;
        gap: 32px;
        margin: 0 auto;
        padding: 16px;
      }

      .gallery_item {
        margin: 0;
        cursor: pointer;
      }

      .illust_list img {
        display: block;
        width: 50vh;
        padding: 10px;
        box-sizing: content-box;
      }

      .gallery_caption {
        padding: 4px 10px 0;
        font-family: "Zen Kaku Gothic New", sans-serif;
        font-weight: 700;
        font-size: 16px;
        color: #000;
      }

      /* ==================== スマホ対応 ==================== */
      /* スマホ以外は画面幅に合わせた2列グリッド（画像幅を vh で決めると縦横比で崩れるため） */
      @media (min-width: 769px) {
        .illust_contents {
          display: block;
        }
        .illust_list {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 32px;
          padding: 16px;
        }
        .illust_list img {
          width: 100%;
          height: auto;
          box-sizing: border-box;
        }
      }

      @media (max-width: 768px) {
        /* ---- ここから無限ループ・マーキー用のスタイル ---- */
        :global(.marquee-track) {
          display: inline-flex;
          white-space: nowrap;
        }

        :global(.marquee-track.is-scrolling) {
          animation-name: marquee-loop;
          animation-timing-function: linear;
          animation-iteration-count: infinite;
        }

        @keyframes marquee-loop {
          from {
            transform: translateX(0);
          }
          to {
            transform: translateX(var(--marquee-distance, 0px));
          }
        }

        :global(.marquee-item) {
          display: inline-block;
          white-space: nowrap;
        }
        /* ---- ここまで ---- */

        .illust_bord {
          border-left: none;
          border-right: none;
        }

        .illust_contents {
          height: 90vh;
          padding: 12px;
          gap: 0;
        }

        .illust_list {
          display: flex;
          flex-direction: column;
          flex-wrap: nowrap;
          gap: 24px;
          width: 100%;
          margin-top: 50px;
          padding: 0;
          height: 90vh;
        }

        .illust_list img {
          width: 40vh;
          padding: 0;
          margin: 0 auto;
        }

        .gallery_caption {
          font-size: 8px;
          margin: 0 auto;
          text-align: center;
        }
      }
    </style>

    <script></script>
  </body>
</BaseLayout>
