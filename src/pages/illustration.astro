---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/header.astro";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/footer.astro";

const image = [
  {
    src: "IMG_0287.jpg",
    title: "あんこあら",
  },
  {
    src: "HS68OIza4AAX5c9.jpg",
    title: "奏音",
  },
];

const allImages = [...image];
---

<BaseLayout>
  <body>
    <div class="bg_reveal" id="bg_reveal"></div>
    <div class="contents-list" transition:name="title--illustration">
      <div class="contents_texto">
        <span class="content_label">お祝いイラスト</span>
        <h2>ILLUSTRATION</h2>
        <a href="/" class="back_btn" aria-label="戻る">
          <span class="back_arrow">←</span>
        </a>
      </div>
    </div>
    <div class="illust_bord">
      <div class="illust_contents">
        <div class="illust_list">
          {
            image.map((item) => (
              <figure
                class="gallery_item"
                data-index={allImages.findIndex((i) => i.src === item.src)}
              >
                <img src={item.src} alt={item.title} loading="lazy" />
                <figcaption class="gallery_caption">{item.title}</figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </div>

    <Footer />

    <style>
      * {
        margin: 0;
        padding: 0;
      }

      body {
        background-color: #fff;
        position: relative;
        -webkit-touch-callout: none; /* リンク長押しのポップアップメニューを禁止 */
        -webkit-user-select: none; /* 文字選択を禁止（Safari/Chrome用） */
        user-select: none; /* 文字選択を禁止（標準） */
      }

      img {
        pointer-events: none;
      }

      :root {
        --morph-duration: 0.6s;

        --header-back-color: rgb(200, 220, 255);
      }

      ::view-transition-old(title--message),
      ::view-transition-new(title--message) {
        animation-duration: var(--morph-duration);
      }

      .bg_reveal {
        position: fixed;
        inset: 0;
        background: rgb(200, 220, 255);
        background-image: radial-gradient(
          circle,
          rgba(120, 80, 200, 0.35) 1px,
          transparent 1px
        );
        background-size: 5px 5px;
        z-index: -1;
        transform: scaleY(0);
        animation: revealBg 0.4s ease forwards;
        /* transform-origin はJSで動的に設定するため、ここでは指定しない */
      }

      @keyframes revealBg {
        from {
          transform: scaleY(0);
        }
        to {
          transform: scaleY(1);
        }
      }

      .contents-list {
        display: block;
        box-shadow:
          0 -1px 0 0 #000,
          0 1px 0 0 #000;
      }

      .contents_texto {
        box-shadow:
          0 -1px 0 0 #000,
          0 1px 0 0 #000;
        padding: 14px 16px 14px;
        white-space: nowrap;
        position: relative;
        display: flex; /* 追加 */
        align-items: center; /* h2とボタンを縦中央揃え */
        gap: 24px; /* h2とボタンの間隔 */
        background-color: #c8dcff;
      }

      .content_label {
        position: absolute;
        top: 14px;
        right: 16px;
        font-size: 15px;
        color: #c8dcff;
        font-family: "Zen Kaku Gothic New", sans-serif;
        font-weight: 800;
        padding: 6px 14px;
        -webkit-text-stroke-width: 2px;
        -webkit-text-fill-color: #000;
        paint-order: stroke fill;
        z-index: 1;
      }

      .contents_texto h2 {
        font-size: 110px;
        font-family: "acumin-variable", sans-serif;
        font-variation-settings:
          "wght" 400,
          "wdth" 100,
          "slnt" 0;
        font-style: normal;
        align-items: center;
        line-height: 1;
        letter-spacing: -0.06em;
        position: relative;
      }

      .back_btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        border: 2px solid #000;
        border-radius: 50%;
        text-decoration: none;
        color: #000;
        flex-shrink: 0; /* ボタンが縮まないようにする */
        transition:
          background 0.2s,
          color 0.2s;
      }

      .back_btn:hover {
        background: #000;
        color: #c8dcff;
      }

      .back_arrow {
        font-size: 20px;
        line-height: 1;
      }

      .illust_bord {
        width: 100%;
        margin: 0 auto;
      }

      .illust_contents {
        max-width: 1900px;
        display: flex;
        gap: 25px;
        min-height: 1022px; /* height → min-height、overflow: hidden も削除 */
        padding: 16px;
        box-sizing: border-box;
        background: rgb(200, 220, 255);
        margin: 0 auto;
        border-left: 1px solid #000;
        border-right: 1px solid #000;
      }

      .illust_list {
        display: flex;
        flex-wrap: wrap;
        gap: 32px;
        margin: 0 auto;
        padding: 16px;
      }

      .gallery_item {
        margin: 0;
        cursor: pointer;
      }

      .illust_list img {
        display: block;
        width: 50vh;
        padding: 10px;
        box-sizing: content-box;
      }

      .gallery_caption {
        padding: 4px 10px 0;
        font-family: "Zen Kaku Gothic New", sans-serif;
        font-weight: 700;
        font-size: 16px;
        color: #000;
      }

      /* ==================== スマホ対応 ==================== */
      @media (max-width: 768px) {
        .contents_texto {
          padding: 10px 12px;
          gap: 12px;
          white-space: normal;
          overflow: hidden;
        }

        .contents_texto h2 {
          flex: 1 1 0%;
          min-width: 0;
          font-size: 15vw;
          overflow-x: hidden;
          overflow-y: hidden;
          white-space: nowrap;
          -webkit-overflow-scrolling: touch;
          scrollbar-width: none;
          font-size: 15vw;
        }

        .content_label {
          top: 10px;
          right: 66px;
          max-width: 88px;
          box-sizing: border-box;
          overflow-x: hidden;
          white-space: nowrap;
          font-size: 11px;
          padding: 4px 8px;
          color: rgb(200, 220, 255);
          -webkit-text-stroke-width: 2px;
          -webkit-text-fill-color: #000;
          paint-order: stroke fill;
          z-index: 1;
        }

        /* ---- ここから無限ループ・マーキー用のスタイル ---- */
        :global(.marquee-track) {
          display: inline-flex;
          white-space: nowrap;
        }

        :global(.marquee-track.is-scrolling) {
          animation-name: marquee-loop;
          animation-timing-function: linear;
          animation-iteration-count: infinite;
        }

        @keyframes marquee-loop {
          from {
            transform: translateX(0);
          }
          to {
            transform: translateX(var(--marquee-distance, 0px));
          }
        }

        :global(.marquee-item) {
          display: inline-block;
          white-space: nowrap;
        }
        /* ---- ここまで ---- */

        .back_btn {
          width: 40px;
          height: 40px;
        }

        .back_arrow {
          font-size: 16px;
        }

        .illust_bord {
          border-left: none;
          border-right: none;
        }

        .illust_contents {
          width: 100%;
          height: 90vh;
          padding: 12px;
          gap: 0;
        }

        .illust_list {
          display: flex;
          flex-direction: column;
          flex-wrap: nowrap;
          gap: 24px;
          width: 100%;
          margin-top: 50px;
          padding: 0;
          height: 90vh;
        }

        .illust_list img {
          width: 40vh;
          padding: 0;
          margin: 0 auto;
        }

        .gallery_caption {
          font-size: 8px;
          margin: 0 auto;
          text-align: center;
        }
      }
    </style>

    <script></script>
  </body>
</BaseLayout>
