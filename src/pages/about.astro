        .about_name_ch,
        .about_romaji,
        .about_intro,
        .about_links li,
        .about_profile_row {
          opacity: 1 !important;
          transform: none !important;
          filter: none !important;
        }
        .about_rule {
          transform: none !important;
        }
      }

      /* ==================== スマホ対応 ==================== */
      @media (max-width: 768px) {
        .contents_texto {
          padding: 10px 12px;
          gap: 12px;
          white-space: normal;
