    <style>
      * {
        margin: 0;
        padding: 0;
      }

      html {
        scrollbar-color: #ffffff #f8d7e5;
      }

      body {
        background-color: #fff;
        position: relative;
      }

      :root {
        --morph-duration: 0.6s;

        --page-color: #fce2ed;

        --header-back-color: var(--page-color);
      }

      ::view-transition-old(title--message),
      ::view-transition-new(title--message) {
        animation-duration: var(--morph-duration);
      }

      .contents-list {
        display: block;
      }

      .board {
        position: relative; /* ← 付箋の absolute 配置の基準点 */
        width: 100%;
        height: 1022px; /* ← 高さが必須！ないと付箋が見えない */
        background: #fce2ed;
        overflow: hidden;
        margin: auto;
        border-bottom: 1px solid #000;
      }

      :global(.sticky) {
        position: absolute; /* ← これが効かないと一覧になる */
        width: 250px;
        min-height: 120px;
        background: #fff;
        border: 2px solid #c42222;
        padding: 10px 12px 16px;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        gap: 5px;
        clip-path: polygon(
          0 0,
          calc(100% - 16px) 0,
          100% 16px,
          100% 100%,
          0 100%
        );
        box-shadow: 2px 2px 0 #c42222;
        transition:
          box-shadow 0.14s ease,
          transform 0.14s ease;
      }
      :global(.sticky::before) {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 16px;
        height: 16px;
        background: #c42222;
        clip-path: polygon(0 0, 100% 100%, 100% 0);
        z-index: 2;
      }
      :global(.sticky::after) {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 15px;
        height: 15px;
        background: #f7c5c5;
        clip-path: polygon(0 0, 100% 100%, 0 100%);
        z-index: 20;
      }
      :global(.sticky:hover) {
        box-shadow: 4px 5px 0 #c42222;
        transform: scale(1.06) translateY(-3px);
        z-index: 500 !important;
      }
      :global(.sticky .s-from) {
        font-size: 9px;
        font-weight: 700;
        color: #c42222;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        border-bottom: 1px solid #f7c5c5;
        padding-bottom: 5px;
        font-family: "Noto Sans JP", sans-serif;
      }
      :global(.sticky .s-msg) {
        font-size: 12px;
        font-weight: 700;
        color: #c42222;
        line-height: 1.25;
        flex: 1;
        font-family: "Noto Sans JP", sans-serif;
      }
      :global(.sticky .s-msg p + p) {
        margin-top: 0.4em;
      }
      :global(.sticky .s-num) {
        font-family: "Bebas Neue", monospace;
        font-size: 9px;
        color: #c42222;
        opacity: 0.35;
        letter-spacing: 0.1em;
        margin-top: 2px;
      }

      .modal-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1000;
        align-items: center;
        justify-content: center;
      }
      .modal-backdrop.open {
        display: flex;
      }

      .modal {
        background: #fff;
        border: 3px solid #c42222;
        box-shadow: 7px 7px 0 #c42222;
        padding: 36px 32px 28px;
        max-width: 600px;
        width: 90%;
        position: relative;
        clip-path: polygon(
          0 0,
          calc(100% - 24px) 0,
          100% 24px,
          100% 100%,
          0 100%
        );
        animation: popIn 0.18s ease;
      }
      .modal::before {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 24px;
        height: 24px;
        background: #c42222;
        clip-path: polygon(0 0, 100% 100%, 100% 0);
        z-index: 2;
      }
      .modal::after {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 23px;
        height: 23px;
        background: #f7c5c5;
        clip-path: polygon(0 0, 100% 100%, 0 100%);
        z-index: 1;
      }
      @keyframes popIn {
        from {
          transform: scale(0.8);
          opacity: 0;
        }
        to {
          transform: scale(1);
          opacity: 1;
        }
      }
      .modal .m-close {
        position: absolute;
        top: 10px;
        right: 14px;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 18px;
        font-weight: 700;
        color: #c42222;
        z-index: 10;
        line-height: 1;
        font-family: "Noto Sans JP", sans-serif;
      }
      .modal .m-from {
        font-size: 17px;
        font-weight: 700;
        color: #c42222;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        border-bottom: 2px solid #c42222;
        padding-bottom: 17px;
        margin-bottom: 14px;
        font-family: "Noto Sans JP", sans-serif;
      }
      .modal .m-msg {
        font-size: 26px;
        font-weight: 900;
        color: #c42222;
        line-height: 1.3;
        font-family: "Noto Sans JP", sans-serif;
      }
      .modal .m-msg p + p {
        margin-top: 0.6em;
      }

      /* ==================== スマホ対応 ==================== */
      @media (max-width: 768px) {

        /* ---- ここから無限ループ・マーキー用のスタイル ---- */
        :global(.marquee-track) {
          display: inline-flex;
          white-space: nowrap;
        }

        :global(.marquee-track.is-scrolling) {
          animation-name: marquee-loop;
          animation-timing-function: linear;
          animation-iteration-count: infinite;
        }

        :global(.marquee-item) {
          display: inline-block;
          white-space: nowrap;
        }
        /* ---- ここまで ---- */

        :global(.sticky) {
          border: 1px solid #c42222;
        }

        /* スマホ用の付箋。読める文字サイズにし、本文は冒頭だけ見せる（全文はタップでモーダル） */
        :global(.sticky--sm) {
          width: 150px;
          min-height: 96px;
          padding: 8px 10px 10px;
          gap: 4px;
          clip-path: polygon(
            0 0,
            calc(100% - 12px) 0,
            100% 12px,
            100% 100%,
            0 100%
          );
        }
        :global(.sticky--sm::before) {
          width: 12px;
          height: 12px;
        }
        :global(.sticky--sm::after) {
          width: 11px;
          height: 11px;
        }

        :global(.sticky .s-from) {
          font-size: 7px;
          font-weight: 700;
          color: #c42222;
          letter-spacing: 0.1em;
          text-transform: uppercase;
          border-bottom: 1px solid #f7c5c5;
          padding-bottom: 5px;
          font-family: "Noto Sans JP", sans-serif;
        }
        :global(.sticky--sm .s-from) {
          font-size: 9px;
          padding-bottom: 4px;
        }

        :global(.sticky .s-msg) {
          font-size: 8px;
          font-weight: 700;
          color: #c42222;
          line-height: 1.25;
          flex: 1;
          font-family: "Noto Sans JP", sans-serif;
        }
        :global(.sticky--sm .s-msg) {
          font-size: 10px;
          line-height: 1.4;
          display: -webkit-box;
          -webkit-box-orient: vertical;
          -webkit-line-clamp: 5;
          line-clamp: 5;
          overflow: hidden;
        }
        :global(.sticky .s-msg p + p) {
          margin-top: 0.3em;
        }
        :global(.sticky--sm .s-msg p + p) {
          margin-top: 0.2em;
        }

        :global(.sticky .s-num) {
          font-family: "Bebas Neue", monospace;
          font-size: 5px;
          color: #c42222;
          opacity: 0.35;
          letter-spacing: 0.1em;
          margin-top: 2px;
        }
        :global(.sticky--sm .s-num) {
          font-size: 7px;
        }

        .modal {
          padding: 28px 20px 20px;
          margin: 2rem;
        }
        .modal .m-msg {
          font-size: 20px;
        }
      }
    </style>
  </body>
