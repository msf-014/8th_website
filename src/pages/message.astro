            ],
          },
        ];

        // スマホ判定（767px未満）
        function isMobile() {
          return window.innerWidth < 767;
        }

        // デバイスに応じたカードサイズを返す
        function cardSize() {
          return isMobile()
            ? { w: 100, h: 100 } // スマホ用
            : { w: 150, h: 120 }; // PC用
        }

        // 板を伸ばす時に付箋の下に足す余白
        const MARGIN = 24;
        // 候補位置の格子の間隔(px)
        const STEP = 8;

        // ホバー時に scale(1.06) と translateY(-3px) で少し膨らむ分の余白。
        // この分だけ配置可能エリアを内側に狭めておくことで、
        // ホバーしても画面端からはみ出さないようにする。
        const HOVER_BUFFER = 10;

        const hits = (a, b) =>
          a.left < b.right &&
          a.right > b.left &&
          a.top < b.bottom &&
          a.bottom > b.top;

        // [x0, x1] × [y0, y1] の範囲の格子点を返す。
        // 完全な乱数順だと配置が疎になって板がむやみに伸びるので、
        // 「上から順」に大きめの乱数を混ぜた順にし、上から密に・ばらけて埋まるようにする
        const ORDER_JITTER = 400;
        function makeGrid(x0, y0, x1, y1) {
          const pts = [];
          for (let y = y0; y <= y1; y += STEP) {
            for (let x = x0; x <= x1; x += STEP) {
              pts.push({ x, y, key: y + Math.random() * ORDER_JITTER });
            }
          }
          return pts.sort((a, b) => a.key - b.key);
        }

        // sizes: [{w, h}, ...] 各付箋の「実測サイズ」。pad: 付箋の padding(文字領域の内側)。
        // 付箋の箱同士は重なってもよいが、相手の箱が自分の文字領域に乗る(=読めなくなる)
        // 配置だけを禁止する。板の中に置き場所がなければ板を下に伸ばして続ける。
        // 戻り値: { placed: [{x, y, w, h}], height: 必要になった板の高さ }
        function autoPlace(sizes, areaW, areaH, pad) {
          const edge = HOVER_BUFFER;
          const textOf = (box) => ({
            left: box.left + pad.left,
            top: box.top + pad.top,
            right: box.right - pad.right,
            bottom: box.bottom - pad.bottom,
          });
          const placed = []; // { box, text }
          const result = [];
          let H = areaH;
          let grid = makeGrid(edge, edge, areaW - edge, H - edge);

          // 候補を先頭(上寄り・乱数混じり)から数十個集め、周囲(板の縁・他の付箋)に
          // 接している数が多いものを選ぶ。乱数順のまま最初の候補を取ると疎になって
          // 板がむやみに伸びるので、密に・それでもばらけて埋まるようにする
          const CANDIDATES = 60;
          const NEAR = STEP * 2;
          const pick = (s) => {
            const found = [];
            for (const g of grid) {
              if (g.x > areaW - edge - s.w || g.y > H - edge - s.h) continue;
              const box = {
                left: g.x,
                top: g.y,
                right: g.x + s.w,
                bottom: g.y + s.h,
              };
              const text = textOf(box);
              if (
                !placed.every((p) => !hits(box, p.text) && !hits(text, p.box))
              )
                continue;
              const near = {
                left: box.left - NEAR,
                top: box.top - NEAR,
                right: box.right + NEAR,
                bottom: box.bottom + NEAR,
              };
              let score = 0;
              if (near.left <= edge) score++;
              if (near.right >= areaW - edge) score++;
              if (near.top <= edge) score++;
              for (const p of placed) if (hits(near, p.box)) score++;
              found.push({ box, score });
              if (found.length >= CANDIDATES) break;
            }
            if (found.length === 0) return null;
            let best = found[0];
            for (const c of found) if (c.score > best.score) best = c;
            return best.box;
          };

          sizes.forEach((s) => {
            let found = null;
            for (let guard = 0; guard < 50 && !found; guard++) {
              found = pick(s);
              if (found) break;
              // 置き場所がない: 板を付箋1枚分伸ばし、その帯の候補を追加する
              // (既存領域の候補を先に試すので、伸びた帯は必要な時だけ使われる)
              const prevH = H;
              H += s.h + MARGIN;
              grid = grid.concat(
                makeGrid(
                  edge,
                  Math.max(edge, prevH - s.h),
                  areaW - edge,
                  H - edge,
                ),
              );
            }
            if (!found) {
              // ここには来ないはずだが、万一の時は左上に置く
              found = {
                left: edge,
                top: edge,
                right: edge + s.w,
                bottom: edge + s.h,
              };
            }
            placed.push({ box: found, text: textOf(found) });
            result.push({ x: found.left, y: found.top, w: s.w, h: s.h });
          });
          return { placed: result, height: H };
        }

        // msg は「段落の配列。各段落はさらに行の配列」という二重構造。
        // 例: [["1行目", "2行目(同じ段落)"], ["別の段落"]]
        // 段落ごとに<p>を作り、その中の行は<br>で区切ることで、
        // 「改行」と「段落」の余白を別々に表現できるようにする。
        function renderMessage(container, msg) {
          msg.forEach((paragraph) => {
            // 段落を文字列でうっかり書いてしまった場合（例: "本文"）も
            // 1行だけの段落として扱えるように、配列に正規化しておく。
            const lines = Array.isArray(paragraph) ? paragraph : [paragraph];
            const p = document.createElement("p");
            lines.forEach((line, idx) => {
              if (idx > 0) p.appendChild(document.createElement("br"));
              p.appendChild(document.createTextNode(line));
            });
            container.appendChild(p);
          });
        }

        // 付箋1件分のDOM（中身）を作る共通処理
        function createStickyEl(m, i, mobile) {
          const el = document.createElement("div");
          el.className = "sticky" + (mobile ? " sticky--sm" : "");

          const fromEl = document.createElement("span");
          fromEl.className = "s-from";
          fromEl.textContent = m.from;

          const msgEl = document.createElement("div");
          msgEl.className = "s-msg";
          renderMessage(msgEl, m.msg);

          const numEl = document.createElement("span");
          numEl.className = "s-num";
          numEl.textContent = "MESSAGE ——— " + String(i + 1).padStart(4, "0");

          el.appendChild(fromEl);
          el.appendChild(msgEl);
          el.appendChild(numEl);
          return el;
        }

        function buildBoard() {
          const board = document.getElementById("board");
          if (!board) return;
          board.querySelectorAll(".sticky").forEach((el) => el.remove());

          const mobile = isMobile();
          board.style.height = "";
          const W = board.offsetWidth;
          let H = board.offsetHeight;

          // 1. まず全付箋のDOMを作って板に追加し、実際の描画サイズ（特に高さ）を測る。
          //    幅はCSSで固定だが、高さは文章量によって変わるため、
          //    先に実測しておくことで重なり回避の計算精度が上がる。
          const els = messages.map((m, i) => {
            const el = createStickyEl(m, i, mobile);
            el.style.cssText =
              "position:absolute;left:0;top:0;visibility:hidden;opacity:0;transition:opacity 0.3s,box-shadow 0.14s,transform 0.14s;";
            board.appendChild(el);
            return el;
          });
          const sizes = els.map((el) => ({
            w: el.offsetWidth,
            h: el.offsetHeight,
          }));
          if (els.length === 0) return;

          // 2. 実測サイズをもとに、文字が隠れない位置を計算する。
          //    付箋の padding(文字領域の外側)を測って渡す
          const cs = getComputedStyle(els[0]);
          const pad = {
            left: parseFloat(cs.paddingLeft),
            top: parseFloat(cs.paddingTop),
            right: parseFloat(cs.paddingRight),
            bottom: parseFloat(cs.paddingBottom),
          };
          const { placed, height } = autoPlace(sizes, W, H, pad);
          // 置き場所が足りず板が伸びた場合は、その高さにしてページをスクロールさせる
          if (height > H) {
            H = height;
            board.style.height = H + "px";
          }

          // 3. 面積が大きい付箋ほど後ろ（z-indexを小さく）、
          //    小さい付箋ほど手前に来るよう、面積順にz-indexを割り当てる。
          //    「何番目に配置したか」ではなく「大きさ」で前後関係を決めている。
          const order = sizes
            .map((s, i) => ({ i, area: s.w * s.h }))
            .sort((a, b) => b.area - a.area); // 面積が大きい順（後ろに来るものが先）
          const zIndexByIndex = {};
          order.forEach((o, rank) => {
            zIndexByIndex[o.i] = 10 + rank; // 大きい付箋ほど小さいz-index（＝後ろ）
          });

          // 4. 位置とz-indexを確定して表示する
          els.forEach((el, i) => {
            const p = placed[i];
            el.style.left = p.x + "px";
            el.style.top = p.y + "px";
            el.style.zIndex = String(zIndexByIndex[i]);
            el.style.visibility = "visible";
            el.addEventListener("click", () => openModal(messages[i]));
            setTimeout(() => {
              el.style.opacity = "1";
            }, i * 50);
          });
        }

        function openModal(m) {
          document.getElementById("m-from").textContent = m.from;
          const msgEl = document.getElementById("m-msg");
          msgEl.innerHTML = "";
          renderMessage(msgEl, m.msg);
          document.getElementById("modal-backdrop").classList.add("open");
        }

        function closeModal() {
          document.getElementById("modal-backdrop").classList.remove("open");
        }

        document
          .getElementById("m-close")
          .addEventListener("click", closeModal);
        document
          .getElementById("modal-backdrop")
          .addEventListener("click", (e) => {
            if (e.target === document.getElementById("modal-backdrop"))
              closeModal();
          });

        // board要素の「実際の描画サイズ」が確定してから配置する。
        // DOMContentLoaded直後だとCSSがまだ適用しきれておらず
        // offsetWidthが0のまま計算されてしまうことがあるため、
        // ResizeObserverで幅が確定したタイミングを検知する。
        const boardEl = document.getElementById("board");
        let hasBuilt = false;
        // Webフォントの読み込み前に測ると、後で付箋の高さが変わって文字が隠れる
        const fontsReady = document.fonts
          ? document.fonts.ready
          : Promise.resolve();
        const build = () => fontsReady.then(buildBoard);

        if (boardEl) {
          // buildBoard がボードの高さを変えるため、幅が変わったときだけ配置し直す
          let lastWidth = 0;
          const ro = new ResizeObserver((entries) => {
            for (const entry of entries) {
              const w = entry.contentRect.width;
              const h = entry.contentRect.height;
              if (w > 0 && h > 0 && w !== lastWidth) {
                lastWidth = w;
                build();
                hasBuilt = true;
              }
            }
          });
          ro.observe(boardEl);
        }

        // 念のためのフォールバック（ResizeObserver未対応環境向け）
        window.addEventListener("load", () => {
          if (!hasBuilt) build();
        });
        // ClientRouter での遷移時は load が発火しないので、遷移完了時にも確認する
        document.addEventListener(
          "astro:page-load",
          () => {
            if (!hasBuilt) build();
            hasBuilt = true;
          },
          { once: true },
        );
      })();
    </script>

    <Footer />

    <style>
      * {
        margin: 0;
        padding: 0;
      }

      html {
        scrollbar-color: #ffffff #f8d7e5;
      }

      body {
        background-color: #fff;
        position: relative;
      }

      :root {
        --morph-duration: 0.6s;

        --page-color: #fce2ed;

        --header-back-color: var(--page-color);
      }

      ::view-transition-old(title--message),
      ::view-transition-new(title--message) {
        animation-duration: var(--morph-duration);
      }

      .contents-list {
        display: block;
      }

      .board {
        position: relative; /* ← 付箋の absolute 配置の基準点 */
        width: 100%;
        /* 最低の高さ。付箋が収まらなければ JS が height を伸ばす */
        min-height: 1022px;
        background: #fce2ed;
        overflow: hidden;
        margin: auto;
        border-bottom: 1px solid #000;
      }

      :global(.sticky) {
        position: absolute; /* ← これが効かないと一覧になる */
        width: 250px;
        min-height: 120px;
        background: #fff;
        border: 2px solid #c42222;
        padding: 10px 12px 16px;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        gap: 5px;
        clip-path: polygon(
          0 0,
          calc(100% - 16px) 0,
          100% 16px,
          100% 100%,
          0 100%
        );
        box-shadow: 2px 2px 0 #c42222;
        transition:
          box-shadow 0.14s ease,
          transform 0.14s ease;
      }
      :global(.sticky::before) {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 16px;
        height: 16px;
        background: #c42222;
        clip-path: polygon(0 0, 100% 100%, 100% 0);
        z-index: 2;
      }
      :global(.sticky::after) {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 15px;
        height: 15px;
        background: #f7c5c5;
        clip-path: polygon(0 0, 100% 100%, 0 100%);
        z-index: 20;
      }
      :global(.sticky:hover) {
        box-shadow: 4px 5px 0 #c42222;
        transform: scale(1.06) translateY(-3px);
        z-index: 500 !important;
      }
      :global(.sticky .s-from) {
        font-size: 9px;
        font-weight: 700;
        color: #c42222;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        border-bottom: 1px solid #f7c5c5;
        padding-bottom: 5px;
        font-family: "Noto Sans JP", sans-serif;
      }
      :global(.sticky .s-msg) {
        font-size: 12px;
        font-weight: 700;
        color: #c42222;
        line-height: 1.25;
        flex: 1;
        font-family: "Noto Sans JP", sans-serif;
      }
      :global(.sticky .s-msg p + p) {
        margin-top: 0.4em;
      }
      :global(.sticky .s-num) {
        font-family: "Bebas Neue", monospace;
        font-size: 9px;
        color: #c42222;
        opacity: 0.35;
        letter-spacing: 0.1em;
        margin-top: 2px;
      }

      .modal-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1000;
        align-items: center;
        justify-content: center;
      }
      .modal-backdrop.open {
        display: flex;
      }

      .modal {
        background: #fff;
        border: 3px solid #c42222;
        box-shadow: 7px 7px 0 #c42222;
        padding: 36px 32px 28px;
        max-width: 600px;
        width: 90%;
        position: relative;
        clip-path: polygon(
          0 0,
          calc(100% - 24px) 0,
          100% 24px,
          100% 100%,
          0 100%
        );
        animation: popIn 0.18s ease;
      }
      .modal::before {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 24px;
        height: 24px;
        background: #c42222;
        clip-path: polygon(0 0, 100% 100%, 100% 0);
        z-index: 2;
      }
      .modal::after {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 23px;
        height: 23px;
        background: #f7c5c5;
        clip-path: polygon(0 0, 100% 100%, 0 100%);
        z-index: 1;
      }
      @keyframes popIn {
        from {
          transform: scale(0.8);
          opacity: 0;
        }
        to {
          transform: scale(1);
          opacity: 1;
        }
      }
      .modal .m-close {
        position: absolute;
        top: 10px;
        right: 14px;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 18px;
        font-weight: 700;
        color: #c42222;
        z-index: 10;
        line-height: 1;
        font-family: "Noto Sans JP", sans-serif;
      }
      .modal .m-from {
        font-size: 17px;
        font-weight: 700;
        color: #c42222;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        border-bottom: 2px solid #c42222;
        padding-bottom: 17px;
        margin-bottom: 14px;
        font-family: "Noto Sans JP", sans-serif;
      }
      .modal .m-msg {
        font-size: 26px;
        font-weight: 900;
        color: #c42222;
        line-height: 1.3;
        font-family: "Noto Sans JP", sans-serif;
      }
      .modal .m-msg p + p {
        margin-top: 0.6em;
      }

      /* ==================== スマホ対応 ==================== */
      @media (max-width: 768px) {
        /* ---- ここから無限ループ・マーキー用のスタイル ---- */
        :global(.marquee-track) {
          display: inline-flex;
          white-space: nowrap;
        }

        :global(.marquee-track.is-scrolling) {
          animation-name: marquee-loop;
          animation-timing-function: linear;
          animation-iteration-count: infinite;
        }

        :global(.marquee-item) {
          display: inline-block;
          white-space: nowrap;
        }
        /* ---- ここまで ---- */

        :global(.sticky) {
          border: 1px solid #c42222;
        }

        /* スマホ用の付箋。読める文字サイズにし、本文は冒頭だけ見せる（全文はタップでモーダル） */
        :global(.sticky--sm) {
          width: 150px;
          min-height: 96px;
          padding: 8px 10px 10px;
          gap: 4px;
          clip-path: polygon(
            0 0,
            calc(100% - 12px) 0,
            100% 12px,
            100% 100%,
            0 100%
          );
        }
        :global(.sticky--sm::before) {
          width: 12px;
          height: 12px;
        }
        :global(.sticky--sm::after) {
          width: 11px;
          height: 11px;
        }

        :global(.sticky .s-from) {
          font-size: 7px;
          font-weight: 700;
          color: #c42222;
          letter-spacing: 0.1em;
          text-transform: uppercase;
          border-bottom: 1px solid #f7c5c5;
          padding-bottom: 5px;
          font-family: "Noto Sans JP", sans-serif;
        }
        :global(.sticky--sm .s-from) {
          font-size: 9px;
          padding-bottom: 4px;
        }

        :global(.sticky .s-msg) {
          font-size: 8px;
          font-weight: 700;
          color: #c42222;
          line-height: 1.25;
          flex: 1;
          font-family: "Noto Sans JP", sans-serif;
        }
        :global(.sticky--sm .s-msg) {
          font-size: 10px;
          line-height: 1.4;
          display: -webkit-box;
          -webkit-box-orient: vertical;
          -webkit-line-clamp: 5;
          line-clamp: 5;
          overflow: hidden;
        }
        :global(.sticky .s-msg p + p) {
          margin-top: 0.3em;
        }
        :global(.sticky--sm .s-msg p + p) {
          margin-top: 0.2em;
        }

        :global(.sticky .s-num) {
          font-family: "Bebas Neue", monospace;
          font-size: 5px;
          color: #c42222;
          opacity: 0.35;
          letter-spacing: 0.1em;
          margin-top: 2px;
        }
        :global(.sticky--sm .s-num) {
          font-size: 7px;
        }

        .modal {
          padding: 28px 20px 20px;
          margin: 2rem;
        }
        .modal .m-msg {
          font-size: 20px;
        }
      }
    </style>
  </body>
</BaseLayout>
