---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/header.astro";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/footer.astro";
---

<BaseLayout>
  <body>
    <div class="bg_reveal" id="bg_reveal"></div>
    <div class="contents-list" transition:name="title--message">
      <div class="contents_texto">
        <span class="content_label">記念メッセージ</span>
        <h2>MESSAGE</h2>
        <a href="/" class="back_btn" aria-label="戻る">
          <span class="back_arrow">←</span>
        </a>
      </div>
    </div>

    <div class="board-wrap" id="board-wrap" style="opacity: 0;">
      <div class="board" id="board"></div>
    </div>

    <div class="modal-backdrop" id="modal-backdrop">
      <div class="modal" role="dialog" aria-modal="true">
        <button class="m-close" id="m-close" aria-label="閉じる">✕</button>
        <p class="m-from" id="m-from"></p>
        <p class="m-msg" id="m-msg"></p>
      </div>
    </div>

    <!-- is:inline が必須！これがないとAstroがJSを最適化して動かなくなる -->
    <script is:inline>
      // is:inline スクリプト内、または別の<script>で
      const originX = sessionStorage.getItem("revealOriginX") || "50%";
      const originY = sessionStorage.getItem("revealOriginY") || "50%";

      const bgReveal = document.getElementById("bg_reveal");
      if (bgReveal) {
        bgReveal.style.transformOrigin = `${originX}px ${originY}px`;
      }

      const messages = [
        {
          from: "かぶと",
          msg: [
            "矢車へ。",
            "8周年おめでとう！",
            "いつも配信でたくさん元気もらってます！矢車に出会えて本当に幸せです！",
            "これからも矢車のこと応援させてね！大大大大大好きです〜！！！！",
          ],
        },
        {
          from: "ゆかん。",
          msg: [
            "りねちゃん、8周年おめでとうございます🎉",
            "いつもたくさんの元気をもらっています！あなたの笑顔が大好き！",
            "お顔もお歌も最強の11歳🔥",
            "これからも応援しています♡",
          ],
        },
        {
          from: "早川",
          msg: [
            "8周年おめでとうございます🎉",
            "いつも元気をありがとう！！",
            "大好きだ〜〜〜〜！！！",
          ],
        },
        {
          from: "らぴ♡",
          msg: [
            "8周年おめでとうございます！",
            "矢車さんがオーストラリアに住んでたことが発覚したりラップが上手だったり3Dお披露目も見れたりと色んな活躍が見れて本当に楽しかったです！",
            "矢車さんが色んなお話してたりゲームに挑戦する度に矢車さんのこと好きだなぁって日に日に好き度が増していきますദ്ദി˶ｰ̀֊ｰ́ )",
            "8周年も矢車さんのペースで活動をしていってほしいし矢車さんがやりたいことをたくさんできたら嬉しいなと思っています。",
            "これからも矢車さん大好き！！",
          ],
        },
        {
          from: "オールドキング",
          msg: [
            "8周年本当におめでとうございます！",
            "デビュー当初見た目で気になって見始めてから喋りに引き込まれて英語やラップの上手さでさらに引き込まれて気づけばずっと見続けていました。",
            "矢車さんのことが好きな人が最近どんどん増えているのを見ると本当に嬉しく思います。",
            "本当にいつもたくさん楽しませてくれてありがとう！これからも応援し続けます！",
          ],
        },
        {
          from: "nu",
          msg: [
            "8周年おめでとう🎉",
            "出会えて良かった！矢車に元気を沢山もらって、笑顔になれる日が増えたよ◎本当にいつもありがとう！！",
            "矢車りね最高だ〜〜💐",
          ],
        },
        { from: "名前", msg: "これはテストメッセージです。" },
        { from: "名前", msg: "これはテストメッセージです。" },
        { from: "名前", msg: "これはテストメッセージです。" },
        { from: "名前", msg: "これはテストメッセージです。" },
        { from: "名前", msg: "これはテストメッセージです。" },
        { from: "名前", msg: "これはテストメッセージです。" },
        {
          from: "名前",
          msg: "これはテストメッセージです。これはテストメッセージです。これはテストメッセージです。これはテストメッセージです。これはテストメッセージです。これはテストメッセージです。これはテストメッセージです。",
        },
        { from: "名前", msg: "これはテストメッセージです。" },
      ];

      const CARD_W = 156,
        CARD_H = 120,
        MARGIN = 40,
        MAX_TRIES = 120;

      function autoPlace(items, areaW, areaH) {
        const placed = [];
        items.forEach((m, i) => {
          let best = null,
            bestScore = -Infinity;
          for (let t = 0; t < MAX_TRIES; t++) {
            const x = MARGIN + Math.random() * (areaW - CARD_W - MARGIN * 2);
            const y = MARGIN + Math.random() * (areaH - CARD_H - MARGIN * 2);
            let overlap = 0;
            placed.forEach((p) => {
              const dx = Math.abs(x - p.x),
                dy = Math.abs(y - p.y);
              if (dx < CARD_W + 12 && dy < CARD_H + 12) {
                overlap += (CARD_W + 12 - dx) * (CARD_H + 12 - dy);
              }
            });
            if (-overlap > bestScore) {
              bestScore = -overlap;
              best = { x, y };
            }
          }
          placed.push({ ...m, x: best.x, y: best.y, z: 10 + i });
        });
        return placed;
      }

      function buildBoard() {
        const board = document.getElementById("board");
        if (!board) return;
        board.querySelectorAll(".sticky").forEach((el) => el.remove());
        const W = board.offsetWidth,
          H = board.offsetHeight;
        const placed = autoPlace(messages, W, H);

        placed.forEach((m, i) => {
          const el = document.createElement("div");
          el.className = "sticky";
          el.style.cssText = `left:${m.x}px;top:${m.y}px;z-index:${m.z};opacity:0;transition:opacity 0.3s,box-shadow 0.14s,transform 0.14s;`;

          const fromEl = document.createElement("span");
          fromEl.className = "s-from";
          fromEl.textContent = m.from;

          const msgEl = document.createElement("div");
          msgEl.className = "s-msg";
          m.msg.forEach((text) => {
            const p = document.createElement("p");
            p.textContent = text;
            msgEl.appendChild(p);
          });

          const numEl = document.createElement("span");
          numEl.className = "s-num";
          numEl.textContent = "REMINDER ——— " + String(i + 1).padStart(4, "0");

          el.appendChild(fromEl);
          el.appendChild(msgEl);
          el.appendChild(numEl);

          el.addEventListener("click", () => openModal(m));
          board.appendChild(el);
          setTimeout(() => {
            el.style.opacity = "1";
          }, i * 50);
        });
      }

      function openModal(m) {
        document.getElementById("m-from").textContent = m.from;

        const msgEl = document.getElementById("m-msg");
        msgEl.innerHTML = "";
        m.msg.forEach((text) => {
          const p = document.createElement("p");
          p.textContent = text;
          msgEl.appendChild(p);
        });

        document.getElementById("modal-backdrop").classList.add("open");
      }

      function closeModal() {
        document.getElementById("modal-backdrop").classList.remove("open");
      }

      document.getElementById("m-close").addEventListener("click", closeModal);
      document
        .getElementById("modal-backdrop")
        .addEventListener("click", (e) => {
          if (e.target === document.getElementById("modal-backdrop"))
            closeModal();
        });

      // DOMが確実に準備できてから実行
      document.addEventListener("astro:page-load", buildBoard);
    </script>

    <Footer />

    <style>
      * {
        margin: 0;
        padding: 0;
      }

      html {
        scrollbar-color: #ffffff #f8d7e5;
      }

      body {
        background-color: #fff;
        position: relative;
      }

      :root {
        --morph-duration: 0.6s;

        --header-back-color: #fce2ed;
      }

      ::view-transition-old(title--message),
      ::view-transition-new(title--message) {
        animation-duration: var(--morph-duration);
      }

      .bg_reveal {
        position: fixed;
        inset: 0;
        background: #fce2ed;
        background-image: radial-gradient(
          circle,
          rgba(120, 80, 200, 0.35) 1px,
          transparent 1px
        );
        background-size: 5px 5px;
        z-index: -1;
        transform: scaleY(0);
        animation: revealBg 0.4s ease forwards;
        /* transform-origin はJSで動的に設定するため、ここでは指定しない */
      }

      @keyframes revealBg {
        from {
          transform: scaleY(0);
        }
        to {
          transform: scaleY(1);
        }
      }

      .contents-list {
        display: block;
        box-shadow:
          0 -1px 0 0 #000,
          0 1px 0 0 #000;
      }

      .contents_texto {
        box-shadow:
          0 -1px 0 0 #000,
          0 1px 0 0 #000;
        padding: 14px 16px 14px;
        white-space: nowrap;
        position: relative;
        display: flex; /* 追加 */
        align-items: center; /* h2とボタンを縦中央揃え */
        gap: 24px; /* h2とボタンの間隔 */
        background: #fce2ed;
        z-index: 1;
      }

      .content_label {
        position: absolute;
        top: 14px;
        right: 16px;
        font-size: 15px;
        color: #000;
        font-family: "Zen Kaku Gothic New", sans-serif;
        font-weight: 800;
        padding: 6px 14px;
      }

      .contents_texto h2 {
        font-size: 110px;
        font-family: "acumin-variable", sans-serif;
        font-variation-settings:
          "wght" 400,
          "wdth" 100,
          "slnt" 0;
        font-style: normal;
        align-items: center;
        line-height: 1;
        letter-spacing: -0.06em;
        position: relative;
      }

      .back_btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        border: 2px solid #000;
        border-radius: 50%;
        text-decoration: none;
        color: #000;
        flex-shrink: 0; /* ボタンが縮まないようにする */
        transition:
          background 0.2s,
          color 0.2s;
      }

      .back_btn:hover {
        background: #000;
        color: #fce2ed;
      }

      .back_arrow {
        font-size: 20px;
        line-height: 1;
      }

      .board-wrap {
        width: 100%;
        max-width: 1900px;
        margin: 0px auto;
        border-left: 1px solid #000;
        border-right: 1px solid #000;
        margin-top: -1px;
      }

      #board-wrap {
        opacity: 0;
        animation: fadeInContent 0.4s ease forwards;
        animation-delay: 0.6s; /* モーフィングの再生時間と合わせる */
      }

      @keyframes fadeInContent {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }

      .board {
        position: relative; /* ← 付箋の absolute 配置の基準点 */
        width: 100%;
        height: 1022px; /* ← 高さが必須！ないと付箋が見えない */
        background: #fce2ed;
        overflow: hidden;
        margin: auto;
        border-bottom: 1px solid #000;
        z-index: -1;
      }

      :global(.sticky) {
        position: absolute; /* ← これが効かないと一覧になる */
        width: 250px;
        min-height: 120px;
        background: #fff;
        border: 2px solid #c42222;
        padding: 10px 12px 16px;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        gap: 5px;
        clip-path: polygon(
          0 0,
          calc(100% - 16px) 0,
          100% 16px,
          100% 100%,
          0 100%
        );
        box-shadow: 2px 2px 0 #c42222;
        transition:
          box-shadow 0.14s ease,
          transform 0.14s ease;
      }
      :global(.sticky::before) {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 16px;
        height: 16px;
        background: #c42222;
        clip-path: polygon(0 0, 100% 100%, 100% 0);
        z-index: 2;
      }
      :global(.sticky::after) {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 15px;
        height: 15px;
        background: #f7c5c5;
        clip-path: polygon(0 0, 100% 100%, 0 100%);
        z-index: 20;
      }
      :global(.sticky:hover) {
        box-shadow: 4px 5px 0 #c42222;
        transform: scale(1.06) translateY(-3px);
        z-index: 500 !important;
      }
      :global(.sticky .s-from) {
        font-size: 9px;
        font-weight: 700;
        color: #c42222;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        border-bottom: 1px solid #f7c5c5;
        padding-bottom: 5px;
        font-family: "Noto Sans JP", sans-serif;
      }
      :global(.sticky .s-msg) {
        font-size: 15px;
        font-weight: 900;
        color: #c42222;
        line-height: 1.25;
        flex: 1;
        font-family: "Noto Sans JP", sans-serif;
      }
      :global(.sticky .s-msg p + p) {
        margin-top: 0.4em;
      }
      :global(.sticky .s-num) {
        font-family: "Bebas Neue", monospace;
        font-size: 9px;
        color: #c42222;
        opacity: 0.35;
        letter-spacing: 0.1em;
        margin-top: 2px;
      }

      .modal-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1000;
        align-items: center;
        justify-content: center;
      }
      .modal-backdrop.open {
        display: flex;
      }

      .modal {
        background: #fff;
        border: 3px solid #c42222;
        box-shadow: 7px 7px 0 #c42222;
        padding: 36px 32px 28px;
        max-width: 600px;
        width: 90%;
        position: relative;
        clip-path: polygon(
          0 0,
          calc(100% - 24px) 0,
          100% 24px,
          100% 100%,
          0 100%
        );
        animation: popIn 0.18s ease;
      }
      .modal::before {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 24px;
        height: 24px;
        background: #c42222;
        clip-path: polygon(0 0, 100% 100%, 100% 0);
        z-index: 2;
      }
      .modal::after {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 23px;
        height: 23px;
        background: #f7c5c5;
        clip-path: polygon(0 0, 100% 100%, 0 100%);
        z-index: 1;
      }
      @keyframes popIn {
        from {
          transform: scale(0.8);
          opacity: 0;
        }
        to {
          transform: scale(1);
          opacity: 1;
        }
      }
      .modal .m-close {
        position: absolute;
        top: 10px;
        right: 14px;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 18px;
        font-weight: 700;
        color: #c42222;
        z-index: 10;
        line-height: 1;
        font-family: "Noto Sans JP", sans-serif;
      }
      .modal .m-from {
        font-size: 17px;
        font-weight: 700;
        color: #c42222;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        border-bottom: 2px solid #c42222;
        padding-bottom: 17px;
        margin-bottom: 14px;
        font-family: "Noto Sans JP", sans-serif;
      }
      .modal .m-msg {
        font-size: 26px;
        font-weight: 900;
        color: #c42222;
        line-height: 1.3;
        font-family: "Noto Sans JP", sans-serif;
      }
      .modal .m-msg p + p {
        margin-top: 0.6em;
      }

      /* ==================== スマホ対応 ==================== */
      @media (max-width: 768px) {
        .contents_texto {
          padding: 10px 12px;
          gap: 12px;
          white-space: normal;
          overflow: hidden;
        }

        .contents_texto h2 {
          flex: 1 1 0%;
          min-width: 0;
          font-size: 15vw;
          overflow-x: hidden;
          overflow-y: hidden;
          white-space: nowrap;
          -webkit-overflow-scrolling: touch;
          scrollbar-width: none;
          font-size: 15vw;
        }

        .content_label {
          top: 10px;
          right: 66px;
          max-width: 88px;
          box-sizing: border-box;
          overflow-x: hidden;
          white-space: nowrap;
          font-size: 11px;
          padding: 4px 8px;
        }

        /* ---- ここから無限ループ・マーキー用のスタイル ---- */
        :global(.marquee-track) {
          display: inline-flex;
          white-space: nowrap;
        }

        :global(.marquee-track.is-scrolling) {
          animation-name: marquee-loop;
          animation-timing-function: linear;
          animation-iteration-count: infinite;
        }

        @keyframes marquee-loop {
          from {
            transform: translateX(0);
          }
          to {
            transform: translateX(var(--marquee-distance, 0px));
          }
        }

        :global(.marquee-item) {
          display: inline-block;
          white-space: nowrap;
        }
        /* ---- ここまで ---- */

        .back_btn {
          width: 40px;
          height: 40px;
        }

        .back_arrow {
          font-size: 16px;
        }

        .chronology {
          max-width: 50vh;
          margin: 0 10px;
        }

        .chronology_title {
          padding: 16px 1em;
        }
        .chronology_subtitle {
          font-size: 20px;
          letter-spacing: 0.2em;
          margin: 0 0 2px 0;
        }
        .chronology_title h4 {
          font-size: 13vw;
        }
        .chronology_date {
          font-size: 15px;
        }

        :global(.timeline-wrap) {
          padding: 32px 16px;
          margin-bottom: 60px;
        }

        :global(.timeline-line) {
          left: 8px;
        }

        :global(.marker-col) {
          width: 16px;
          flex: 0 0 16px;
        }

        :global(.marker-circle) {
          width: 14px;
          height: 14px;
          border-width: 2px;
        }

        :global(.content-col) {
          padding-left: 16px;
          gap: 20px;
        }

        :global(.item-year) {
          font-size: 12px;
        }

        :global(.item-title) {
          font-size: 17px;
          padding-bottom: 8px;
        }

        :global(.item-desc) {
          font-size: 13px;
          line-height: 1.8;
        }

        :global(.item-comment) {
          font-size: 12px;
          padding: 8px 12px;
        }

        :global(.like-btn) {
          font-size: 12px;
          padding: 5px 12px;
        }

        :global(.item-youtube) {
          border-radius: 6px;
        }

        :global(.yt-play-btn) {
          width: 52px;
          height: 36px;
        }
      }
    </style>
  </body>
</BaseLayout>
