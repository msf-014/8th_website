---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/header.astro";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/footer.astro";
import PageBackground from "../components/PageBackground.astro";
import PageHeader from "../components/PageHeader.astro";
import PageFrame from "../components/PageFrame.astro";
---

<BaseLayout>
  <body>
    <PageBackground />
    <div class="contents-list" transition:name="title--message">
      <PageHeader title="MESSAGE" label="お祝いメッセージ" />
    </div>

    <PageFrame class="board-wrap" id="board-wrap">
      <div class="board" id="board"></div>
    </PageFrame>

    <div class="modal-backdrop" id="modal-backdrop">
      <div class="modal" role="dialog" aria-modal="true">
        <button class="m-close" id="m-close" aria-label="閉じる">✕</button>
        <p class="m-from" id="m-from"></p>
        <p class="m-msg" id="m-msg"></p>
      </div>
    </div>

    <!-- is:inline が必須！これがないとAstroがJSを最適化して動かなくなる -->
    <!-- data-astro-rerun: ClientRouter で再訪問したときも付箋を配置し直す。
         再実行で const の二重宣言にならないよう全体を関数で包む -->
