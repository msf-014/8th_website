---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/header.astro";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/footer.astro";

/**
 * ============================================================
 *  クレジット編集エリア
 * ============================================================
 *  名前を追加したいときは、各項目の `names` 配列に書き足すだけでOKです。
 *
 *    names: ["山田太郎", "Jane Doe"]
 *
 *  リンクを付けたい場合は、文字列の代わりにオブジェクトで書きます。
 *
 *    names: ["山田太郎", { name: "Jane Doe", url: "https://example.com" }]
 *
 *  `names` が空 [] のあいだは「準備中」と表示されます。
 *  項目そのものを増やしたい場合は、配列に { id, en, label, names } を1つ追加してください。
 *    en    ... 大きく表示される英語の見出し
 *    label ... その下に表示される日本語の見出し
 * ============================================================
 */
type Person = string | { name: string; url?: string };

const credits: {
  id: string;
  en: string;
  label: string;
  names: Person[];
}[] = [
  {
    id: "organizer",
    en: "ORGANIZER",
    label: "主催",
    names: ["Masahiro Fujiita"],
  },
  {
    id: "site",
    en: "SITE BUILD",
    label: "サイト構築",
    names: ["sotono", "Masahiro Fujita"],
  },
  {
    id: "illustration",
    en: "ILLUSTRATION",
    label: "イラスト",
    names: ["Masahiro Fujita", "奏音", "あんこあら"], // ← ここに名前を追加
  },
  {
    id: "chronology",
    en: "CHRONOLOGY",
    label: "年表",
    names: [
      "IKE",
      "奏音",
      "結城",
      "かぶと",
      "黒糖侍",
      "オールドキング",
      "五穀米",
    ], // ← ここに名前を追加
  },
  {
    id: "words",
    en: "WORDS",
    label: "言葉",
    names: ["にて", "Masahiro Fujita", "黒糖侍"], // ← ここに名前を追加
  },
  {
    id: "message",
    en: "MESSAGE",
    label: "メッセージ",
    names: [
      "匿名希望",
      "モスモスオ",
      "奏音",
      "みどり",
      "ふじみや。",
      "Sotono",
      "早川",
      "nu",
      "ダダダダ",
      "オールドキング",
      "Haruu",
      "レッセイ",
      "かぶと",
      "結城",
      "IKE",
      "おとがめなし子",
      "藤",
      "ゆかん。",
      "らぴ♡",
      "冬野",
      "IKE",
      "ダダダダ",
      "藤",
      "win",
      "水那",
      "あんこあら",
      "五穀米",
    ],
  },
];

// 文字列でもオブジェクトでも受け取れるように揃える
const normalize = (p: Person) => (typeof p === "string" ? { name: p } : p);
---

<BaseLayout>
  <body>
    <div class="bg_reveal" id="bg_reveal"></div>
    <div class="contents-list" transition:name="title--credit">
      <div class="contents_texto">
        <span class="content_label">企画参加者一覧</span>
        <h2>CREDIT</h2>
        <a href="/" class="back_btn" aria-label="戻る">
          <span class="back_arrow">←</span>
        </a>
      </div>
      <div class="page">
        <div class="page_content">
          <div class="content">
            {
              credits.map((section) => (
                <section class="credit_section" data-section={section.id}>
                  <div class="heading">
                    <h3 class="heading_en">{section.en}</h3>
                    <p class="heading_ja">{section.label}</p>
                  </div>
                  <div class="page_body">
                    {section.names.length > 0 ? (
                      <ul class="name_list">
                        {section.names.map((person) => {
                          const { name, url } = normalize(person);
                          return (
                            <li class="name_item">
                              {url ? (
                                <a
                                  href={url}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                >
                                  {name}
                                </a>
                              ) : (
                                <span>{name}</span>
                              )}
                            </li>
                          );
                        })}
                      </ul>
                    ) : (
                      <p class="name_empty">準備中</p>
                    )}
                  </div>
                </section>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <Footer />

    <style>
      * {
        margin: 0;
        padding: 0;
      }

      body {
        background-color: #fff;
        position: relative;
      }

      :root {
        --morph-duration: 0.6s;

        --header-back-color: rgb(230, 230, 230);
      }

      ::view-transition-old(title--message),
      ::view-transition-new(title--message) {
        animation-duration: var(--morph-duration);
      }

      .bg_reveal {
        position: fixed;
        inset: 0;
        background: rgb(230, 230, 230);
        background-image: radial-gradient(
          circle,
          rgba(120, 80, 200, 0.35) 1px,
          transparent 1px
        );
        background-size: 5px 5px;
        z-index: -1;
        transform: scaleY(0);
        animation: revealBg 0.4s ease forwards;
        /* transform-origin はJSで動的に設定するため、ここでは指定しない */
      }

      @keyframes revealBg {
        from {
          transform: scaleY(0);
        }
        to {
          transform: scaleY(1);
        }
      }

      .contents-list {
        display: block;
        box-shadow:
          0 -1px 0 0 #000,
          0 1px 0 0 #000;
      }

      .contents_texto {
        box-shadow:
          0 -1px 0 0 #000,
          0 1px 0 0 #000;
        padding: 14px 16px 14px;
        white-space: nowrap;
        position: relative;
        display: flex; /* 追加 */
        align-items: center; /* h2とボタンを縦中央揃え */
        gap: 24px; /* h2とボタンの間隔 */
        background: rgb(230, 230, 230);
      }

      .content_label {
        position: absolute;
        top: 14px;
        right: 16px;
        font-size: 15px;
        color: #000;
        font-family: "Zen Kaku Gothic New", sans-serif;
        font-weight: 800;
        padding: 6px 14px;
      }

      .contents_texto h2 {
        font-size: 110px;
        font-family: "acumin-variable", sans-serif;
        font-variation-settings:
          "wght" 400,
          "wdth" 100,
          "slnt" 0;
        font-style: normal;
        align-items: center;
        line-height: 1;
        letter-spacing: -0.06em;
        position: relative;
      }

      .back_btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        border: 2px solid #000;
        border-radius: 50%;
        text-decoration: none;
        color: #000;
        flex-shrink: 0; /* ボタンが縮まないようにする */
        transition:
          background 0.2s,
          color 0.2s;
      }

      .back_btn:hover {
        background: #000;
        color: #e6e6e6;
      }

      .back_arrow {
        font-size: 20px;
        line-height: 1;
      }

      .page {
        font-family: "Zen Kaku Gothic New", sans-serif;
        width: 1900px;
        margin: 0 auto;
        background: #e6e6e6;
        border-left: 1px solid #000;
        border-right: 1px solid #000;
      }

      .page_content {
        padding: 4rem 2.5rem;
      }

      .content_sub {
        border-bottom: 1px solid #000;
        padding: 2rem 0;
      }

      /* ==================== クレジット各項目 ==================== */

      /* 項目1つ分: 左半分に「項目名」、右半分に「名前」 */
      .credit_section {
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: 2rem;
        align-items: start;
        padding: 2.5rem 0;
        border-bottom: 1px solid #000;
      }

      .credit_section:first-child {
        padding-top: 0;
      }

      .credit_section:last-child {
        border-bottom: none;
        padding-bottom: 0;
      }

      /* 項目名: 背景なし。英語を大きく、日本語は従来サイズ */
      .heading {
        color: #000;
      }

      .heading_en {
        font-family: "acumin-variable", sans-serif;
        font-variation-settings:
          "wght" 400,
          "wdth" 100,
          "slnt" 0;
        font-style: normal;
        font-weight: normal;
        font-size: 72px;
        line-height: 1;
        letter-spacing: -0.06em;
      }

      .heading_ja {
        font-family: "Zen Kaku Gothic New", sans-serif;
        font-size: 1rem;
        font-weight: 800;
        line-height: 1.5;
        margin-top: 0.75rem;
      }

      /* 偶数番目の項目は左右を入れ替える:
         見出しは右(右揃え)、名前は左 */
      .credit_section:nth-child(even) .heading {
        grid-column: 2;
        grid-row: 1;
        text-align: right;
      }

      .credit_section:nth-child(even) .page_body {
        grid-column: 1;
        grid-row: 1;
      }

      .credit_section:not(:nth-child(even)) .name_list {
        justify-content: flex-end;
      }

      .page_body {
        font-family: "Zen Kaku Gothic New", sans-serif;
        line-height: 2;
        margin-bottom: 0;
      }

      /* 名前: 線で囲んだラベルを横に並べる */
      .name_list {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      .name_item {
        font-size: 1.25rem;
        font-weight: 500;
        line-height: 1;
      }

      .name_item span,
      .name_item a {
        display: block;
        padding: 0.7rem 1.25rem;
        color: #000;
        text-decoration: none;
      }

      .name_item a {
        border-radius: 999px;
        transition:
          background 0.2s,
          color 0.2s;
      }

      .name_item a:hover,
      .name_item a:focus-visible {
        background: #000;
        color: #e6e6e6;
      }

      /* 名前がまだ入っていない項目 */
      .name_empty {
        display: inline-block;
        font-size: 1rem;
        line-height: 1;
        color: rgba(0, 0, 0, 0.45);
        padding: 0.7rem 1.25rem;
        border: 1px dashed rgba(0, 0, 0, 0.45);
        border-radius: 999px;
      }

      /* ==================== スマホ対応 ==================== */
      @media (max-width: 768px) {
        .page {
          width: 100%; /* 1900px固定だと横にはみ出すため */
        }

        .page_content {
          padding: 2.5rem 1rem;
        }

        .contents_texto {
          padding: 10px 12px;
          gap: 12px;
          white-space: normal;
          overflow: hidden;
        }

        .contents_texto h2 {
          flex: 1 1 0%;
          min-width: 0;
          font-size: 15vw;
          overflow-x: hidden;
          overflow-y: hidden;
          white-space: nowrap;
          -webkit-overflow-scrolling: touch;
          scrollbar-width: none;
          font-size: 15vw;
        }

        .content_label {
          top: 10px;
          right: 66px;
          max-width: 88px;
          box-sizing: border-box;
          overflow-x: hidden;
          white-space: nowrap;
          font-size: 11px;
          padding: 4px 8px;
        }

        /* 項目名を上、名前を下に縦積み */
        .credit_section {
          grid-template-columns: 1fr;
          row-gap: 0.9rem;
          padding: 1.5rem 0;
        }

        .heading_en {
          font-size: 12vw;
        }

        .heading_ja {
          margin-top: 0.5rem;
        }

        /* 1カラムに戻すが、見出し→名前の順は保ち、
           偶数番目の項目は右寄せにして左右の交互配置を維持する */
        .credit_section:nth-child(even) .heading {
          grid-column: 1;
          grid-row: 1;
        }

        .credit_section:nth-child(even) .page_body {
          grid-column: 1;
          grid-row: 2;
          text-align: right;
        }

        .credit_section:nth-child(even) .name_list {
          justify-content: flex-end;
        }

        .name_item {
          font-size: 1.05rem;
        }

        .name_item span,
        .name_item a {
          padding: 0.6rem 1rem;
        }

        /* ---- ここから無限ループ・マーキー用のスタイル ---- */
        :global(.marquee-track) {
          display: inline-flex;
          white-space: nowrap;
        }

        :global(.marquee-track.is-scrolling) {
          animation-name: marquee-loop;
          animation-timing-function: linear;
          animation-iteration-count: infinite;
        }

        @keyframes marquee-loop {
          from {
            transform: translateX(0);
          }
          to {
            transform: translateX(var(--marquee-distance, 0px));
          }
        }

        :global(.marquee-item) {
          display: inline-block;
          white-space: nowrap;
        }
        /* ---- ここまで ---- */

        .back_btn {
          width: 40px;
          height: 40px;
        }

        .back_arrow {
          font-size: 16px;
        }
      }
    </style>
  </body>
</BaseLayout>
