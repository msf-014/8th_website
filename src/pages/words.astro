---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/header.astro";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/footer.astro";
---

<BaseLayout>
  <body>
    <div class="bg_reveal" id="bg_reveal"></div>
    <div class="contents-list" transition:name="title--words">
      <div class="contents_texto">
        <span class="content_label">言葉</span>
        <h2>WORDS</h2>
        <a href="/" class="back_btn" aria-label="戻る">
          <span class="back_arrow">←</span>
        </a>
      </div>
      <!-- ============ ここから追加：吹き出しセクション ============ -->
      <div class="words-canvas">
        <div class="stage" id="stage">
          <div class="intro">
            <span class="eyebrow">SPEECH BUBBLES</span>
            <p>
              まわりの吹き出しをクリックすると、寄せられた言葉をひとつずつ読むことができます。
            </p>
          </div>

          <div class="character" aria-hidden="true"></div>

          <!-- 吹き出し：data-modal は下の wordsData のキーと対応させてください -->
          <div class="bubble-wrap dir-b" style="--angle: -140deg; --delay: 0s;">
            <button class="bubble" data-modal="w1"
              >スイミングしながら睡眠している時、それはまだスイミングなんじゃないだろうか</button
            >
          </div>
          <div
            class="bubble-wrap dir-b"
            style="--angle: -95deg; --delay: .08s;"
          >
            <button class="bubble" data-modal="w2"
              >24時間回ってる扇風機、24時ファン</button
            >
          </div>
          <div
            class="bubble-wrap dir-b"
            style="--angle: -40deg; --delay: .16s;"
          >
            <button class="bubble" data-modal="w3"
              >疲れた町田ちま、たちまち寝落ちする</button
            >
          </div>
          <div class="bubble-wrap dir-t" style="--angle: 40deg; --delay: .24s;">
            <button class="bubble" data-modal="w4"
              >ダルめの騎士「今夜は貴方様をお守りしナイト…っとｗ」</button
            >
          </div>
          <div class="bubble-wrap dir-t" style="--angle: 95deg; --delay: .32s;">
            <button class="bubble" data-modal="w5"
              >わりと暇な悪魔「いつデーモンいけます」</button
            >
          </div>
          <div class="bubble-wrap dir-t" style="--angle: 140deg; --delay: .4s;">
            <button class="bubble" data-modal="w6"
              >あんまり納得できてない大富豪、イロン・マスク</button
            >
          </div>
        </div>
      </div>

      <div class="overlay" id="overlay">
        <div
          class="modal"
          role="dialog"
          aria-modal="true"
          aria-labelledby="modal-title"
        >
          <button class="close" id="closeBtn" aria-label="閉じる">✕</button>
          <span class="tag" id="modal-tag">MESSAGE</span>
          <h2 id="modal-title">TITLE</h2>
          <p id="modal-body">本文</p>
        </div>
      </div>
      <!-- ============ 追加ここまで ============ -->
    </div>

    <Footer />

    <style>
      * {
        margin: 0;
        padding: 0;
      }

      body {
        background-color: #fff;
        position: relative;
      }

      :root {
        --morph-duration: 0.6s;

        --header-back-color: rgb(181, 230, 198);

        --mint: #b5e6c6;
        --ink: #000000;
        --paper: #ffffff;
        --dot: rgba(120, 80, 200, 0.35);
        --canvas-w: 1900px;
        --radius-x: 640px;
        --radius-y: 300px;
      }

      ::view-transition-old(title--message),
      ::view-transition-new(title--message) {
        animation-duration: var(--morph-duration);
      }

      .bg_reveal {
        position: fixed;
        inset: 0;
        background: rgb(181, 230, 198);
        background-image: radial-gradient(
          circle,
          rgba(120, 80, 200, 0.35) 1px,
          transparent 1px
        );
        background-size: 5px 5px;
        z-index: -1;
        transform: scaleY(0);
        animation: revealBg 0.4s ease forwards;
        /* transform-origin はJSで動的に設定するため、ここでは指定しない */
      }

      @keyframes revealBg {
        from {
          transform: scaleY(0);
        }
        to {
          transform: scaleY(1);
        }
      }

      .contents-list {
        display: block;
        box-shadow:
          0 -1px 0 0 #000,
          0 1px 0 0 #000;
      }

      .contents_texto {
        box-shadow:
          0 -1px 0 0 #000,
          0 1px 0 0 #000;
        padding: 14px 16px 14px;
        white-space: nowrap;
        position: relative;
        display: flex; /* 追加 */
        align-items: center; /* h2とボタンを縦中央揃え */
        gap: 24px; /* h2とボタンの間隔 */
        background: #b5e6c6;
        z-index: 1;
      }

      .words-canvas {
        width: 1900px;
        margin: 0 auto;
        position: relative;
        background: #b5e6c6;
      }

      .stage {
        position: relative;
        width: 100%;
        height: 900px;
        background-size: 26px 26px;
        background-position: center;
        overflow: hidden;
        border-left: 1px solid #000;
        border-right: 1px solid #000;
      }

      .intro {
        position: absolute;
        top: 56px;
        left: 64px;
        max-width: 380px;
      }
      .intro .eyebrow {
        font-family: "Zen Kaku Gothic New", sans-serif;
        font-weight: 800;
        font-size: 13px;
        letter-spacing: 0.06em;
        display: inline-block;
        background: #b5e6c6;
        border: 2px solid #000;
        padding: 4px 12px;
        margin-bottom: 14px;
      }
      .intro p {
        font-family: "Noto Sans JP", sans-serif;
        font-size: 14px;
        line-height: 2;
        color: #333;
      }

      .character {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 220px;
        z-index: 3;
        animation: breathe 6s ease-in-out infinite;
        transform-origin: center;
      }
      @keyframes breathe {
        0%,
        100% {
          transform: translate(-50%, -50%) scale(1);
        }
        50% {
          transform: translate(-50%, -50%) scale(1.02);
        }
      }

      .bubble-wrap {
        --radius-x: 640px;
        --radius-y: 300px;
        position: absolute;
        top: calc(50% + var(--radius-y) * sin(var(--angle)));
        left: calc(50% + var(--radius-x) * cos(var(--angle)));
        transform: translate(-50%, -50%);
        opacity: 0;
        animation: fadeIn 0.5s ease forwards;
        animation-delay: var(--delay);
        z-index: 2;
      }
      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translate(-50%, -50%) scale(0.9);
        }
        to {
          opacity: 1;
          transform: translate(-50%, -50%) scale(1);
        }
      }

      .bubble {
        position: relative;
        display: block;
        width: 500px;
        background: #fff;
        color: #000;
        font-family: "Zen Kaku Gothic New", sans-serif;
        font-weight: 700;
        font-size: 14px;
        line-height: 1.6;
        padding: 16px 18px;
        border: 2px solid #000;
        border-radius: 18px;
        cursor: pointer;
        text-align: left;
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease,
          background 0.2s ease;
      }
      .bubble:hover,
      .bubble:focus-visible {
        transform: translateY(-4px);
        box-shadow: 4px 6px 0 0 #000;
        background: #b5e6c6;
        outline: none;
      }

      .bubble::before,
      .bubble::after {
        content: "";
        position: absolute;
        width: 0;
        height: 0;
      }
      .bubble::before {
        border-style: solid;
      }
      .bubble::after {
        border-style: solid;
      }

      /* 吹き出しが上にある → キャラは下 → しっぽは下向き */
      .dir-b .bubble::before {
        bottom: -14px;
        left: 50%;
        margin-left: -13px;
        border-width: 14px 13px 0 13px;
        border-color: #000 transparent transparent transparent;
      }
      .dir-b .bubble::after {
        bottom: -10.5px;
        left: 50%;
        margin-left: -10px;
        border-width: 11px 10px 0 10px;
        border-color: var(--paper) transparent transparent transparent;
      }
      .dir-b .bubble:hover::after {
        border-top-color: var(--mint);
      }

      /* 吹き出しが下にある → キャラは上 → しっぽは上向き */
      .dir-t .bubble::before {
        top: -14px;
        left: 50%;
        margin-left: -13px;
        border-width: 0 13px 14px 13px;
        border-color: transparent transparent #000 transparent;
      }
      .dir-t .bubble::after {
        top: -10.5px;
        left: 50%;
        margin-left: -10px;
        border-width: 0 10px 11px 10px;
        border-color: transparent transparent var(--paper) transparent;
      }
      .dir-t .bubble:hover::after {
        border-bottom-color: var(--mint);
      }

      .overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease;
        z-index: 10;
      }
      .overlay.open {
        opacity: 1;
        pointer-events: auto;
      }

      .modal {
        background: #fff;
        color: #000;
        width: min(480px, 100%);
        border: 3px solid #000;
        padding: 36px 32px 32px;
        position: relative;
        transform: translateY(10px);
        opacity: 0;
        transition:
          transform 0.25s ease,
          opacity 0.25s ease;
      }
      .overlay.open .modal {
        transform: translateY(0);
        opacity: 1;
      }

      .modal .tag {
        display: inline-block;
        font-family: "Zen Kaku Gothic New", sans-serif;
        font-weight: 800;
        font-size: 12px;
        background: #b5e6c6;
        border: 2px solid #000;
        padding: 4px 12px;
        margin-bottom: 16px;
      }
      .modal h2 {
        font-family: "Bebas Neue", sans-serif;
        font-size: 42px;
        letter-spacing: 0.01em;
        margin: 0 0 16px;
        line-height: 1;
      }
      .modal p {
        font-family: "Noto Sans JP", sans-serif;
        font-size: 14.5px;
        line-height: 2;
        color: #222;
      }
      .modal .close {
        position: absolute;
        top: 18px;
        right: 18px;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 2px solid #000;
        background: #fff;
        color: #000;
        font-size: 15px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition:
          background 0.2s,
          color 0.2s;
      }
      .modal .close:hover {
        background: #000;
        color: #b5e6c6;
      }

      @media (prefers-reduced-motion: reduce) {
        .character,
        .bubble-wrap {
          animation: none !important;
          opacity: 1 !important;
        }
      }

      .board-wrap {
        width: 100%;
        max-width: 1900px;
        margin: 0px auto;
        border-left: 1px solid #000;
        border-right: 1px solid #000;
        margin-top: -1px;
      }

      #board-wrap {
        opacity: 0;
        animation: fadeInContent 0.4s ease forwards;
        animation-delay: 0.6s; /* モーフィングの再生時間と合わせる */
      }

      @keyframes fadeInContent {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }

      .board {
        position: relative; /* ← 付箋の absolute 配置の基準点 */
        width: 100%;
        height: 1200px; /* ← 高さが必須！ないと付箋が見えない */
        background: rgb(181, 230, 198);
        overflow: hidden;
        margin: auto;
        z-index: -1;
      }

      .content_label {
        position: absolute;
        top: 14px;
        right: 16px;
        font-size: 15px;
        color: #000;
        font-family: "Zen Kaku Gothic New", sans-serif;
        font-weight: 800;
        padding: 6px 14px;
      }

      .contents_texto h2 {
        font-size: 110px;
        font-family: "acumin-variable", sans-serif;
        font-variation-settings:
          "wght" 400,
          "wdth" 100,
          "slnt" 0;
        font-style: normal;
        align-items: center;
        line-height: 1;
        letter-spacing: -0.06em;
        position: relative;
      }

      .back_btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        border: 2px solid #000;
        border-radius: 50%;
        text-decoration: none;
        color: #000;
        flex-shrink: 0; /* ボタンが縮まないようにする */
        transition:
          background 0.2s,
          color 0.2s;
      }

      .back_btn:hover {
        background: #000;
        color: #b5e6c6;
      }

      .back_arrow {
        font-size: 20px;
        line-height: 1;
      }

      /* ==================== スマホ対応 ==================== */
      @media (max-width: 768px) {
        .contents_texto {
          padding: 10px 12px;
          gap: 12px;
          white-space: normal;
          overflow: hidden;
        }

        .contents_texto h2 {
          flex: 1 1 0%;
          min-width: 0;
          font-size: 15vw;
          overflow-x: hidden;
          overflow-y: hidden;
          white-space: nowrap;
          -webkit-overflow-scrolling: touch;
          scrollbar-width: none;
          font-size: 15vw;
        }

        .content_label {
          top: 10px;
          right: 66px;
          max-width: 100px;
          box-sizing: border-box;
          overflow-x: hidden;
          white-space: nowrap;
          font-size: 11px;
          padding: 4px 8px;
        }

        .back_btn {
          width: 40px;
          height: 40px;
        }

        .back_arrow {
          font-size: 16px;
        }

        .chronology {
          max-width: 50vh;
          margin: 0 10px;
        }

        .chronology_title {
          padding: 16px 1em;
        }
        .chronology_subtitle {
          font-size: 20px;
          letter-spacing: 0.2em;
          margin: 0 0 2px 0;
        }
        .chronology_title h4 {
          font-size: 13vw;
        }
        .chronology_date {
          font-size: 15px;
        }

        :global(.timeline-wrap) {
          padding: 32px 16px;
          margin-bottom: 60px;
        }

        :global(.timeline-line) {
          left: 8px;
        }

        :global(.marker-col) {
          width: 16px;
          flex: 0 0 16px;
        }

        :global(.marker-circle) {
          width: 14px;
          height: 14px;
          border-width: 2px;
        }

        :global(.content-col) {
          padding-left: 16px;
          gap: 20px;
        }

        :global(.item-year) {
          font-size: 12px;
        }

        :global(.item-title) {
          font-size: 17px;
          padding-bottom: 8px;
        }

        :global(.item-desc) {
          font-size: 13px;
          line-height: 1.8;
        }

        :global(.item-comment) {
          font-size: 12px;
          padding: 8px 12px;
        }

        :global(.like-btn) {
          font-size: 12px;
          padding: 5px 12px;
        }

        :global(.item-youtube) {
          border-radius: 6px;
        }

        :global(.yt-play-btn) {
          width: 52px;
          height: 36px;
        }
      }
    </style>

    <script>
      // 吹き出しごとの中身：実際の言葉に差し替えてください
      const wordsData: Record<
        string,
        { tag: string; title: string; body: string }
      > = {
        w1: {
          tag: "MESSAGE 01",
          title:
            "スイミングしながら睡眠している時、それはまだスイミングなんじゃないだろうか",
          body: "ここに実際に寄せられた言葉本文を入れます。長さは自由に調整できます。",
        },
        w2: {
          tag: "MESSAGE 02",
          title: "24時間回ってる扇風機、24時ファン",
          body: "ここに実際に寄せられた言葉本文を入れます。",
        },
        w3: {
          tag: "MESSAGE 03",
          title: "疲れた町田ちま、たちまち寝落ちする",
          body: "ここに実際に寄せられた言葉本文を入れます。",
        },
        w4: {
          tag: "MESSAGE 04",
          title: "ダルめの騎士「今夜は貴方様をお守りしナイト…っとｗ」",
          body: "ここに実際に寄せられた言葉本文を入れます。",
        },
        w5: {
          tag: "MESSAGE 05",
          title: "わりと暇な悪魔「いつデーモンいけます」",
          body: "ここに実際に寄せられた言葉本文を入れます。",
        },
        w6: {
          tag: "MESSAGE 06",
          title: "あんまり納得できてない大富豪、イロン・マスク",
          body: "ここに実際に寄せられた言葉本文を入れます。",
        },
      };

      const overlay = document.getElementById("overlay")!;
      const closeBtn = document.getElementById("closeBtn")!;
      let lastFocused: HTMLElement | null = null;

      document.querySelectorAll<HTMLButtonElement>(".bubble").forEach((btn) => {
        btn.addEventListener("click", () => {
          const key = btn.dataset.modal!;
          const d = wordsData[key];
          document.getElementById("modal-tag")!.textContent = d.tag;
          document.getElementById("modal-title")!.textContent = d.title;
          document.getElementById("modal-body")!.textContent = d.body;
          lastFocused = document.activeElement as HTMLElement;
          overlay.classList.add("open");
          closeBtn.focus();
        });
      });

      function closeModal() {
        overlay.classList.remove("open");
        lastFocused?.focus();
      }
      closeBtn.addEventListener("click", closeModal);
      overlay.addEventListener("click", (e) => {
        if (e.target === overlay) closeModal();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeModal();
      });
    </script>
  </body>
</BaseLayout>
