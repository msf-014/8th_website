    const MIN_GAP = 22;
    const EDGE_MARGIN = 40;

    function initWordsPage() {
      const stage = document.getElementById("stage");
      const character = document.getElementById("character");
      if (!stage || !character) return;

      if (stage.dataset.wordsInit === "true") return;
      stage.dataset.wordsInit = "true";
      const isMobile = () => window.matchMedia("(max-width: 768px)").matches;

      type Rect = { left: number; top: number; right: number; bottom: number };
      const hits = (a: Rect, b: Rect) =>
        a.left < b.right &&
        a.right > b.left &&
        a.top < b.bottom &&
        a.bottom > b.top;
      const rectOf = (el: Element, pad: number, base: DOMRect): Rect => {
        const b = el.getBoundingClientRect();
        return {
          left: b.left - base.left - pad,
          top: b.top - base.top - pad,
          right: b.right - base.left + pad,
          bottom: b.bottom - base.top + pad,
        };
      };

      // 枠は固定サイズなので、全部は置けない。重ならずに置ける分だけ表示し、
      // 「他の言葉を見る」で残りと入れ替える。queue は「まだ表示していない言葉」
      let activeTag = "ALL";
      let queue: typeof messages = [];
      const shuffleBtn = document.getElementById("shuffleBtn");

      function poolFor(tag: string) {
        return messages.filter((m) => tag === "ALL" || m.tag === tag);
      }

      function layoutBubbles() {
        const mobile = isMobile();
        const stageW = stage.clientWidth;
        const stageH = stage.clientHeight;
        const gap = mobile ? 6 : MIN_GAP;
        const edge = mobile ? 10 : EDGE_MARGIN;
        const PAD = mobile ? 6 : 28;

        stage.querySelectorAll(".bubble-wrap").forEach((n) => n.remove());

        const stageBox = stage.getBoundingClientRect();
        const introEl = stage.querySelector(".intro");

        // スマホは intro が枠の最下部に固定されているので、キャラは枠全体ではなく
        // 「intro より上の吹き出しエリア」の中央に置く(PC は CSS の 50% のまま)
        character.style.top = "";
        if (mobile && introEl) {
          const introTop = introEl.getBoundingClientRect().top - stageBox.top;
          character.style.top = introTop / 2 + "px";
        }

        const obstacles: Rect[] = [rectOf(character, PAD, stageBox)];
        const imgBox = (
          character.querySelector("img") || character
        ).getBoundingClientRect();
        const charCenter = {
          x: imgBox.left - stageBox.left + imgBox.width / 2,
          y: imgBox.top - stageBox.top + imgBox.height / 2,
        };
        if (introEl) obstacles.push(rectOf(introEl, PAD, stageBox));

        // 未表示のものを優先し、足りなければ表示済みからも補って枠を埋める
        const pool = poolFor(activeTag);
        if (queue.length === 0) queue = pool.slice();
        const order = [...queue, ...pool.filter((m) => !queue.includes(m))];

        // 置き場所の候補は枠内の格子点。乱数で順番を崩し、置けるところを先頭から探す
        // (完全な乱数だと狭い枠で置ける場所を見落として早く諦めてしまう)
        const STEP = 8;
        const grid: { left: number; top: number }[] = [];
        for (let top = edge; top <= stageH - edge; top += STEP) {
          for (let left = edge; left <= stageW - edge; left += STEP) {
            grid.push({ left, top });
          }
        }
        for (let i = grid.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [grid[i], grid[j]] = [grid[j], grid[i]];
        }
        const placed: { box: Rect; text: Rect; tail: Rect }[] = [];
        const shown: typeof messages = [];
        let misses = 0;
        const TAIL = 14;

        for (const msg of order) {
          // PC は数個続けて置けなければ満杯とみなす。スマホは小さい吹き出しなら
          // 隙間に入ることが多いので、最後まで試す
          if (!mobile && misses >= 4) break;

          const wrap = document.createElement("div");
          wrap.className = "bubble-wrap";
          wrap.dataset.name = msg.tag || "UNKNOWN";
          wrap.style.visibility = "hidden";
          const btn = document.createElement("button");
          btn.className = "bubble";
          btn.dataset.modal = msg.id;
          btn.innerHTML = msg.bubble;
          // 幅を少し揺らして折り返しを変え、箱の形をバラけさせる(整いすぎ防止)
          // スマホは下限を 100px にしてキャラの両脇(約 100px)にも入るようにする
          const bw = mobile
            ? 100 + Math.random() * 44
            : 200 * (0.85 + Math.random() * 0.3);
          btn.style.width = Math.round(bw) + "px";
          wrap.appendChild(btn);
          stage.appendChild(wrap);

          // ポップアニメーションの scale の影響を受けない offset 値で測る
          // しっぽは上下どちらか一方にしか出ないが、向きは位置が決まるまで分からない
          // ので両側に確保する。スマホは隙間が貴重なので片側+αに抑える
          const w = btn.offsetWidth;
          const btnH = btn.offsetHeight;
          const h = btnH + (mobile ? TAIL + 4 : TAIL * 2);
          const maxLeft = stageW - edge - w;
          const maxTop = stageH - edge - h;
          // 文字領域 = 箱から padding を除いた内側。箱同士は少し重なってもよいが、
          // 相手の箱がこの領域に乗ると読めなくなるので、それだけを禁止する
          const cs = getComputedStyle(btn);
          const padX = parseFloat(cs.paddingLeft);
          const padY = parseFloat(cs.paddingTop);
          const boxOf = (r: Rect): Rect => {
            const top = r.top + (h - btnH) / 2;
            return { left: r.left, top, right: r.right, bottom: top + btnH };
          };
          const textOf = (b: Rect): Rect => ({
            left: b.left + padX,
            top: b.top + padY,
            right: b.right - padX,
            bottom: b.bottom - padY,
          });
          // しっぽはキャラ(画像の中心)へ向ける。吹き出し中心からキャラ中心へ引いた
          // 直線が箱のどの辺を抜けるかで上下左右を決め、辺上の位置もその交点にする。
          // 戻り値の rect はしっぽの三角形が占める範囲(他の文字に乗せない判定用)
          const tailFor = (x: number, y: number, w: number, bh: number) => {
            const dx = charCenter.x - x;
            const dy = charCenter.y - y;
            const halfW = w / 2;
            const halfH = bh / 2;
            let dir: string;
            let tailX = 50;
            let tailY = 50;
            let rect: Rect;
            if (Math.abs(dx) * halfH > Math.abs(dy) * halfW) {
              dir = dx > 0 ? "dir-r" : "dir-l";
              const exitY = y + dy * (halfW / Math.abs(dx));
              tailY = Math.min(
                80,
                Math.max(20, ((exitY - (y - halfH)) / bh) * 100),
              );
              const ty = y - halfH + (bh * tailY) / 100;
              const ex = dx > 0 ? x + halfW : x - halfW - TAIL;
              rect = {
                left: ex,
                top: ty - TAIL,
                right: ex + TAIL,
                bottom: ty + TAIL,
              };
            } else {
              dir = dy > 0 ? "dir-b" : "dir-t";
              const exitX = dy === 0 ? x : x + dx * (halfH / Math.abs(dy));
              tailX = Math.min(
                85,
                Math.max(15, ((exitX - (x - halfW)) / w) * 100),
              );
              const tx = x - halfW + (w * tailX) / 100;
              const ey = dy > 0 ? y + halfH : y - halfH - TAIL;
              rect = {
                left: tx - TAIL,
                top: ey,
                right: tx + TAIL,
                bottom: ey + TAIL,
              };
            }
            return { dir, tailX, tailY, rect };
          };
          // 相手の箱・しっぽが自分の文字に、自分の箱・しっぽが相手の文字に乗らない
          const readable = (box: Rect, text: Rect, tail: Rect) =>
            placed.every(
              (p) =>
                !hits(box, p.text) &&
                !hits(tail, p.text) &&
                !hits(text, p.box) &&
                !hits(text, p.tail),
            );

          // 置ける候補の中から選ぶ。PC は空きに余裕があるので最初に見つかった場所(=乱数)。
          // スマホは面積が足りないので、周囲(枠の縁・キャラ・他の吹き出し)に
          // 接している数が多い候補を優先し、空きを細切れにしない。
          // 同点は格子の順(=乱数)なので散らばり方はランダムのまま
          let found: Rect | null = null;
          const candidates: { r: Rect; score: number }[] = [];
          let bestScore = -1;
          for (const g of grid) {
            if (g.left > maxLeft || g.top > maxTop) continue;
            const r = {
              left: g.left,
              top: g.top,
              right: g.left + w,
              bottom: g.top + h,
            };
            if (obstacles.some((o) => hits(r, o))) continue;
            const box = boxOf(r);
            const tail = tailFor(
              (r.left + r.right) / 2,
              (r.top + r.bottom) / 2,
              w,
              btnH,
            ).rect;
            if (!readable(box, textOf(box), tail)) continue;
            if (!mobile) {
              found = r;
              break;
            }
            const near = {
              left: r.left - gap - STEP,
              top: r.top - gap - STEP,
              right: r.right + gap + STEP,
              bottom: r.bottom + gap + STEP,
            };
            let score = 0;
            if (near.left <= edge) score++;
            if (near.right >= stageW - edge) score++;
            if (near.top <= edge) score++;
            if (near.bottom >= stageH - edge) score++;
            for (const o of obstacles) if (hits(near, o)) score++;
            for (const p of placed) if (hits(near, p.box)) score++;
            candidates.push({ r, score });
            if (score > bestScore) bestScore = score;
          }
          if (mobile && candidates.length > 0) {
            // 最高点だけだと行が揃って整いすぎるので、ほぼ最高点の中からランダムに選ぶ
            const good = candidates.filter((c) => c.score >= bestScore - 1);
            found = good[Math.floor(Math.random() * good.length)].r;
          }

          if (!found) {
            wrap.remove();
            misses++;
            continue;
          }

          {
            const box = boxOf(found);
            const tail = tailFor(
              (found.left + found.right) / 2,
              (found.top + found.bottom) / 2,
              w,
              btnH,
            ).rect;
            placed.push({ box, text: textOf(box), tail });
          }
          shown.push(msg);

          // 格子に揃いすぎないよう、隙間の範囲内で少しずらす
          // (傾き・ずらしで文字領域に食い込まないよう、小さめに)
          const jitter = 3;
          const x =
            (found.left + found.right) / 2 + (Math.random() - 0.5) * jitter;
          const y =
            (found.top + found.bottom) / 2 + (Math.random() - 0.5) * jitter;
          // 傾けると箱が測った矩形より少しはみ出すので、隙間の小さいスマホは控えめに
          const rot =
            ((Math.random() - 0.5) * (mobile ? 5 : 6)).toFixed(1) + "deg";
          const { dir, tailX, tailY } = tailFor(x, y, w, btnH);

          wrap.classList.add(dir);
          wrap.style.left = x + "px";
          wrap.style.top = y + "px";
          wrap.style.visibility = "visible";
          wrap.style.setProperty("--tail-x", tailX + "%");
          wrap.style.setProperty("--tail-y", tailY + "%");
          wrap.style.setProperty("--rot", rot);
          wrap.style.setProperty("--delay", (shown.length - 1) * 0.06 + "s");
        }

        queue = queue.filter((m) => !shown.includes(m));

        // 全部が一度に収まる時だけボタンを隠す。display を消すと intro パネルの
        // 高さが変わり、測った除外エリアとずれて吹き出しが隠れるので visibility で消す
        if (shuffleBtn) {
          shuffleBtn.style.visibility =
            shown.length >= pool.length ? "hidden" : "";
          shuffleBtn.textContent = `他の言葉を見る (${shown.length}/${pool.length})`;
        }
      }

      // --- ボタンコンテナ(HTML 側に用意済み) ---
      const buttonsContainer = document.getElementById("buttons");
      if (!buttonsContainer) return;

      const tagSet = new Set(
        (messages || []).map((m) => (m.tag || "UNKNOWN").trim()),
      );
      const tags = ["ALL", ...Array.from(tagSet)];

      function createTagButtons(tags: string[]) {
        buttonsContainer.innerHTML = "";
        tags.forEach((tag, idx) => {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "button";
          btn.dataset.name = tag;
          btn.textContent = tag;
          if (idx === 0) btn.classList.add("active");
          buttonsContainer.appendChild(btn);
        });
      }

      function onButtonsClick(e: Event) {
        const btn = (e.target as Element).closest(
          ".button",
        ) as HTMLElement | null;
        if (!btn || !buttonsContainer.contains(btn)) return;
        buttonsContainer
          .querySelector(".button.active")
          ?.classList.remove("active");
        btn.classList.add("active");
        activeTag = btn.dataset.name || "ALL";
        queue = [];
        layoutBubbles();
      }
      buttonsContainer.addEventListener("click", onButtonsClick);

      shuffleBtn?.addEventListener("click", () => layoutBubbles());

      // --- 実行フロー（フォント待ち→ボタン生成→配置） ---
      // ボタンを先に作り、ボタン込みの intro の大きさを測ってから吹き出しを避けて配置する。
      // Webフォントの読み込み前に測ると、後でフォントが差し替わって箱のサイズが変わる
      const run = () => {
        createTagButtons(tags);
        layoutBubbles();
      };

      // キャラ画像の読み込み前に測ると箱が小さく、画像の上に吹き出しが置かれてしまう
      const charImg = character.querySelector("img");
      const imgReady =
        charImg && !charImg.complete
          ? new Promise<void>((resolve) => {
              charImg.addEventListener("load", () => resolve(), { once: true });
              charImg.addEventListener("error", () => resolve(), {
                once: true,
              });
            })
          : Promise.resolve();
      const fontsReady =
        document.fonts && document.fonts.status !== "loaded"
          ? document.fonts.ready
          : Promise.resolve();
      Promise.all([fontsReady, imgReady]).then(run);

      // 幅が変わった時(回転・ウィンドウリサイズ)だけ並べ直す。
      // スマホのアドレスバー伸縮は高さしか変えないので無視される
      let lastWidth = window.innerWidth;
      let resizeTimer: ReturnType<typeof setTimeout> | undefined;
      window.addEventListener("resize", () => {
        if (window.innerWidth === lastWidth) return;
        lastWidth = window.innerWidth;
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          queue = [];
          layoutBubbles();
        }, 150);
      });

      // ===== モーダル =====
      const content = Object.fromEntries(messages.map((m) => [m.id, m]));
      const overlay = document.getElementById("overlay");
      const closeBtn = document.getElementById("closeBtn");
      const sourceLink = document.getElementById(
        "modal-source",
      ) as HTMLAnchorElement | null;
      const shareBtn = document.getElementById("modal-share");
      let lastFocused: HTMLElement | null = null;
      let currentMessage: (typeof messages)[number] | null = null;

      stage.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest(
          ".bubble",
        ) as HTMLButtonElement | null;
        if (!btn) return;
        const d = content[btn.dataset.modal!];
        currentMessage = d;
        document.getElementById("modal-tag")!.textContent = d.tag;
        document.getElementById("modal-title")!.textContent = d.title;
        document.getElementById("modal-body")!.textContent = d.body;

        // 引用元リンク:sourceUrl が無ければボタンごと隠す
        if (sourceLink) {
          if (d.sourceUrl) {
            sourceLink.href = d.sourceUrl;
            sourceLink.dataset.empty = "false";
          } else {
            sourceLink.removeAttribute("href");
            sourceLink.dataset.empty = "true";
          }
        }

        lastFocused = document.activeElement as HTMLElement;
        overlay!.classList.add("open");
        closeBtn!.focus();
      });

      // Xでシェア:本文の言葉+このページのURLを添えて投稿画面を開く
      const SHARE_HASHTAGS = ["矢車りね8周年", "大矢車様のお言葉"];

      shareBtn?.addEventListener("click", () => {
        if (!currentMessage) return;
        const hashtagLine = SHARE_HASHTAGS.map((t) => "#" + t).join(" ");
        const shareUrl = new URL(location.href).toString();
        const composed = [currentMessage.title, hashtagLine, shareUrl].join(
          "\n",
        );
        const intentUrl =
          "https://twitter.com/intent/tweet?text=" +
          encodeURIComponent(composed);
        window.open(intentUrl, "_blank", "noopener,noreferrer");
      });

      function closeModal() {
        overlay!.classList.remove("open");
        lastFocused?.focus();
      }
      closeBtn!.addEventListener("click", closeModal);
      overlay!.addEventListener("click", (e) => {
        if (e.target === overlay) closeModal();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeModal();
      });
    }

    // 通常の読み込みに対応
    initWordsPage();
    // View Transitionsでの遷移(このサイトで実際に発火するかは環境依存)にも対応。
    // 上のガードにより、両方発火しても実行は1回だけになる
    document.addEventListener("astro:page-load", initWordsPage);
  </script>
</BaseLayout>
