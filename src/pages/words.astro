---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/header.astro";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/footer.astro";
import PageBackground from "../components/PageBackground.astro";
import PageHeader from "../components/PageHeader.astro";
import PageFrame from "../components/PageFrame.astro";
---

<BaseLayout>
  <body>
    <PageBackground />
    <div class="contents-list">
      <PageHeader title="WORDS" label="言葉" transitionName="title--words" />
    </div>

    <!-- words-canvas は contents-list の外(兄弟要素)にする -->
    <div class="words-canvas">
      <PageFrame class="stage" id="stage">
        <div class="intro">
          <span class="eyebrow">YAGURUMA WORDS</span>
          <p>
            大矢車様のありがたいお言葉を集めました。<br
            />吹き出しをクリックすると、詳細を読むことが出来ます。<br />
            下のボタンで絞り込むことも出来ます。
          </p>
          <div class="buttons" id="buttons"></div>
          <button type="button" class="button shuffle" id="shuffleBtn">
            他の言葉を見る
          </button>
        </div>

        <div class="character" id="character" aria-hidden="true">
          <img class="character_img" src="/icon_1.png" />
          <p>大矢車様</p>
        </div>
      </PageFrame>
    </div>

    <div class="overlay" id="overlay">
      <div
        class="modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="modal-title"
      >
        <button class="close" id="closeBtn" aria-label="閉じる">✕</button>
        <span class="tag" id="modal-tag">MESSAGE</span>
        <h2 id="modal-title">TITLE</h2>
        <p id="modal-body">本文</p>
        <div class="modal-actions">
          <a
            id="modal-source"
            class="modal-btn"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
          >
            引用元を見る ↗
          </a>
          <button
            id="modal-share"
            class="modal-btn modal-btn--share"
            type="button"
          >
            Xでシェア
          </button>
        </div>
      </div>
    </div>
  </body>

  <Footer />

  <style>
    * {
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #fff;
      position: relative;
    }

    :root {
      --morph-duration: 0.6s;

      --page-color: #b5e6c6;

      --header-back-color: var(--page-color);

      --mint: #b5e6c6;
      --ink: #000000;
      --paper: #ffffff;
      --dot: rgba(120, 80, 200, 0.35);
      --canvas-w: 1900px;
    }

    ::view-transition-old(title--message),
    ::view-transition-new(title--message) {
      animation-duration: var(--morph-duration);
    }

    .contents-list {
      display: block;
    }

    .stage {
      position: relative;
      height: 1022px;
      background-size: 26px 26px;
      background-position: center;
      overflow: hidden;
    }

    .intro {
      position: absolute;
      top: 56px;
      left: 64px;
      max-width: 380px;
      z-index: 4;
    }
    .intro .eyebrow {
      font-family: "Zen Kaku Gothic New", sans-serif;
      font-weight: 500;
      font-size: 13px;
      letter-spacing: 0.06em;
      display: inline-block;
      background: #b5e6c6;
      border: 1px solid #000;
      padding: 4px 12px;
      margin-bottom: 14px;
    }
    .intro p {
      font-family: "Noto Sans JP", sans-serif;
      font-size: 13px;
      line-height: 2;
      color: #333;
      padding: 4px 12px;
      border: 1px solid #000;
      background: #b5e6c6;
    }

    :global(.buttons) {
      display: flex;
      align-items: center;
    }

    :global(.button) {
      font-family: "Zen Kaku Gothic New", sans-serif;
      font-weight: 600;
      padding: 3px 8px;
      border: 1px solid #000;
      cursor: pointer;
      margin: 10px 2px;
      color: #000;
      background-color: #b5e6c6;
      font-size: 13px;
    }

    :global(.button:hover) {
      color: #b5e6c6;
      background-color: #000;
      transition:
        background 0.2s,
        color 0.2s;
    }

    .shuffle {
      display: block;
      margin-top: 2px;
      background: #000;
      color: #b5e6c6;
    }
    .shuffle:hover {
      background: #fff;
      color: #000;
    }

    :global(.button.active) {
      color: #b5e6c6;
      background-color: #000;
      transition:
        background 0.2s,
        color 0.2s;
    }

    .character {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 220px;
      z-index: 3;
      transform-origin: center;
    }

    .character img {
      display: block;
      width: 80%;
      margin: 0 auto;
      border: 1px solid #000;
      border-radius: 100%;
    }

    .character p {
      display: flex;
      justify-content: center;
      font-family: "Zen Kaku Gothic New", sans-serif;
      margin-top: 8px;
    }

    /* ===== 吹き出し(JSで位置を決定・その場でポップする軌道) =====
         JSで document.createElement する要素は Astro のスコープ属性が
         付かないため、対応するCSSは :global() でスコープ対象外にする */
    :global(.bubble-wrap) {
      position: absolute;
      z-index: 2;
      /* left/top は吹き出しの中心。アニメーションが無効でも中心基準を保つ。
         --rot は JS が付ける微妙な傾き(ごちゃっと感) */
      transform: translate(-50%, -50%) rotate(var(--rot, 0deg));
      opacity: 0;
      animation: popOut 0.55s cubic-bezier(0.25, 0.9, 0.35, 1.15) forwards;
      animation-delay: var(--delay, 0s);
    }

    :global(.bubble-wrap:hover) {
      z-index: 50;
    }

    @keyframes popOut {
      0% {
        transform: translate(-50%, -50%) rotate(var(--rot, 0deg)) scale(0.2);
        opacity: 0;
      }
      60% {
        transform: translate(-50%, -50%) rotate(var(--rot, 0deg)) scale(1.08);
        opacity: 1;
      }
      100% {
        transform: translate(-50%, -50%) rotate(var(--rot, 0deg)) scale(1);
        opacity: 1;
      }
    }

    :global(.bubble) {
      position: relative;
      display: block;
      width: 200px;
      background: var(--paper);
      color: var(--ink);
      font-family: "Montserrat", "Zen Kaku Gothic New", sans-serif;
      font-weight: 500;
      font-size: 14px;
      line-height: 1.6;
      padding: 16px 18px;
      border: 1px solid #000;
      border-radius: 14px;
      cursor: pointer;
      text-align: left;
      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        background 0.2s ease;
    }
    :global(.bubble:hover),
    :global(.bubble:focus-visible) {
      transform: translateY(-3px);
      box-shadow: 4px 5px 0 0 #000;
      background: var(--mint);
      outline: none;
    }

    /* しっぽ:上下のみ判定、辺の中の位置は --tail-x で調整 */
    :global(.bubble::before),
    :global(.bubble::after) {
      content: "";
      position: absolute;
      width: 0;
      height: 0;
      border-style: solid;
    }

    :global(.bubble::after) {
      /* 本体(.bubble)のホバー時の色変化(0.2s)とタイミングを揃える */
      transition: border-color 0.2s ease;
    }

    :global(.dir-b .bubble::before) {
      bottom: -13px;
      left: var(--tail-x, 50%);
      margin-left: -10px;
      border-width: 13px 10px 0;
      border-color: #000 transparent transparent transparent;
    }
    :global(.dir-b .bubble::after) {
      bottom: -11px;
      left: var(--tail-x, 50%);
      margin-left: -12px;
      border-width: 17px 12px 0;
      border-color: var(--paper) transparent transparent transparent;
    }
    :global(.dir-b .bubble:hover::after) {
      border-top-color: var(--mint);
    }

    :global(.dir-t .bubble::before) {
      top: -13px;
      left: var(--tail-x, 50%);
      margin-left: -10px;
      border-width: 0 10px 13px;
      border-color: transparent transparent #000 transparent;
    }
    :global(.dir-t .bubble::after) {
      top: -11px;
      left: var(--tail-x, 50%);
      margin-left: -12px;
      border-width: 0 12px 17px;
      border-color: transparent transparent var(--paper) transparent;
    }

    /* 左右の辺の尻尾(キャラの横にある吹き出し用)。辺の中の位置は --tail-y */
    :global(.dir-r .bubble::before) {
      right: -13px;
      top: var(--tail-y, 50%);
      margin-top: -10px;
      border-width: 10px 0 10px 13px;
      border-color: transparent transparent transparent #000;
    }
    :global(.dir-r .bubble::after) {
      right: -11px;
      top: var(--tail-y, 50%);
      margin-top: -12px;
      border-width: 12px 0 12px 17px;
      border-color: transparent transparent transparent var(--paper);
    }
    :global(.dir-r .bubble:hover::after) {
      border-left-color: var(--mint);
    }
    :global(.dir-l .bubble::before) {
      left: -13px;
      top: var(--tail-y, 50%);
      margin-top: -10px;
      border-width: 10px 13px 10px 0;
      border-color: transparent #000 transparent transparent;
    }
    :global(.dir-l .bubble::after) {
      left: -11px;
      top: var(--tail-y, 50%);
      margin-top: -12px;
      border-width: 12px 17px 12px 0;
      border-color: transparent var(--paper) transparent transparent;
    }
    :global(.dir-l .bubble:hover::after) {
      border-right-color: var(--mint);
    }
    :global(.dir-t .bubble:hover::after) {
      border-bottom-color: var(--mint);
    }

    /* ===== モーダル ===== */
    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.45);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
      z-index: 10;
    }
    .overlay.open {
      opacity: 1;
      pointer-events: auto;
    }
    .modal {
      background: var(--paper);
      color: var(--ink);
      width: min(480px, 100%);
      border: 1px solid #000;
      padding: 36px 32px 32px;
      position: relative;
      transform: translateY(10px);
      opacity: 0;
      transition:
        transform 0.25s ease,
        opacity 0.25s ease;
    }
    .overlay.open .modal {
      transform: translateY(0);
      opacity: 1;
    }
    .modal .tag {
      display: inline-block;
      font-family: "Zen Kaku Gothic New", sans-serif;
      font-weight: 600;
      font-size: 12px;
      background: var(--mint);
      border: 1px solid #000;
      padding: 4px 12px;
      margin-bottom: 16px;
    }
    .modal h2 {
      font-family: "Zen Kaku Gothic New", sans-serif;
      font-weight: 500;
      font-size: 42px;
      letter-spacing: 0.01em;
      margin: 0 0 16px;
      line-height: 1;
    }
    .modal p {
      font-family: "Noto Sans JP", sans-serif;
      font-size: 14.5px;
      line-height: 2;
      color: #222;
    }

    .modal-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 24px;
    }
    .modal-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: "Zen Kaku Gothic New", sans-serif;
      font-weight: 500;
      font-size: 13px;
      text-decoration: none;
      color: #000;
      background: var(--paper);
      border: 1px solid #000;
      border-radius: 100px;
      padding: 9px 16px;
      cursor: pointer;
      transition:
        background 0.2s ease,
        color 0.2s ease,
        transform 0.2s ease;
    }
    .modal-btn:hover {
      background: var(--mint);
      transform: translateY(-2px);
    }
    .modal-btn--share {
      background: #000;
      color: #fff;
      border-color: #000;
    }
    .modal-btn--share:hover {
      background: var(--mint);
      color: #000;
    }
    /* sourceUrl が無いメッセージでは引用元リンクを非表示にする */
    .modal-btn[data-empty="true"] {
      display: none;
    }

    .modal .close {
      position: absolute;
      top: 18px;
      right: 18px;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 1px solid #000;
      background: var(--paper);
      color: #000;
      font-size: 15px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition:
        background 0.2s,
        color 0.2s;
    }
    .modal .close:hover {
      background: #000;
      color: var(--mint);
    }

    @media (prefers-reduced-motion: reduce) {
      .character {
        animation: none !important;
      }
      :global(.bubble-wrap) {
        animation: none !important;
        opacity: 1 !important;
      }
    }

    /* ==================== スマホ対応 ==================== */
    @media (max-width: 768px) {
      /* ===== ここから WORDS ボード(キャラ+吹き出し)のスマホ調整 ===== */

      /* 画面の残り高さいっぱいに枠を伸ばし、下部の説明・絞り込みボタンを
         フッターの真上に置く（タイトル帯の高さは画面幅で変わるため計算式にしない）。
         svh はアドレスバーの伸縮で変わらない */
      :global(body) {
        display: flex;
        flex-direction: column;
        min-height: 100svh;
      }
      .words-canvas {
        flex: 1 0 auto;
        display: flex;
        flex-direction: column;
      }
      .stage {
        flex: 1 0 auto;
        height: auto;
        min-height: 460px;
      }

      /* スマホは説明と絞り込みボタンを枠の下部いっぱいのパネルにする
         （吹き出しはこのパネルの実測位置を避けて配置される） */
      .intro {
        top: auto;
        bottom: 0;
        left: 0;
        right: 0;
        max-width: none;
        box-sizing: border-box;
        padding: 14px 16px 4px;
        background: var(--page-color);
        border-top: 1px solid #000;
      }
      .intro .eyebrow {
        font-size: 9px;
        padding: 3px 10px;
        margin-bottom: 8px;
      }
      .intro p {
        font-size: 10px;
        line-height: 1.7;
      }

      :global(.button) {
        font-size: 10px;
      }

      .character {
        width: 110px;
      }

      .character p {
        font-family: "Zen Kaku Gothic New", sans-serif;
        font-weight: 400;
      }

      :global(.bubble-wrap) {
        z-index: 0;
      }

      :global(.bubble-wrap:hover) {
        z-index: 1;
      }

      :global(.bubble) {
        width: 132px;
        font-size: 8px;
        line-height: 1.5;
        padding: 9px 14px;
        border-radius: 12px;
      }

      :global(.dir-b .bubble::before) {
        border-width: 9px 8px 0;
        margin-left: -5px;
        bottom: -10px;
        z-index: -1;
      }
      :global(.dir-b .bubble::after) {
        border-width: 12px 10px 0;
        margin-left: -7px;
        bottom: -9px;
      }
      :global(.dir-t .bubble::before) {
        border-width: 0 8px 9px;
        margin-left: -5px;
        top: -10px;
      }
      :global(.dir-t .bubble::after) {
        border-width: 0 10px 12px;
        margin-left: -7px;
        top: -9px;
      }
      :global(.dir-r .bubble::before) {
        border-width: 8px 0 8px 9px;
        margin-top: -8px;
        right: -10px;
      }
      :global(.dir-r .bubble::after) {
        border-width: 10px 0 10px 12px;
        margin-top: -10px;
        right: -9px;
      }
      :global(.dir-l .bubble::before) {
        border-width: 8px 9px 8px 0;
        margin-top: -8px;
        left: -10px;
      }
      :global(.dir-l .bubble::after) {
        border-width: 10px 12px 10px 0;
        margin-top: -10px;
        left: -9px;
      }

      .modal {
        padding: 28px 22px 22px;
      }
      .modal h2 {
        font-size: 30px;
      }
      .modal p {
        font-size: 13.5px;
      }
      /* ===== WORDS ボードのスマホ調整ここまで ===== */
    }
  </style>

