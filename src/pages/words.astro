      },
      {
        id: "w23",
        bubble: "肩　肩がすごく　硬い　肩だけに",
        tag: "SAYING",
        title: "肩　肩がすごく　硬い　肩だけに",
        body: "Xより",
        sourceUrl:
          "https://www.youtube.com/live/aZtxyrEu7p0?si=xfL7YuzYdKeCnzcj&t=105",
