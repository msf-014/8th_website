---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/header.astro";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/footer.astro";
---

<BaseLayout>
  <body>
    <div class="bg_reveal" id="bg_reveal"></div>

    <div class="contents-list" transition:name="title--words">
      <div class="contents_texto">
        <span class="content_label">言葉</span>
        <h2>WORDS</h2>
        <a href="/" class="back_btn" aria-label="戻る">
          <span class="back_arrow">←</span>
        </a>
      </div>
    </div>

    <!-- words-canvas は contents-list の外(兄弟要素)にする -->
    <div class="words-canvas">
      <div class="stage" id="stage">
        <div class="intro">
          <span class="eyebrow">YAGURUMA WORDS</span>
          <p>
            大矢車様のありがたいお言葉を集めました。<br
            />吹き出しをクリックすると、詳細を読むことが出来ます。
          </p>
        </div>

        <!-- 実際のキャラクター画像/イラストをここに入れてください(現状は空です) -->
        <div class="character" id="character" aria-hidden="true">
          <img class="character_img" src="/icon_1.png" />
          <p>大矢車様</p>
        </div>
      </div>
    </div>

    <div class="overlay" id="overlay">
      <div
        class="modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="modal-title"
      >
        <button class="close" id="closeBtn" aria-label="閉じる">✕</button>
        <span class="tag" id="modal-tag">MESSAGE</span>
        <h2 id="modal-title">TITLE</h2>
        <p id="modal-body">本文</p>
        <div class="modal-actions">
          <a
            id="modal-source"
            class="modal-btn"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
          >
            引用元を見る ↗
          </a>
          <button
            id="modal-share"
            class="modal-btn modal-btn--share"
            type="button"
          >
            Xでシェア
          </button>
        </div>
      </div>
    </div>
  </body>

  <Footer />

  <style>
    * {
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #fff;
      position: relative;
    }

    :root {
      --morph-duration: 0.6s;

      --header-back-color: rgb(181, 230, 198);

      --mint: #b5e6c6;
      --ink: #000000;
      --paper: #ffffff;
      --dot: rgba(120, 80, 200, 0.35);
      --canvas-w: 1900px;
    }

    ::view-transition-old(title--message),
    ::view-transition-new(title--message) {
      animation-duration: var(--morph-duration);
    }

    .bg_reveal {
      position: fixed;
      inset: 0;
      background: rgb(181, 230, 198);
      background-image: radial-gradient(
        circle,
        rgba(120, 80, 200, 0.35) 1px,
        transparent 1px
      );
      background-size: 5px 5px;
      z-index: -2;
      transform: scaleY(0);
      animation: revealBg 0.4s ease forwards;
      /* transform-origin はJSで動的に設定するため、ここでは指定しない */
    }

    @keyframes revealBg {
      from {
        transform: scaleY(0);
      }
      to {
        transform: scaleY(1);
      }
    }

    .contents-list {
      display: block;
      box-shadow:
        0 -1px 0 0 #000,
        0 1px 0 0 #000;
    }

    .contents_texto {
      box-shadow:
        0 -1px 0 0 #000,
        0 1px 0 0 #000;
      padding: 14px 16px 14px;
      white-space: nowrap;
      position: relative;
      display: flex;
      align-items: center;
      gap: 24px;
      background: #b5e6c6;
      z-index: 1;
    }

    .content_label {
      position: absolute;
      top: 14px;
      right: 16px;
      font-size: 15px;
      color: #000;
      font-family: "Zen Kaku Gothic New", sans-serif;
      font-weight: 800;
      padding: 6px 14px;
    }

    .contents_texto h2 {
      font-size: 110px;
      font-family: "acumin-variable", sans-serif;
      font-variation-settings:
        "wght" 400,
        "wdth" 100,
        "slnt" 0;
      font-style: normal;
      align-items: center;
      line-height: 1;
      letter-spacing: -0.06em;
      position: relative;
    }

    .back_btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 56px;
      height: 56px;
      border: 2px solid #000;
      border-radius: 50%;
      text-decoration: none;
      color: #000;
      flex-shrink: 0;
      transition:
        background 0.2s,
        color 0.2s;
    }

    .back_btn:hover {
      background: #000;
      color: #b5e6c6;
    }

    .back_arrow {
      font-size: 20px;
      line-height: 1;
    }

    .words-canvas {
      width: 1900px;
      margin: 0 auto;
      position: relative;
      background: #b5e6c6;
    }

    .stage {
      position: relative;
      width: 100%;
      height: 1200px;
      background-size: 26px 26px;
      background-position: center;
      overflow: hidden;
      border-left: 1px solid #000;
      border-right: 1px solid #000;
    }

    .intro {
      position: absolute;
      top: 56px;
      left: 64px;
      max-width: 380px;
    }
    .intro .eyebrow {
      font-family: "Zen Kaku Gothic New", sans-serif;
      font-weight: 800;
      font-size: 13px;
      letter-spacing: 0.06em;
      display: inline-block;
      background: #b5e6c6;
      border: 2px solid #000;
      padding: 4px 12px;
      margin-bottom: 14px;
    }
    .intro p {
      font-family: "Noto Sans JP", sans-serif;
      font-size: 14px;
      line-height: 2;
      color: #333;
    }

    .character {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 220px;
      z-index: 3;
      animation: breathe 6s ease-in-out infinite;
      transform-origin: center;
      margin: auto;
    }

    .character p {
      display: flex;
      justify-content: center;
    }

    .character img {
      width: 80%;
      border: 2px solid #000;
      border-radius: 100%;
    }

    @keyframes breathe {
      0%,
      100% {
        transform: translate(-50%, -50%) scale(1);
      }
      50% {
        transform: translate(-50%, -50%) scale(1.02);
      }
    }

    /* ===== 吹き出し(JSで位置を決定・その場でポップする軌道) =====
         JSで document.createElement する要素は Astro のスコープ属性が
         付かないため、対応するCSSは :global() でスコープ対象外にする */
    :global(.bubble-wrap) {
      position: absolute;
      z-index: 2;
      opacity: 0;
      animation: popOut 0.55s cubic-bezier(0.25, 0.9, 0.35, 1.15) forwards;
      animation-delay: var(--delay, 0s);
    }
    @keyframes popOut {
      0% {
        transform: translate(-50%, -50%) scale(0.2);
        opacity: 0;
      }
      60% {
        transform: translate(-50%, -50%) scale(1.08);
        opacity: 1;
      }
      100% {
        transform: translate(-50%, -50%) scale(1);
        opacity: 1;
      }
    }

    :global(.bubble) {
      position: relative;
      display: block;
      width: 200px;
      background: var(--paper);
      color: var(--ink);
      font-family: "Montserrat", "Zen Kaku Gothic New", sans-serif;
      font-weight: 700;
      font-size: 14px;
      line-height: 1.6;
      padding: 16px 18px;
      border: 2px solid #000;
      border-radius: 14px;
      cursor: pointer;
      text-align: left;
      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        background 0.2s ease;
    }
    :global(.bubble:hover),
    :global(.bubble:focus-visible) {
      transform: translateY(-3px);
      box-shadow: 4px 5px 0 0 #000;
      background: var(--mint);
      outline: none;
    }

    /* しっぽ:上下のみ判定、辺の中の位置は --tail-x で調整 */
    :global(.bubble::before),
    :global(.bubble::after) {
      content: "";
      position: absolute;
      width: 0;
      height: 0;
      border-style: solid;
    }

    :global(.dir-b .bubble::before) {
      bottom: -14px;
      left: var(--tail-x, 50%);
      margin-left: -13px;
      border-width: 14px 13px 0 13px;
      border-color: #000 transparent transparent transparent;
    }
    :global(.dir-b .bubble::after) {
      bottom: -10.5px;
      left: var(--tail-x, 50%);
      margin-left: -10px;
      border-width: 11px 10px 0 10px;
      border-color: var(--paper) transparent transparent transparent;
    }
    :global(.dir-b .bubble:hover::after) {
      border-top-color: var(--mint);
    }

    :global(.dir-t .bubble::before) {
      top: -14px;
      left: var(--tail-x, 50%);
      margin-left: -13px;
      border-width: 0 13px 14px 13px;
      border-color: transparent transparent #000 transparent;
    }
    :global(.dir-t .bubble::after) {
      top: -10.5px;
      left: var(--tail-x, 50%);
      margin-left: -10px;
      border-width: 0 10px 11px 10px;
      border-color: transparent transparent var(--paper) transparent;
    }
    :global(.dir-t .bubble:hover::after) {
      border-bottom-color: var(--mint);
    }

    /* ===== モーダル ===== */
    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.45);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
      z-index: 10;
    }
    .overlay.open {
      opacity: 1;
      pointer-events: auto;
    }
    .modal {
      background: var(--paper);
      color: var(--ink);
      width: min(480px, 100%);
      border: 3px solid #000;
      padding: 36px 32px 32px;
      position: relative;
      transform: translateY(10px);
      opacity: 0;
      transition:
        transform 0.25s ease,
        opacity 0.25s ease;
    }
    .overlay.open .modal {
      transform: translateY(0);
      opacity: 1;
    }
    .modal .tag {
      display: inline-block;
      font-family: "Zen Kaku Gothic New", sans-serif;
      font-weight: 800;
      font-size: 12px;
      background: var(--mint);
      border: 2px solid #000;
      padding: 4px 12px;
      margin-bottom: 16px;
    }
    .modal h2 {
      font-family: "Bebas Neue", sans-serif;
      font-size: 42px;
      letter-spacing: 0.01em;
      margin: 0 0 16px;
      line-height: 1;
    }
    .modal p {
      font-family: "Noto Sans JP", sans-serif;
      font-size: 14.5px;
      line-height: 2;
      color: #222;
    }

    .modal-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 24px;
    }
    .modal-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: "Zen Kaku Gothic New", sans-serif;
      font-weight: 700;
      font-size: 13px;
      text-decoration: none;
      color: #000;
      background: var(--paper);
      border: 2px solid #000;
      border-radius: 100px;
      padding: 9px 16px;
      cursor: pointer;
      transition:
        background 0.2s ease,
        color 0.2s ease,
        transform 0.2s ease;
    }
    .modal-btn:hover {
      background: var(--mint);
      transform: translateY(-2px);
    }
    .modal-btn--share {
      background: #000;
      color: #fff;
      border-color: #000;
    }
    .modal-btn--share:hover {
      background: var(--mint);
      color: #000;
    }
    /* sourceUrl が無いメッセージでは引用元リンクを非表示にする */
    .modal-btn[data-empty="true"] {
      display: none;
    }

    .modal .close {
      position: absolute;
      top: 18px;
      right: 18px;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 2px solid #000;
      background: var(--paper);
      color: #000;
      font-size: 15px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition:
        background 0.2s,
        color 0.2s;
    }
    .modal .close:hover {
      background: #000;
      color: var(--mint);
    }

    @media (prefers-reduced-motion: reduce) {
      .character {
        animation: none !important;
      }
      :global(.bubble-wrap) {
        animation: none !important;
        opacity: 1 !important;
      }
    }

    /* ==================== スマホ対応 ==================== */
    @media (max-width: 768px) {
      .contents_texto {
        padding: 10px 12px;
        gap: 12px;
        white-space: normal;
        overflow: hidden;
      }

      .contents_texto h2 {
        flex: 1 1 0%;
        min-width: 0;
        font-size: 15vw;
        overflow-x: hidden;
        overflow-y: hidden;
        white-space: nowrap;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        font-size: 15vw;
      }

      .content_label {
        top: 10px;
        right: 66px;
        max-width: 100px;
        box-sizing: border-box;
        overflow-x: hidden;
        white-space: nowrap;
        font-size: 11px;
        padding: 4px 8px;
      }

      .back_btn {
        width: 40px;
        height: 40px;
      }

      .back_arrow {
        font-size: 16px;
      }

      .chronology {
        max-width: 50vh;
        margin: 0 10px;
      }

      .chronology_title {
        padding: 16px 1em;
      }
      .chronology_subtitle {
        font-size: 20px;
        letter-spacing: 0.2em;
        margin: 0 0 2px 0;
      }
      .chronology_title h4 {
        font-size: 13vw;
      }
      .chronology_date {
        font-size: 15px;
      }

      :global(.timeline-wrap) {
        padding: 32px 16px;
        margin-bottom: 60px;
      }

      :global(.timeline-line) {
        left: 8px;
      }

      :global(.marker-col) {
        width: 16px;
        flex: 0 0 16px;
      }

      :global(.marker-circle) {
        width: 14px;
        height: 14px;
        border-width: 2px;
      }

      :global(.content-col) {
        padding-left: 16px;
        gap: 20px;
      }

      :global(.item-year) {
        font-size: 12px;
      }

      :global(.item-title) {
        font-size: 17px;
        padding-bottom: 8px;
      }

      :global(.item-desc) {
        font-size: 13px;
        line-height: 1.8;
      }

      :global(.item-comment) {
        font-size: 12px;
        padding: 8px 12px;
      }

      :global(.like-btn) {
        font-size: 12px;
        padding: 5px 12px;
      }

      :global(.item-youtube) {
        border-radius: 6px;
      }

      :global(.yt-play-btn) {
        width: 52px;
        height: 36px;
      }

      /* ===== ここから WORDS ボード(キャラ+吹き出し)のスマホ調整 ===== */
      .words-canvas {
        width: 100%;
      }

      .stage {
        height: 82vh;
      }

      .intro {
        top: 20px;
        left: 16px;
        max-width: calc(100% - 32px);
      }
      .intro .eyebrow {
        font-size: 11px;
        padding: 3px 10px;
        margin-bottom: 8px;
      }
      .intro p {
        font-size: 12px;
        line-height: 1.7;
      }

      .character {
        width: 140px;
      }

      :global(.bubble) {
        width: 132px;
        font-size: 12px;
        line-height: 1.5;
        padding: 12px 14px;
        border-radius: 12px;
      }

      :global(.dir-b .bubble::before) {
        border-width: 11px 10px 0 10px;
        margin-left: -10px;
        bottom: -11px;
      }
      :global(.dir-b .bubble::after) {
        border-width: 9px 8px 0 8px;
        margin-left: -8px;
        bottom: -8.5px;
      }
      :global(.dir-t .bubble::before) {
        border-width: 0 10px 11px 10px;
        margin-left: -10px;
        top: -11px;
      }
      :global(.dir-t .bubble::after) {
        border-width: 0 8px 9px 8px;
        margin-left: -8px;
        top: -8.5px;
      }

      .modal {
        padding: 28px 22px 22px;
      }
      .modal h2 {
        font-size: 30px;
      }
      .modal p {
        font-size: 13.5px;
      }
      /* ===== WORDS ボードのスマホ調整ここまで ===== */
    }
  </style>

  <script>
    // 吹き出しごとの中身：実際の言葉に差し替えてください

    import { title } from "process";

    // ここに項目を追加していけば、吹き出しの数はいくつでも増やせます
    const messages = [
      {
        id: "w1",
        bubble:
          "スイミングしながら睡眠している時、それはまだスイミングなんじゃないだろうか",
        tag: "DAJARE",
        title:
          "スイミングしながら睡眠している時、それはまだスイミングなんじゃないだろうか",
        body: "",
        sourceUrl: "https://x.com/i/status/1967896983102018040",
      },
      {
        id: "w2",
        bubble: "24時間回ってる扇風機、24時ファン",
        tag: "DAJARE",
        title: "24時間回ってる扇風機、24時ファン",
        body: "",
        sourceUrl: "https://x.com/i/status/1854727402947260600",
      },
      {
