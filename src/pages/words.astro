---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/header.astro";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/footer.astro";
---

<BaseLayout>
  <body>
    <div class="bg_reveal" id="bg_reveal"></div>
    <div class="contents-list" transition:name="title--words">
      <div class="contents_texto">
        <span class="content_label">言葉</span>
        <h2>WORDS</h2>
        <a href="/" class="back_btn" aria-label="戻る">
          <span class="back_arrow">←</span>
        </a>
      </div>
      <div class="words-canvas">
        <div class="stage" id="stage">
          <div class="intro">
            <span class="eyebrow">SPEECH BUBBLES</span>
            <p>
              まわりの吹き出しをクリックすると、寄せられた言葉をひとつずつ読むことができます。
            </p>
          </div>

          <div class="character" aria-hidden="true"></div>
        </div>

        <div class="overlay" id="overlay">
          <div
            class="modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="modal-title"
          >
            <button class="close" id="closeBtn" aria-label="閉じる">✕</button>
            <span class="tag" id="modal-tag">MESSAGE</span>
            <h2 id="modal-title">TITLE</h2>
            <p id="modal-body">本文</p>
          </div>
        </div>
      </div>
    </div>

    <script>
      // 吹き出しごとの中身：実際の言葉に差し替えてください
      const messages = [
        {
          id: "w1",
          bubble:
            "スイミングしながら睡眠している時、それはまだスイミングなんじゃないだろうか",
          tag: "DAJARE 01",
          title:
            "スイミングしながら睡眠している時、それはまだスイミングなんじゃないだろうか",
          body: "ここに実際に寄せられた言葉本文を入れます。長さは自由に調整できます。",
        },
        {
          id: "w2",
          bubble: "24時間回ってる扇風機、24時ファン",
          tag: "DAJARE 02",
          title: "24時間回ってる扇風機、24時ファン",
          body: "ここに実際に寄せられた言葉本文を入れます。",
        },
        {
          id: "w3",
          bubble: "疲れた町田ちま、たちまち寝落ちする",
          tag: "DAJARE 03",
          title: "疲れた町田ちま、たちまち寝落ちする",
          body: "ここに実際に寄せられた言葉本文を入れます。",
        },
        {
          id: "w4",
          bubble: "ダルめの騎士「今夜は貴方様をお守りしナイト…っとｗ」",
          tag: "DAJARE 04",
          title: "ダルめの騎士「今夜は貴方様をお守りしナイト…っとｗ」",
          body: "ここに実際に寄せられた言葉本文を入れます。",
        },
        {
          id: "w5",
          bubble: "わりと暇な悪魔「いつデーモンいけます」",
          tag: "DAJARE 05",
          title: "わりと暇な悪魔「いつデーモンいけます」",
          body: "ここに実際に寄せられた言葉本文を入れます。",
        },
        {
          id: "w6",
          bubble: "あんまり納得できてない大富豪、イロン・マスク",
          tag: "DAJARE 06",
          title: "あんまり納得できてない大富豪、イロン・マスク",
          body: "ここに実際に寄せられた言葉本文を入れます。",
        },
      ];

      const MIN_GAP = 22; // 吹き出し同士の最低間隔
      const EDGE_MARGIN = 24; // ボード端からの最低距離(しっぽ・影のはみ出し分含む)
      const MAX_ATTEMPTS = 400;

      // このページに来たとき(初回表示・View Transitionsでの遷移の両方)に実行する
      function initWordsPage() {
        const stage = document.getElementById("stage");
        if (!stage) return; // words ページ以外では何もしない
        const character = document.getElementById("character");
        if (!character) return;

        function layoutBubbles() {
          const stageRect = { w: stage.clientWidth, h: stage.clientHeight };
          const centerX = stageRect.w / 2;
          const centerY = stageRect.h / 2;

          const charEl = character.getBoundingClientRect();
          const exclusionRadius =
            Math.max(charEl.width, charEl.height, 220) / 2 + 90;

          const placed: { x: number; y: number; w: number; h: number }[] = [];

          messages.forEach((msg, i) => {
            const wrap = document.createElement("div");
            wrap.className = "bubble-wrap";
            wrap.style.visibility = "hidden";
            wrap.style.left = "0px";
            wrap.style.top = "0px";

            const btn = document.createElement("button");
            btn.className = "bubble";
            btn.dataset.modal = msg.id;
            btn.innerHTML = msg.bubble;

            wrap.appendChild(btn);
            stage.appendChild(wrap);

            const rect = btn.getBoundingClientRect();
            const w = rect.width + 32;
            const h = rect.height + 32;

            let x = 0,
              y = 0,
              ok = false;
            for (let a = 0; a < MAX_ATTEMPTS; a++) {
              x =
                EDGE_MARGIN +
                w / 2 +
                Math.random() * (stageRect.w - w - EDGE_MARGIN * 2);
              y =
                EDGE_MARGIN +
                h / 2 +
                Math.random() * (stageRect.h - h - EDGE_MARGIN * 2);

              const distFromCenter = Math.hypot(x - centerX, y - centerY);
              if (distFromCenter < exclusionRadius) continue;

              const overlaps = placed.some((p) => {
                return (
                  Math.abs(x - p.x) < (w + p.w) / 2 + MIN_GAP &&
                  Math.abs(y - p.y) < (h + p.h) / 2 + MIN_GAP
                );
              });
              if (overlaps) continue;

              ok = true;
              break;
            }
            if (!ok) {
              const angle = Math.random() * Math.PI * 2;
              x = centerX + Math.cos(angle) * (exclusionRadius + w / 2 + 20);
              y = centerY + Math.sin(angle) * (exclusionRadius + h / 2 + 20);
              x = Math.min(
                Math.max(x, EDGE_MARGIN + w / 2),
                stageRect.w - EDGE_MARGIN - w / 2,
              );
              y = Math.min(
                Math.max(y, EDGE_MARGIN + h / 2),
                stageRect.h - EDGE_MARGIN - h / 2,
              );
            }

            placed.push({ x, y, w, h });

            const dir = y < centerY ? "dir-b" : "dir-t";

            const norm = Math.max(
              -1,
              Math.min(1, (centerX - x) / (stageRect.w / 2)),
            );
            const tailX = 50 - norm * 30;
            const clampedTailX = Math.min(80, Math.max(20, tailX));

            const startRot = (Math.random() * 30 - 15).toFixed(1) + "deg";
            const finalRot = (Math.random() * 4 - 2).toFixed(1) + "deg";

            wrap.classList.add(dir);
            wrap.style.left = x + "px";
            wrap.style.top = y + "px";
            wrap.style.visibility = "visible";
            wrap.style.setProperty("--tail-x", clampedTailX + "%");
            wrap.style.setProperty("--start-rot", startRot);
            wrap.style.setProperty("--final-rot", finalRot);
            wrap.style.setProperty("--delay", i * 0.07 + "s");
          });
        }

        layoutBubbles();

        // ===== モーダル =====
        const content = Object.fromEntries(messages.map((m) => [m.id, m]));
        const overlay = document.getElementById("overlay");
        const closeBtn = document.getElementById("closeBtn");
        let lastFocused: HTMLElement | null = null;

        stage.addEventListener("click", (e) => {
          const btn = (e.target as HTMLElement).closest(
            ".bubble",
          ) as HTMLButtonElement | null;
          if (!btn) return;
          const d = content[btn.dataset.modal!];
          document.getElementById("modal-tag")!.textContent = d.tag;
          document.getElementById("modal-title")!.textContent = d.title;
          document.getElementById("modal-body")!.textContent = d.body;
          lastFocused = document.activeElement as HTMLElement;
          overlay!.classList.add("open");
          closeBtn!.focus();
        });

        function closeModal() {
          overlay!.classList.remove("open");
          lastFocused?.focus();
        }
        closeBtn!.addEventListener("click", closeModal);
        overlay!.addEventListener("click", (e) => {
          if (e.target === overlay) closeModal();
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") closeModal();
        });
      }

      // astro:page-load は初回表示・View Transitionsでの遷移後、どちらでも発火する
      document.addEventListener("astro:page-load", initWordsPage);
    </script>

    <Footer />

    <style>
      * {
        margin: 0;
        padding: 0;
      }

      body {
        background-color: #fff;
        position: relative;
      }

      :root {
        --morph-duration: 0.6s;

        --header-back-color: rgb(181, 230, 198);

        --mint: #b5e6c6;
        --ink: #000000;
        --paper: #ffffff;
        --dot: rgba(120, 80, 200, 0.35);
        --canvas-w: 1900px;
      }

      ::view-transition-old(title--message),
      ::view-transition-new(title--message) {
        animation-duration: var(--morph-duration);
      }

      .bg_reveal {
        position: fixed;
        inset: 0;
        background: rgb(181, 230, 198);
        background-image: radial-gradient(
          circle,
          rgba(120, 80, 200, 0.35) 1px,
          transparent 1px
        );
        background-size: 5px 5px;
        z-index: -1;
        transform: scaleY(0);
        animation: revealBg 0.4s ease forwards;
        /* transform-origin はJSで動的に設定するため、ここでは指定しない */
      }

      @keyframes revealBg {
        from {
          transform: scaleY(0);
        }
        to {
          transform: scaleY(1);
        }
      }

      .contents-list {
        display: block;
        box-shadow:
          0 -1px 0 0 #000,
          0 1px 0 0 #000;
      }

      .contents_texto {
        box-shadow:
          0 -1px 0 0 #000,
          0 1px 0 0 #000;
        padding: 14px 16px 14px;
        white-space: nowrap;
        position: relative;
        display: flex;
        align-items: center;
        gap: 24px;
        background: #b5e6c6;
        z-index: 1;
      }

      .content_label {
        position: absolute;
        top: 14px;
        right: 16px;
        font-size: 15px;
        color: #000;
        font-family: "Zen Kaku Gothic New", sans-serif;
        font-weight: 800;
        padding: 6px 14px;
      }

      .contents_texto h2 {
        font-size: 110px;
        font-family: "acumin-variable", sans-serif;
        font-variation-settings:
          "wght" 400,
          "wdth" 100,
          "slnt" 0;
        font-style: normal;
        align-items: center;
        line-height: 1;
        letter-spacing: -0.06em;
        position: relative;
      }

      .back_btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        border: 2px solid #000;
        border-radius: 50%;
        text-decoration: none;
        color: #000;
        flex-shrink: 0;
        transition:
          background 0.2s,
          color 0.2s;
      }

      .back_btn:hover {
        background: #000;
        color: #b5e6c6;
      }

      .back_arrow {
        font-size: 20px;
        line-height: 1;
      }

      .words-canvas {
        width: 1900px;
        margin: 0 auto;
        position: relative;
        background: #b5e6c6;
      }

      .stage {
        position: relative;
        width: 100%;
        height: 900px;
        background-size: 26px 26px;
        background-position: center;
        overflow: hidden;
        border-left: 1px solid #000;
        border-right: 1px solid #000;
      }

      .intro {
        position: absolute;
        top: 56px;
        left: 64px;
        max-width: 380px;
      }
      .intro .eyebrow {
        font-family: "Zen Kaku Gothic New", sans-serif;
        font-weight: 800;
        font-size: 13px;
        letter-spacing: 0.06em;
        display: inline-block;
        background: #b5e6c6;
        border: 2px solid #000;
        padding: 4px 12px;
        margin-bottom: 14px;
      }
      .intro p {
        font-family: "Noto Sans JP", sans-serif;
        font-size: 14px;
        line-height: 2;
        color: #333;
      }

      .character {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 220px;
        z-index: 3;
        animation: breathe 6s ease-in-out infinite;
        transform-origin: center;
      }
      @keyframes breathe {
        0%,
        100% {
          transform: translate(-50%, -50%) scale(1);
        }
        50% {
          transform: translate(-50%, -50%) scale(1.02);
        }
      }

      /* ===== 吹き出し(JSで位置を決定・その場でポップする軌道) ===== */
      .bubble-wrap {
        position: absolute;
        z-index: 2;
        opacity: 0;
        animation: popOut 0.55s cubic-bezier(0.25, 0.9, 0.35, 1.15) forwards;
        animation-delay: var(--delay, 0s);
      }
      @keyframes popOut {
        0% {
          transform: translate(-50%, -50%) scale(0.2)
            rotate(var(--start-rot, -12deg));
          opacity: 0;
        }
        60% {
          transform: translate(-50%, -50%) scale(1.08)
            rotate(var(--final-rot, 0deg));
          opacity: 1;
        }
        100% {
          transform: translate(-50%, -50%) scale(1)
            rotate(var(--final-rot, 0deg));
          opacity: 1;
        }
      }

      .bubble {
        position: relative;
        display: block;
        width: 200px;
        background: var(--paper);
        color: var(--ink);
        font-family: "Zen Kaku Gothic New", sans-serif;
        font-weight: 700;
        font-size: 14px;
        line-height: 1.6;
        padding: 16px 18px;
        border: 2px solid #000;
        border-radius: 14px;
        cursor: pointer;
        text-align: left;
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease,
          background 0.2s ease;
      }
      .bubble:hover,
      .bubble:focus-visible {
        transform: translateY(-3px);
        box-shadow: 4px 5px 0 0 #000;
        background: var(--mint);
        outline: none;
      }

      /* しっぽ:上下のみ判定、辺の中の位置は --tail-x で調整 */
      .bubble::before,
      .bubble::after {
        content: "";
        position: absolute;
        width: 0;
        height: 0;
        border-style: solid;
      }
      .dir-b .bubble::before {
        bottom: -14px;
        left: var(--tail-x, 50%);
        margin-left: -13px;
        border-width: 14px 13px 0 13px;
        border-color: #000 transparent transparent transparent;
      }
      .dir-b .bubble::after {
        bottom: -10.5px;
        left: var(--tail-x, 50%);
        margin-left: -10px;
        border-width: 11px 10px 0 10px;
        border-color: var(--paper) transparent transparent transparent;
      }
      .dir-b .bubble:hover::after {
        border-top-color: var(--mint);
      }

      .dir-t .bubble::before {
        top: -14px;
        left: var(--tail-x, 50%);
        margin-left: -13px;
        border-width: 0 13px 14px 13px;
        border-color: transparent transparent #000 transparent;
      }
      .dir-t .bubble::after {
        top: -10.5px;
        left: var(--tail-x, 50%);
        margin-left: -10px;
        border-width: 0 10px 11px 10px;
        border-color: transparent transparent var(--paper) transparent;
      }
      .dir-t .bubble:hover::after {
        border-bottom-color: var(--mint);
      }

      /* ===== モーダル ===== */
      .overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease;
        z-index: 10;
      }
      .overlay.open {
        opacity: 1;
        pointer-events: auto;
      }
      .modal {
        background: var(--paper);
        color: var(--ink);
        width: min(480px, 100%);
        border: 3px solid #000;
        padding: 36px 32px 32px;
        position: relative;
        transform: translateY(10px);
        opacity: 0;
        transition:
          transform 0.25s ease,
          opacity 0.25s ease;
      }
      .overlay.open .modal {
        transform: translateY(0);
        opacity: 1;
      }
      .modal .tag {
        display: inline-block;
        font-family: "Zen Kaku Gothic New", sans-serif;
        font-weight: 800;
        font-size: 12px;
        background: var(--mint);
        border: 2px solid #000;
        padding: 4px 12px;
        margin-bottom: 16px;
      }
      .modal h2 {
        font-family: "Bebas Neue", sans-serif;
        font-size: 42px;
        letter-spacing: 0.01em;
        margin: 0 0 16px;
        line-height: 1;
      }
      .modal p {
        font-family: "Noto Sans JP", sans-serif;
        font-size: 14.5px;
        line-height: 2;
        color: #222;
      }
      .modal .close {
        position: absolute;
        top: 18px;
        right: 18px;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 2px solid #000;
        background: var(--paper);
        color: #000;
        font-size: 15px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition:
          background 0.2s,
          color 0.2s;
      }
      .modal .close:hover {
        background: #000;
        color: var(--mint);
      }

      @media (prefers-reduced-motion: reduce) {
        .character,
        .bubble-wrap {
          animation: none !important;
          opacity: 1 !important;
        }
      }

      /* ==================== スマホ対応 ==================== */
      @media (max-width: 768px) {
        .contents_texto {
          padding: 10px 12px;
          gap: 12px;
          white-space: normal;
          overflow: hidden;
        }

        .contents_texto h2 {
          flex: 1 1 0%;
          min-width: 0;
          font-size: 15vw;
          overflow-x: hidden;
          overflow-y: hidden;
          white-space: nowrap;
          -webkit-overflow-scrolling: touch;
          scrollbar-width: none;
          font-size: 15vw;
        }

        .content_label {
          top: 10px;
          right: 66px;
          max-width: 100px;
          box-sizing: border-box;
          overflow-x: hidden;
          white-space: nowrap;
          font-size: 11px;
          padding: 4px 8px;
        }

        .back_btn {
          width: 40px;
          height: 40px;
        }

        .back_arrow {
          font-size: 16px;
        }

        .chronology {
          max-width: 50vh;
          margin: 0 10px;
        }

        .chronology_title {
          padding: 16px 1em;
        }
        .chronology_subtitle {
          font-size: 20px;
          letter-spacing: 0.2em;
          margin: 0 0 2px 0;
        }
        .chronology_title h4 {
          font-size: 13vw;
        }
        .chronology_date {
          font-size: 15px;
        }

        :global(.timeline-wrap) {
          padding: 32px 16px;
          margin-bottom: 60px;
        }

        :global(.timeline-line) {
          left: 8px;
        }

        :global(.marker-col) {
          width: 16px;
          flex: 0 0 16px;
        }

        :global(.marker-circle) {
          width: 14px;
          height: 14px;
          border-width: 2px;
        }

        :global(.content-col) {
          padding-left: 16px;
          gap: 20px;
        }

        :global(.item-year) {
          font-size: 12px;
        }

        :global(.item-title) {
          font-size: 17px;
          padding-bottom: 8px;
        }

        :global(.item-desc) {
          font-size: 13px;
          line-height: 1.8;
        }

        :global(.item-comment) {
          font-size: 12px;
          padding: 8px 12px;
        }

        :global(.like-btn) {
          font-size: 12px;
          padding: 5px 12px;
        }

        :global(.item-youtube) {
          border-radius: 6px;
        }

        :global(.yt-play-btn) {
          width: 52px;
          height: 36px;
        }
      }
    </style>
  </body>
</BaseLayout>
