        bubble: "ダルめの騎士「今夜は貴方様をお守りしナイト…っとｗ」",
        tag: "DAJARE",
        title: "ダルめの騎士「今夜は貴方様をお守りしナイト…っとｗ」",
        body: "",
        sourceUrl: "https://x.com/i/status/1856213372162756691",
      },
      {
        id: "w5",
        bubble: "わりと暇な悪魔「いつデーモンいけます」",
        tag: "DAJARE",
        title: "わりと暇な悪魔「いつデーモンいけます」",
        body: "",
        sourceUrl: "https://x.com/i/status/1855132655941304833",
      },
      {
        id: "w6",
        bubble: "あんまり納得できてない大富豪、イロン・マスク",
        tag: "DAJARE",
        title: "あんまり納得できてない大富豪、イロン・マスク",
        body: "",
        sourceUrl: "https://x.com/i/status/1942805149988114825",
      },
      {
        id: "w7",
        bubble: "徒歩移動で、トホホ〜😅",
        tag: "DAJARE",
        title: "徒歩移動で、トホホ〜😅",
        body: "",
        sourceUrl:
          "https://x.com/Rine_Yaguruma/status/1859021640702849380?s=20",
      },
      {
        id: "w8",
        bubble: "カレーが、辛(かれ)ェ〜笑",
        tag: "DAJARE",
        title: "カレーが、辛(かれ)ェ〜笑",
        body: "",
        sourceUrl:
          "https://x.com/Rine_Yaguruma/status/1938430093124374571?s=20",
      },
      {
        id: "w9",
        bubble: "花粉にギャフン",
        tag: "DAJARE",
        title: "花粉にギャフン",
        body: "",
        sourceUrl:
          "https://x.com/Rine_Yaguruma/status/1883877445021135179?s=20",
      },
      {
        id: "w9",
        bubble: "抹消しまっしょう",
        tag: "DAJARE",
        title: "抹消しまっしょう",
        body: "",
        sourceUrl:
          "https://x.com/Rine_Yaguruma/status/2042213422134378979?s=20",
      },
      {
        id: "w11",
        bubble: "IKEAに、行けや。",
        tag: "DAJARE",
        title: "IKEAに、行けや。",
        body: "",
        sourceUrl:
          "https://x.com/Rine_Yaguruma/status/1774393131615826133?s=20",
      },
    ];

    const stage = document.getElementById("stage");
    const character = document.getElementById("character");

    const BUBBLE_W = 200; // .bubble の固定幅と合わせる
    const MIN_GAP = 22; // 吹き出し同士の最低間隔
    const EDGE_MARGIN = 40; // ボード端からの最低距離(しっぽ・影のはみ出し分含む)
    const MAX_ATTEMPTS = 400;

    // このページに来たとき(初回表示・View Transitionsでの遷移の両方)に実行する
    function initWordsPage() {
      const stage = document.getElementById("stage");
      if (!stage) return; // words ページ以外では何もしない
      const character = document.getElementById("character");
      if (!character) return;

      // 何回呼ばれても実際の配置処理は1回だけにするガード
      // (直接呼び出し・astro:page-load・その他の再実行経路が
      //  重なっても、これで確実に1回だけになる)
      if (stage.dataset.wordsInit === "true") return;
      stage.dataset.wordsInit = "true";

      function layoutBubbles() {
        const stageRect = { w: stage.clientWidth, h: stage.clientHeight };
        const centerX = stageRect.w / 2;
        const centerY = stageRect.h / 2;

        const charEl = character.getBoundingClientRect();
        // 除外円の半径:キャラクターの実サイズを基準にする
        // (固定値だとキャラが小さいスマホ表示で除外エリアが相対的に
        //  広くなりすぎ、吹き出しの置き場所が窮屈になるため)
        const exclusionRadius = Math.max(charEl.width, charEl.height) / 2 + 70;

        const placed: { x: number; y: number; w: number; h: number }[] = [];

        messages.forEach((msg, i) => {
          const wrap = document.createElement("div");
          wrap.className = "bubble-wrap";
          wrap.style.visibility = "hidden";
          wrap.style.left = "0px";
          wrap.style.top = "0px";

          const btn = document.createElement("button");
          btn.className = "bubble";
          btn.dataset.modal = msg.id;
          btn.innerHTML = msg.bubble;

          wrap.appendChild(btn);
          stage.appendChild(wrap);

          const rect = btn.getBoundingClientRect();
          // しっぽ(14px)・影・ホバー時の浮き上がり(3px)分の余裕を持たせる
          const w = rect.width + 32;
          const h = rect.height + 32;

          let x = 0,
            y = 0,
            ok = false;
          for (let a = 0; a < MAX_ATTEMPTS; a++) {
            x =
              EDGE_MARGIN +
              w / 2 +
              Math.random() * (stageRect.w - w - EDGE_MARGIN * 2);
            y =
              EDGE_MARGIN +
              h / 2 +
              Math.random() * (stageRect.h - h - EDGE_MARGIN * 2);

            const distFromCenter = Math.hypot(x - centerX, y - centerY);
            if (distFromCenter < exclusionRadius) continue;

            const overlaps = placed.some((p) => {
              return (
                Math.abs(x - p.x) < (w + p.w) / 2 + MIN_GAP &&
                Math.abs(y - p.y) < (h + p.h) / 2 + MIN_GAP
              );
            });
            if (overlaps) continue;

            ok = true;
            break;
          }
          if (!ok) {
            // 通常の試行で見つからなかった場合、除外円の外側を
            // 少しずつ広げながら、他の吹き出しと重ならない場所を探す
            let foundFallback = false;
            for (let ring = 0; ring < 14 && !foundFallback; ring++) {
              const testRadius =
                exclusionRadius + Math.max(w, h) / 2 + ring * 20;
              for (let t = 0; t < 24; t++) {
                const angle = Math.random() * Math.PI * 2;
                let tx = centerX + Math.cos(angle) * testRadius;
                let ty = centerY + Math.sin(angle) * testRadius;
                tx = Math.min(
                  Math.max(tx, EDGE_MARGIN + w / 2),
                  stageRect.w - EDGE_MARGIN - w / 2,
                );
                ty = Math.min(
                  Math.max(ty, EDGE_MARGIN + h / 2),
                  stageRect.h - EDGE_MARGIN - h / 2,
                );

                const overlapsFallback = placed.some((p) => {
                  return (
                    Math.abs(tx - p.x) < (w + p.w) / 2 + MIN_GAP &&
                    Math.abs(ty - p.y) < (h + p.h) / 2 + MIN_GAP
                  );
                });
                if (overlapsFallback) continue;

                x = tx;
                y = ty;
                foundFallback = true;
                break;
              }
            }
            // それでも見つからない場合のみ、重なりを許容して機械的に配置する
            // (ここまで来るのは極端に吹き出しが多い/ボードが狭い場合の保険)
            if (!foundFallback) {
              const angle = Math.random() * Math.PI * 2;
              x = centerX + Math.cos(angle) * (exclusionRadius + w / 2 + 20);
              y = centerY + Math.sin(angle) * (exclusionRadius + h / 2 + 20);
              x = Math.min(
                Math.max(x, EDGE_MARGIN + w / 2),
                stageRect.w - EDGE_MARGIN - w / 2,
              );
              y = Math.min(
                Math.max(y, EDGE_MARGIN + h / 2),
                stageRect.h - EDGE_MARGIN - h / 2,
              );
            }
          }

          placed.push({ x, y, w, h });

          const dir = y < centerY ? "dir-b" : "dir-t";

          // 吹き出しが中心より左にあるなら右寄り、右にあるなら左寄りにする
          const norm = Math.max(
            -1,
            Math.min(1, (centerX - x) / (stageRect.w / 2)),
          );
          const tailX = 50 + norm * 30;
          const clampedTailX = Math.min(80, Math.max(20, tailX));

          wrap.classList.add(dir);
          wrap.style.left = x + "px";
          wrap.style.top = y + "px";
          wrap.style.visibility = "visible";
          wrap.style.setProperty("--tail-x", clampedTailX + "%");
          wrap.style.setProperty("--delay", i * 0.07 + "s");
        });
      }

      // Webフォントの読み込みが完了してからサイズを測って配置する
      // (先に測ってしまうと、後からフォントが差し替わった時に
      //  箱のサイズが変わり、位置がズレて見える)
      if (document.fonts && document.fonts.status !== "loaded") {
        document.fonts.ready.then(layoutBubbles);
      } else {
        layoutBubbles();
      }

      // ===== モーダル =====
      const content = Object.fromEntries(messages.map((m) => [m.id, m]));
      const overlay = document.getElementById("overlay");
      const closeBtn = document.getElementById("closeBtn");
      const sourceLink = document.getElementById(
        "modal-source",
      ) as HTMLAnchorElement | null;
      const shareBtn = document.getElementById("modal-share");
      let lastFocused: HTMLElement | null = null;
      let currentMessage: (typeof messages)[number] | null = null;

      stage.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest(
          ".bubble",
        ) as HTMLButtonElement | null;
        if (!btn) return;
        const d = content[btn.dataset.modal!];
        currentMessage = d;
        document.getElementById("modal-tag")!.textContent = d.tag;
        document.getElementById("modal-title")!.textContent = d.title;
        document.getElementById("modal-body")!.textContent = d.body;

        // 引用元リンク:sourceUrl が無ければボタンごと隠す
        if (sourceLink) {
          if (d.sourceUrl) {
            sourceLink.href = d.sourceUrl;
            sourceLink.dataset.empty = "false";
          } else {
            sourceLink.removeAttribute("href");
            sourceLink.dataset.empty = "true";
          }
        }

        lastFocused = document.activeElement as HTMLElement;
        overlay!.classList.add("open");
        closeBtn!.focus();
      });

      // Xでシェア:本文の言葉+このページのURLを添えて投稿画面を開く
      shareBtn?.addEventListener("click", () => {
        if (!currentMessage) return;
        const text = currentMessage.title;
        const shareUrl = new URL(location.href);
        const intentUrl =
          "https://twitter.com/intent/tweet?text=" +
          encodeURIComponent(text) +
          "&url=" +
          encodeURIComponent(shareUrl.toString());
        window.open(intentUrl, "_blank", "noopener,noreferrer");
      });

      function closeModal() {
        overlay!.classList.remove("open");
        lastFocused?.focus();
      }
      closeBtn!.addEventListener("click", closeModal);
      overlay!.addEventListener("click", (e) => {
        if (e.target === overlay) closeModal();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeModal();
      });
    }

    // 通常の読み込みに対応
    initWordsPage();
    // View Transitionsでの遷移(このサイトで実際に発火するかは環境依存)にも対応。
    // 上のガードにより、両方発火しても実行は1回だけになる
    document.addEventListener("astro:page-load", initWordsPage);
  </script>
</BaseLayout>
