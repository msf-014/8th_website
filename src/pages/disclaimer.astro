---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/header.astro";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/footer.astro";
import PageBackground from "../components/PageBackground.astro";
import PageHeader from "../components/PageHeader.astro";
import PageFrame from "../components/PageFrame.astro";
---

<BaseLayout>
  <body>
    <PageBackground />
    <div class="contents-list" transition:name="title--credit">
      <PageHeader title="DISCLAIMER" label="免責事項" />
      <PageFrame class="page">
        <div class="page_content">
          <div class="content_sub">
            <div class="heading">本サイトについて</div>
            <div class="page_body">
              <p>
                本サイト「Rinaria」は、にじさんじ所属
                矢車りねさんの8周年を記念する非公式のファンサイトです。
                矢車りね氏本人、および所属する団体・企業とは一切関係がなく、公式の情報提供を行うものではありません。
              </p>
              <p>
                掲載されている情報はすべてファンによる調査・編集に基づくものです。
                内容の正確性・完全性については保証できませんので、あらかじめご了承ください。
              </p>
            </div>
          </div>
          <div class="content_sub">
            <div class="heading">コンテンツの著作権について</div>
            <div class="page_body">
              <p>
                本サイト「Rinaria」は、にじさんじ所属
                矢車りねさんの8周年を記念する非公式のファンサイトです。
                矢車りね氏本人、および所属する団体・企業とは一切関係がなく、公式の情報提供を行うものではありません。
              </p>
              <p>
                掲載されている情報はすべてファンによる調査・編集に基づくものです。
                内容の正確性・完全性については保証できませんので、あらかじめご了承ください。
              </p>
            </div>
          </div>
        </div>
      </PageFrame>
    </div>
  </body>

  <style>
    * {
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #fff;
      position: relative;
    }

    :root {
      --morph-duration: 0.6s;

      --page-color: #e6e6e6;

      --header-back-color: var(--page-color);
    }

    ::view-transition-old(title--message),
    ::view-transition-new(title--message) {
      animation-duration: var(--morph-duration);
    }

    .contents-list {
      display: block;
    }

    .page {
      font-family: "Zen Kaku Gothic New", sans-serif;
    }

    .page_content {
      padding: 4rem 2.5rem;
    }

    .content_sub {
      border-bottom: 1px solid #000;
      padding: 2rem 0;
    }

    .heading {
      font-weight: 800;
      margin-bottom: 1rem;
    }

    .page_body {
      font-family: "Zen Kaku Gothic New", sans-serif;
      line-height: 2;
      margin-bottom: 1rem;
    }

    .page_body p + p {
      margin-top: 0.75rem;
    }

    /* ==================== スマホ対応 ==================== */
    @media (max-width: 768px) {

      /* ---- ここから無限ループ・マーキー用のスタイル ---- */
      :global(.marquee-track) {
        display: inline-flex;
        white-space: nowrap;
      }

      :global(.marquee-track.is-scrolling) {
        animation-name: marquee-loop;
        animation-timing-function: linear;
        animation-iteration-count: infinite;
      }

      @keyframes marquee-loop {
        from {
          transform: translateX(0);
        }
        to {
          transform: translateX(var(--marquee-distance, 0px));
        }
      }

      :global(.marquee-item) {
        display: inline-block;
        white-space: nowrap;
      }
      /* ---- ここまで ---- */

      .chronology {
        max-width: 50vh;
        margin: 0 10px;
      }

      .chronology_title {
        padding: 16px 1em;
      }
      .chronology_subtitle {
        font-size: 20px;
        letter-spacing: 0.2em;
        margin: 0 0 2px 0;
      }
      .chronology_title h4 {
        font-size: 13vw;
      }
      .chronology_date {
        font-size: 15px;
      }

      :global(.timeline-wrap) {
        padding: 32px 16px;
        margin-bottom: 60px;
      }

      :global(.timeline-line) {
        left: 8px;
      }

      :global(.marker-col) {
        width: 16px;
        flex: 0 0 16px;
      }

      :global(.marker-circle) {
        width: 14px;
        height: 14px;
        border-width: 2px;
      }

      :global(.content-col) {
        padding-left: 16px;
        gap: 20px;
      }

      :global(.item-year) {
        font-size: 12px;
      }

      :global(.item-title) {
        font-size: 17px;
        padding-bottom: 8px;
      }

      :global(.item-desc) {
        font-size: 13px;
        line-height: 1.8;
      }

      :global(.item-comment) {
        font-size: 12px;
        padding: 8px 12px;
      }

      :global(.like-btn) {
        font-size: 12px;
        padding: 5px 12px;
      }

      :global(.item-youtube) {
        border-radius: 6px;
      }

      :global(.yt-play-btn) {
        width: 52px;
        height: 36px;
      }
    }
  </style>
</BaseLayout>
