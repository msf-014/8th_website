---
interface Props {
  overlay?: boolean;
}
const { overlay = false, headerColor = "#fff" } = Astro.props;
---

<header
  class:list={["site-header", { overlay }]}
  style={`--header-text-color: ${headerColor}`}
>
  <div class="header">
    <h2><a href="/">Rinalia</a></h2>
  </div>

  <style>
    .site-header {
      width: 100%;
      z-index: 10;
    }
    .site-header:not(.overlay) {
      position: relative;
      background: var(--header-back-color);
      z-index: 0;
      /* 下層ページは本文の枠と同じ最大幅で中央に揃える */
      box-sizing: border-box;
      max-width: var(--frame-max, 1480px);
      margin: 0 auto;
      border-left: 1px solid #000;
      border-right: 1px solid #000;
    }
    .site-header.overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      /* トップページも本文と同じ最大幅で中央に揃える */
      max-width: var(--frame-max, 1480px);
      margin: 0 auto;
    }
    .header {
      padding: 0 30px 0 30px;
      display: flex;
      margin: auto;
      height: 100%;
      justify-content: center;
    }
    .header h2 {
      margin: 0;
      padding: 30px 0;
      font-family: "helvetica-lt-pro", sans-serif;
      font-size: 30px;
      font-weight: 200;
      font-style: normal;
      display: flex;
      align-items: center;
    }
    .header h2 a {
      text-decoration: none;
      color: inherit;
      text-align: center;
    }

    /* overlay時は白文字などに調整(画像に合わせて色は変更してください) */
    .site-header.overlay .header h2 {
      color: var(--header-text-color, #fff);
    }

    /* ==================== スマホ対応 ==================== */
    @media (max-width: 768px) {
      .site-header:not(.overlay) {
        border-left: 0;
        border-right: 0;
      }
      .header h2 {
        padding: 15px 0;
        font-size: 15px;
      }
    }
  </style>
</header>
